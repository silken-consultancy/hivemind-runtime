#!/usr/bin/env bash
# hivemind — HiveMind thin CLI.
#
# Analogous to silken-runtime but standalone — zero lab deps.
# Runs in the user's project directory; slug = explicit arg or interactive
# picker (fail-closed if non-interactive — no basename(cwd) fallback).
#
# Cross-platform note: this file is the ONLY Unix-specific layer — the
# daemon it spawns (runtime/src/server.ts) is plain portable TS/Bun. See
# docs/ARCHITECTURE.md for the 4 Unix-specific primitives named here
# (detach, pidfile+signals, $HOME paths, bash-as-CLI) and how a future
# native-Windows port would replace this file without touching the daemon.
#
# Usage:
#   hivemind [<slug>]     # start proxy + exec claude; slug = a REAL project (never `default`) or picker
#                          # (proxy-only install: start the proxy + print connect hints, never claude)
#   hivemind start        # start proxy only (no claude)
#   hivemind stop         # stop the proxy
#   hivemind restart      # stop + start (best-effort; re-reads ~/.hivemind/.env)
#   hivemind status       # proxy health + cert validity (human-readable)
#   hivemind health       # same checks as status, script-friendly exit code (0/1/2)
#   hivemind update       # pull-agent: staged+verified+atomic update, auto-rollback
#   hivemind resume <slug>  # explicit crash recovery: close a dead-holder session, then open
#   hivemind install [<target>]  # guided setup of another local MCP client (Cursor,
#                          # Antigravity, ...) — interactive only, NO default path ever
#   hivemind uninstall [all|harness] [--yes] [--keep-certs]  # remove everything HiveMind
#                          # installed, or only the Claude Code harness (lists it first; asks
#                          # unless --yes; TTY required without --yes)
#   hivemind autostart on|off|status  # start the proxy at log-on (opt-in, default off):
#                          # systemd --user unit; under WSL also a Windows Startup trigger
#   hivemind --version    # print version and exit
#   hivemind --verbose [...]  # show startup/debug logs (default: quiet, GO/NO-GO only)

set -euo pipefail

HIVEMIND_VERSION="0.1.0"
HIVEMIND_HOME="${HIVEMIND_HOME:-$HOME/.hivemind}"
RUNTIME_PORT="${AR_PORT:-7777}"
PROXY_PORT="${MTLS_PROXY_PORT:-7779}"
# Product state lives under ~/.engram — a dedicated, hidden dir with zero
# shared footprint: other tooling on the same machine must never collide
# with this product on cert material or cache/pid files.
RUNTIME_LOG="${HOME}/.engram/cache/hivemind-runtime.log"
RUNTIME_PID_FILE="${HOME}/.engram/cache/hivemind-runtime.pid"
# Leftover-session pidfile from an interrupted --setup-only run (see _setup_mode
# / cmd_stop hardening, item 4.2) — best-effort cleanup, not fatal if absent.
SETUP_PID_FILE="${HOME}/.engram/cache/hivemind-setup.pid"
CERT_DIR="${HOME}/.engram/mtls"
RUNTIME_BIN="${HIVEMIND_HOME}/runtime/src/server.ts"
# `hivemind install`'s Antigravity candidate — the WSL↔Windows bridge root
# (measured, 62e96c8e item 4.4: Windows-side config lives at
# <root>/<user>/.gemini/config/mcp_config.json). Overridable so tests can
# point detection at a fixture tree instead of a real /mnt/c mount.
ANTIGRAVITY_WINDOWS_USERS_ROOT="${ANTIGRAVITY_WINDOWS_USERS_ROOT:-/mnt/c/Users}"
# Local HTTPS loopback listener cert (round-2, item 1.1(B)/1.4, founder
# 2026-07-30) — generated lazily by mtls-proxy.ts under this subdir, DISTINCT
# from CERT_DIR's enrollment client cert. Trusted into the WSL/Linux system
# store here so a strict-TLS IDE client validates it without a skip-verify
# flag (see _trust_local_ca).
LOCAL_HTTPS_CA="${HOME}/.engram/mtls/local-https/ca.cert.pem"
SYSTEM_CA_DEST="/usr/local/share/ca-certificates/hivemind-local-https-ca.crt"
# `hivemind uninstall` test seam, snapshotted from the PROCESS env here —
# BEFORE $HIVEMIND_HOME/.env is sourced below — so a .env line can never
# choose the file uninstall's `sudo rm -f` targets. Read only by
# _uninstall_ca_dest; install-time trust always uses SYSTEM_CA_DEST.
_UNINSTALL_CA_DEST_OVERRIDE="${HIVEMIND_SYSTEM_CA_DEST:-}"
# Direct-HTTPS fallback URL override for the proxy-only connect hints
# (_print_connect_hints), snapshotted from the PROCESS env before the .env
# load, same as above — a .env line never chooses what URL is printed.
_DIRECT_MCP_URL_OVERRIDE="${HIVEMIND_DIRECT_MCP_URL:-}"
# Managed update source (impl 3e2c90da, item D1). The canonical remote every
# install updates from once its source is moved to ${HIVEMIND_HOME}.src
# (_maybe_migrate_source). HIVEMIND_CANONICAL_REMOTE is a test seam read from
# the PROCESS env only, snapshotted here before the .env load like the
# overrides above — a .env line never chooses where the CLI clones from, nor
# which clone `uninstall all` may remove. F11: honoured only together with the
# explicit test-mode flag HIVEMIND_TEST_SEAMS=1 (also process env only), so a
# stray exported variable alone can never redirect a real install's updates.
_CANONICAL_REMOTE="https://github.com/silken-consultancy/hivemind-runtime.git"
if [ "${HIVEMIND_TEST_SEAMS:-}" = "1" ] && [ -n "${HIVEMIND_CANONICAL_REMOTE:-}" ]; then
  _CANONICAL_REMOTE="${HIVEMIND_CANONICAL_REMOTE}"
fi
# Blocker 3b7a507e. `hivemind uninstall --keep-certs` parks the enrollment
# credentials of $HIVEMIND_HOME/.env here (mode 0600); install.sh merges them
# back into the new .env and deletes the file.
KEPT_CREDENTIALS_FILE="${HOME}/.engram/kept-credentials.env"
# How long a start waits for the mTLS proxy listener once healthz answers, when
# a certificate is present (_require_proxy_listening). Process env only (test
# seam), snapshotted before the .env load like the overrides above.
_PROXY_WAIT_SECS="${HIVEMIND_PROXY_WAIT_SECS:-10}"
case "${_PROXY_WAIT_SECS}" in '' | *[!0-9]*) _PROXY_WAIT_SECS=10 ;; esac
# `hivemind autostart` (impl 3e2c90da, phase A). Snapshotted from the PROCESS
# env before the .env load, like the overrides above — a .env line never
# chooses where a unit / Startup file is written. XDG_CONFIG_HOME: the systemd
# --user unit dir and the XDG autostart dir. HIVEMIND_WINDOWS_STARTUP_DIR (test
# seam): the Windows Startup folder under WSL, instead of resolving %APPDATA%
# through cmd.exe. HIVEMIND_AUTOSTART_WSL (test seam): 1/0 forces WSL detection.
_AUTOSTART_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
_AUTOSTART_STARTUP_OVERRIDE="${HIVEMIND_WINDOWS_STARTUP_DIR:-}"
_AUTOSTART_WSL_OVERRIDE="${HIVEMIND_AUTOSTART_WSL:-}"
# WSL interop probe dir (A6) and the daemon detach mechanism (I8). Test seams,
# process env only, honoured only with HIVEMIND_TEST_SEAMS=1 (like F11 above):
# HIVEMIND_WSL_BINFMT_DIR replaces /proc/sys/fs/binfmt_misc;
# HIVEMIND_DETACH_VIA=setsid|pgid forces one of _detach_begin's two paths
# (setsid falls back to pgid when there is no setsid binary to run).
_WSL_BINFMT_DIR="/proc/sys/fs/binfmt_misc"
_DETACH_VIA_OVERRIDE=""
if [ "${HIVEMIND_TEST_SEAMS:-}" = "1" ]; then
  _WSL_BINFMT_DIR="${HIVEMIND_WSL_BINFMT_DIR:-${_WSL_BINFMT_DIR}}"
  case "${HIVEMIND_DETACH_VIA:-}" in setsid|pgid) _DETACH_VIA_OVERRIDE="${HIVEMIND_DETACH_VIA}" ;; esac
fi

# One-time endpoint migration (2026-07-21): hivemind.silken.ia.br → hivemind.ia.br.
# The product endpoints moved to hivemind.ia.br (the silken.ia.br product blocks are
# being retired). Rewrite a pre-migration ~/.hivemind/.env IN PLACE so an already-
# enrolled client repoints automatically (reached via the update channel while the old
# manifest is still served). Only the HOST changes — the enrolled cert is issued by the
# same product CA and the :4443 server cert now carries a hivemind.ia.br SAN, so no
# re-enrollment is needed. Idempotent: a no-op once migrated.
if [ -f "${HIVEMIND_HOME}/.env" ] && grep -q 'hivemind\.silken\.ia\.br:4443' "${HIVEMIND_HOME}/.env" 2>/dev/null; then
  _mig_bak="${HIVEMIND_HOME}/.env.pre-hivemind-ia.$(date +%Y%m%d%H%M%S)"
  if cp "${HIVEMIND_HOME}/.env" "${_mig_bak}" 2>/dev/null \
     && sed 's/hivemind\.silken\.ia\.br:4443/hivemind.ia.br:4443/g' "${_mig_bak}" > "${HIVEMIND_HOME}/.env" 2>/dev/null; then
    echo "[hivemind] endpoint migrated: hivemind.silken.ia.br:4443 → hivemind.ia.br:4443 (backup: ${_mig_bak})" >&2
  else
    cp "${_mig_bak}" "${HIVEMIND_HOME}/.env" 2>/dev/null || true
  fi
  unset _mig_bak
fi

# Load user env if present (sets MTLS_* + HIVEMIND_OWNER).
if [ -f "${HIVEMIND_HOME}/.env" ]; then
  # shellcheck disable=SC1090
  set -a; . "${HIVEMIND_HOME}/.env"; set +a
fi

# Refresh port vars after env load (env may override AR_PORT / MTLS_PROXY_PORT).
RUNTIME_PORT="${AR_PORT:-${RUNTIME_PORT}}"
PROXY_PORT="${MTLS_PROXY_PORT:-${PROXY_PORT}}"

# ── Option 2 per-target proxy (fos_decision 1caee6a7, item 18cff9b7) ────────
# `hivemind install <target>` allocates a DEDICATED loopback port + mints a
# device_id per installed target, instead of every foreign client sharing
# PROXY_PORT — full design: fos_sketchpad 4f8142e3 § ADDENDUM 3. Persisted to
# PORT_MAP_FILE (sibling to CERT_DIR, same owner-scoped ~/.engram/mtls root);
# read by runtime/src/lib/mtls-proxy.ts's startAllMtlsProxies() at daemon boot
# and on every POST /internal/proxy/reload.
PORT_MAP_FILE="${CERT_DIR}/port-map.json"
# Range default 7780-7879 (100 max installed targets) — a technical default
# with an obvious safe choice, not escalated as a founder fork (ADDENDUM 3
# OPEN 17). Tunable via env, mirroring the existing MTLS_PROXY_PORT override
# pattern. Computed AFTER the PROXY_PORT refresh above so a .env-overridden
# MTLS_PROXY_PORT shifts the range with it.
MTLS_INSTALL_PORT_RANGE_START="${MTLS_INSTALL_PORT_RANGE_START:-$((PROXY_PORT + 1))}"
MTLS_INSTALL_PORT_RANGE_END="${MTLS_INSTALL_PORT_RANGE_END:-$((PROXY_PORT + 100))}"

# ── Installed components (impl 3e2c90da, phase S) ───────────────────────────
# PROXY = the connection layer (daemon + mTLS proxy, runtime/, .env, ~/.engram,
# target wiring) — always installed. HARNESS = the optional Claude Code layer
# ($HIVEMIND_HOME/.claude: CLAUDE.md, settings.json, commands/, hooks/ + the
# isolated Claude Code state; bin/hivemind-statusline.py; cmd_open's claude
# exec). Recorded in a plain-text marker (NOT a .env key): install.sh writes
# "proxy harness" (default) or "proxy" (--proxy-only); `hivemind uninstall
# harness` writes "proxy". An install with NO marker is a legacy install from
# before the split = proxy+harness, and is handled exactly as before.
_components_file() { printf '%s\n' "${HIVEMIND_HOME}/.components"; }

# _has_harness: 0 = the harness is installed. Only an explicit marker naming
# `proxy` without `harness` means proxy-only; absent, empty or unreadable
# content falls back to proxy+harness (the reference configuration) — a
# damaged marker can never silently stop a harness install from launching.
_has_harness() {
  local _f _c
  _f="$(_components_file)"
  [ -f "${_f}" ] || return 0
  # Redirect stderr of the whole group: a failing `< file` (unreadable marker)
  # is reported by the shell itself, before a trailing 2>/dev/null applies.
  _c=" $({ tr -s '[:space:]' ' ' < "${_f}"; } 2>/dev/null || true) "
  case "${_c}" in
    *" harness "*) return 0 ;;
    *" proxy "*)   return 1 ;;
    *)             return 0 ;;
  esac
}

# ── ANSI helpers (NO_COLOR-aware) ────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  _ok()  { printf '\033[0;32m%s\033[0m' "$*"; }
  _err() { printf '\033[0;31m%s\033[0m' "$*"; }
  _dim() { printf '\033[2m%s\033[0m' "$*"; }
else
  _ok()  { printf '%s' "$*"; }
  _err() { printf '%s' "$*"; }
  _dim() { printf '%s' "$*"; }
fi

# ── _vecho: verbose-only stderr echo — gated behind --verbose (parsed at the
# entry point, bottom of file). Debug/startup noise lives behind this; GO/NO-GO
# status and errors stay unconditional.
_vecho() {
  [ "${_VERBOSE:-0}" = "1" ] && echo "$@" >&2
  return 0
}

# ── _brand_header: quiet-by-default output still shows this once ───────────
# F6.1 — minimal ASCII identity block: small, simple geometry (a single glyph
# + two lines), NOT a logo/illustration — studio is out of scope here (glyph
# is a placeholder for studio to revise later). Shows the resolved endpoint
# (HIVEMIND_ENDPOINT, defaulting to the product's own domain) so a lab<->
# product swap via .env is visible at every startup, not just in the .env file.
_brand_header() {
  echo ""
  echo "  $(_ok "◆") HiveMind — shared memory runtime"
  echo "  $(_dim "→ ${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443}")"
}

# ── _has_cert: returns 0 only if THIS owner's cert exists (owner-scoped) ─────
# Aligned with _check_health / cmd_status (:301+), which validate exactly
# "${CERT_DIR}/${HIVEMIND_OWNER}.cert.pem". A bare `ls *.cert.pem` glob (the
# previous impl) accepted a cert belonging to ANY owner — so a machine that
# already enrolled owner A would silently SKIP setup for owner B, then present
# owner B a runtime authenticated as A. Owner-scoped here closes that: another
# owner's cert present + this owner's cert absent → _has_cert fails → _setup_mode.
# The glob is kept ONLY as the fallback for when HIVEMIND_OWNER is unset (no
# owner to scope to yet — e.g. a partial/legacy .env), preserving prior
# behavior in that one degenerate case.
_has_cert() {
  [ -d "${CERT_DIR}" ] || return 1
  local _owner="${HIVEMIND_OWNER:-}"
  if [ -n "${_owner}" ]; then
    [ -f "${CERT_DIR}/${_owner}.cert.pem" ]
  else
    ls "${CERT_DIR}"/*.cert.pem > /dev/null 2>&1
  fi
}

# ── _endpoint_ok: is the PRODUCT endpoint reachable from this machine? ────────
# Semantics: liveness of the public CA surface (DNS + TLS + a server that
# answers), NOT of the :4443 MCP port and NOT an authorization check.
#
# Do NOT probe ${HIVEMIND_ENDPOINT} verbatim: that host:PORT is the :4443 MCP
# listener, and it fails a certless probe for two independent reasons — (a) it
# is mutual-mTLS (requestCert), so it closes a connection that presents no
# client cert, and (b) its server cert is signed by the PRODUCT CA, not a
# publicly-trusted one. MEASURED 2026-07-31 against hivemind.ia.br:
# `curl -sf https://hivemind.ia.br:4443/ca/crl.pem` → curl exit 60, http_code
# 000 — so the previous probe was a PERMANENT false negative: _HEALTH_ENDPOINT_OK
# was 0 on every healthy install, and `hivemind status`/`health` reported
# "Endpoint: unreachable" / DEGRADED forever.
#
# The 443/Let's-Encrypt surface is the certless, publicly-trusted one — the
# SAME surface enrollment itself bootstraps over (see ENROLL_HOST in
# runtime/src/routes/setup.ts, and the reasoning there for why :4443 cannot
# serve it) — so this strips the port and probes the CA path there. Measured:
# 200 in ~0.12s.
#
# No -f, and ANY status counts as reachable — the same liveness discipline as
# _proxy_ok (:280): a 401/403/404 still proves DNS resolved, TLS completed and
# a server answered, which is exactly what this check claims. Only http_code
# 000 (connection refused / TLS failure / timeout) means unreachable. Probing
# :4443 WITH the enrolled client cert was the alternative; it was rejected
# because this check must also be meaningful BEFORE enrollment (cmd_status runs
# fine with no cert at all), and a cert-dependent probe would reintroduce the
# same class of false negative it is fixing.
_endpoint_ok() {
  local _host="${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443}"
  _host="${_host%%:*}"
  local _code
  _code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
    "https://${_host}/ca/crl.pem" 2>/dev/null) || return 1
  [ "${_code}" != "000" ]
}

# ── _check_health: single source of truth for runtime/proxy/cert/endpoint
# state — populates _HEALTH_* globals + _HEALTH_SEVERITY (0=ok, 1=degraded,
# 2=down). Never returns non-zero itself (severity lives in the variable, not
# in $?) — safe to call as a bare statement under `set -e`. Shared by
# cmd_status (human-readable) and cmd_health (script-friendly exit code).
_check_health() {
  _HEALTH_RUNTIME_OK=0
  _HEALTH_PROXY_CONFIGURED=0
  _HEALTH_PROXY_OK=0
  _HEALTH_CERT_STATE="absent"   # absent | valid | invalid | unknown
  _HEALTH_ENDPOINT_OK=0
  _HEALTH_SEVERITY=0

  if curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; then
    _HEALTH_RUNTIME_OK=1
  fi

  # Proxy is only counted against health if it's actually configured — dev
  # setups without MTLS_PROXY_PORT are a deliberate mode, not a failure.
  if [ -n "${MTLS_PROXY_PORT:-}" ]; then
    _HEALTH_PROXY_CONFIGURED=1
    # Reuse _proxy_ok's status-tolerant probe. A bare GET /v1/mcp returns 406
    # (Not Acceptable) while the proxy is perfectly GO — so `curl -sf`, which
    # fails on any 4xx, false-negatives the proxy as DEGRADED (measured
    # 2026-08-04). _proxy_ok counts any HTTP status back (incl. 4xx/5xx) as
    # "listener alive"; only http_code 000 (refused/timeout) is a real death.
    if _proxy_ok; then
      _HEALTH_PROXY_OK=1
    fi
  fi

  local _owner="${HIVEMIND_OWNER:-}"
  if _has_cert; then
    if [ -n "${_owner}" ] && [ -f "${CERT_DIR}/${_owner}.cert.pem" ] && [ -f "${CERT_DIR}/ca.cert.pem" ]; then
      if openssl verify -CAfile "${CERT_DIR}/ca.cert.pem" \
           "${CERT_DIR}/${_owner}.cert.pem" > /dev/null 2>&1; then
        _HEALTH_CERT_STATE="valid"
      else
        _HEALTH_CERT_STATE="invalid"
      fi
    else
      _HEALTH_CERT_STATE="unknown"
    fi
  fi

  # Endpoint reachability — new check (item 4.3), public path, no cert needed.
  if _endpoint_ok; then
    _HEALTH_ENDPOINT_OK=1
  fi

  if [ "${_HEALTH_RUNTIME_OK}" -eq 0 ]; then
    _HEALTH_SEVERITY=2
  elif { [ "${_HEALTH_PROXY_CONFIGURED}" -eq 1 ] && [ "${_HEALTH_PROXY_OK}" -eq 0 ]; } \
    || [ "${_HEALTH_CERT_STATE}" = "invalid" ] \
    || [ "${_HEALTH_ENDPOINT_OK}" -eq 0 ]; then
    _HEALTH_SEVERITY=1
  fi
  return 0
}

# ── _pid_is_hivemind_runtime: guards cmd_stop against killing a PID the OS
# recycled for an unrelated process after a crash left a stale pidfile behind.
# Matches the FULL absolute RUNTIME_BIN path (fixed-string, not a loose
# 'server.ts' fragment) — a generic 'server.ts' substring would false-positive
# on an unrelated `vim server.ts` or `tail -f server.ts.log` sharing the
# recycled PID, which is exactly the failure this guard exists to prevent.
_pid_is_hivemind_runtime() {
  local _pid="$1"
  ps -p "${_pid}" -o command= 2>/dev/null | grep -qF -- "${RUNTIME_BIN}"
}

# ── _kill_wait_escalate: SIGTERM, wait (bounded) for the process to ACTUALLY
# exit, escalate to SIGKILL if it doesn't. $1=pid, $2=seconds to wait (default 5).
# Sending the signal is not the same as the port being released: every caller
# here kills a daemon precisely because it wants ${RUNTIME_PORT}/${PROXY_PORT}
# back, so returning the instant `kill` returns just races the replacement into
# EADDRINUSE. Same wait+escalate shape cmd_stop already implements inline; this
# is the shared version for the auto-heal paths.
_kill_wait_escalate() {
  local _pid="$1" _wait="${2:-5}" _t=0
  kill "${_pid}" 2>/dev/null || true
  while kill -0 "${_pid}" 2>/dev/null && [ "${_t}" -lt "${_wait}" ]; do
    sleep 1; _t=$((_t + 1))
  done
  if kill -0 "${_pid}" 2>/dev/null; then
    _vecho "[hivemind] pid=${_pid} still alive after ${_wait}s — escalating to SIGKILL"
    kill -9 "${_pid}" 2>/dev/null || true
  fi
}

# ── Detach: the daemon is NEVER in the launching terminal's process group ────
# I8, measured 2026-10-07 on a live install: a launch auto-updated, restarted
# the daemon from that terminal, and a Ctrl+C at the project menu shut it down
# (`SIGINT — shutting down`, proxy down). The tty delivers SIGINT/SIGQUIT/
# SIGTSTP to its whole FOREGROUND process group, and a plain `cmd &` from a
# non-interactive script stays in the script's group — `nohup` only ignores
# SIGHUP and `disown` only drops the job table entry. Every daemon spawn goes
# through _detach_begin / `_in_new_session ... &` / _detach_end:
#   setsid  (Linux/WSL, util-linux) — a new SESSION: own process group and no
#           controlling terminal at all. The background child of this script is
#           never a group leader (no job control), so setsid(2) succeeds without
#           forking and `$!` stays the daemon's pid (the pidfile identity).
#   pgid    (fallback: base macOS has no setsid; also when the command is a
#           shell function, which setsid cannot exec) — job control (`set -m`)
#           only for that one `&`, so bash puts the child in its OWN process
#           group (pgid = `$!`); the terminal's signals go to the foreground
#           group only. stdin </dev/null at the call site keeps it from ever
#           reading the tty (SIGTTIN).
# Windows: bin/hivemind.ps1 Start-Daemon (both spawns: setup-only and runtime)
# uses Start-Process -WindowStyle Hidden without -Redirect* (ShellExecute), so
# the daemon gets its own hidden console and is not attached to the launching
# console that a Ctrl+C is delivered to — no change there (by reading).
_DETACH_VIA="pgid"
_DETACH_SET_M=0
# _detach_begin <cmd>: pick the mechanism for launching <cmd>; turns job
# control on for the pgid path. Always pair with _detach_end right after `&`.
_detach_begin() {
  # setsid only when there is a setsid binary AND <cmd> is a file it can exec;
  # the HIVEMIND_DETACH_VIA=setsid seam obeys the same precondition (falls
  # back to pgid instead of failing the spawn), =pgid always forces pgid.
  if [ "${_DETACH_VIA_OVERRIDE}" != "pgid" ] \
    && command -v setsid > /dev/null 2>&1 && [ "$(type -t "$1")" = "file" ]; then
    _DETACH_VIA="setsid"
  else
    _DETACH_VIA="pgid"
  fi
  _DETACH_SET_M=0
  if [ "${_DETACH_VIA}" = "pgid" ]; then
    # bin/hivemind runs as a non-interactive script, so `$-` normally has no
    # `m` and we turn job control on just for this one `&`. If a caller
    # already runs with job control on, the child gets its own group anyway
    # and we leave `m` as we found it (_DETACH_SET_M stays 0).
    case "$-" in *m*) ;; *) set -m; _DETACH_SET_M=1 ;; esac
  fi
}
_detach_end() {
  if [ "${_DETACH_SET_M}" = "1" ]; then set +m; _DETACH_SET_M=0; fi
}
# _in_new_session <cmd...>: run as `_in_new_session cmd ... &`. Replaces the
# background subshell with <cmd> (exec keeps `$!` == the daemon's pid), in a
# new session on the setsid path.
_in_new_session() {
  if [ "$(type -t "$1")" = "file" ]; then
    if [ "${_DETACH_VIA}" = "setsid" ]; then exec setsid "$@"; fi
    exec "$@"
  fi
  "$@"
}

# ── _setup_stop_daemon: stop the --setup-only daemon _setup_mode spawned ─────
# Identity-guarded like cmd_stop (_pid_is_hivemind_runtime): a pid the OS
# recycled for something else is never signalled. A child caught between
# fork and exec still shows the launcher's command line, so a live pid that
# does not match yet gets ~1s to exec before it is declared foreign. Always
# clears the setup pidfile. No-op for an empty pid (nothing spawned yet).
_setup_stop_daemon() {
  local _pid="${1:-}" _t=0
  if [ -n "${_pid}" ]; then
    while kill -0 "${_pid}" 2>/dev/null && ! _pid_is_hivemind_runtime "${_pid}" && [ "${_t}" -lt 10 ]; do
      sleep 0.1; _t=$((_t + 1))
    done
    if _pid_is_hivemind_runtime "${_pid}"; then
      _kill_wait_escalate "${_pid}" 5
    elif kill -0 "${_pid}" 2>/dev/null; then
      echo "  ! pid ${_pid} is not the setup server (${RUNTIME_BIN}) — left alone." >&2
    fi
  fi
  rm -f "${SETUP_PID_FILE}"
}

# ── _setup_interrupted <INT|TERM|HUP>: _setup_mode's signal trap ─────────────
# The setup daemon runs in its own session (I8), so the terminal's Ctrl+C no
# longer kills it as a side effect; this is the deliberate teardown that
# replaces that accident. Armed BEFORE the spawn: a signal in the gap between
# the `&` and `_SETUP_PID=$!` (bash runs the trap between the two) still finds
# the child through `$!`, which then differs from the pre-spawn snapshot.
# Exits with the shell's own code for that signal: 130 / 143 / 129.
_SETUP_PID=""
_SETUP_PRE_BANG=""
_setup_interrupted() {
  local _sig="${1:-INT}" _pid="${_SETUP_PID:-}"
  trap - INT TERM HUP
  if [ -z "${_pid}" ] && [ -n "${!:-}" ] && [ "${!}" != "${_SETUP_PRE_BANG}" ]; then
    _pid="${!}"
  fi
  echo "" >&2
  echo "Setup interrupted — stopping the setup server." >&2
  _setup_stop_daemon "${_pid}"
  case "${_sig}" in
    TERM) exit 143 ;;
    HUP)  exit 129 ;;
    *)    exit 130 ;;
  esac
}

# ── _setup_daemon_died: fail-fast exit for _setup_mode ───────────────────────
# Called when the --setup-only daemon _setup_mode spawned is no longer alive
# (kill -0 fails). The usual cause is EADDRINUSE: something that is NOT a
# hivemind runtime holds ${RUNTIME_PORT}, so _reap_stale_runtime (identity-
# guarded) left it alone and our daemon could not bind. Exits 1.
_setup_daemon_died() {
  trap - INT TERM HUP
  echo "Error: the setup server exited unexpectedly (pid ${_SETUP_PID})." >&2
  echo "       Most likely port ${RUNTIME_PORT} is already in use by another program." >&2
  echo "       Check: lsof -i :${RUNTIME_PORT}   (or set AR_PORT to a free port)" >&2
  echo "       Log:   ${RUNTIME_LOG}" >&2
  rm -f "${SETUP_PID_FILE}"
  exit 1
}

# ── _setup_mode: first-login flow ─────────────────────────────────────────────
# Starts server in setup-only mode, opens browser, polls /setup/status until done.
_setup_mode() {
  _brand_header
  echo "First run detected — no certificate found."
  echo "Starting setup server..."

  if ! command -v bun > /dev/null 2>&1; then
    echo "Error: 'bun' is required but not found." >&2
    echo "Install bun: curl -fsSL https://bun.sh/install | bash" >&2
    exit 1
  fi
  if ! command -v openssl > /dev/null 2>&1; then
    echo "Error: 'openssl' is required but not found." >&2
    exit 1
  fi
  if [ ! -f "${RUNTIME_BIN}" ]; then
    echo "Error: runtime not found at ${RUNTIME_BIN}" >&2
    echo "Re-run: bash install.sh" >&2
    exit 1
  fi

  mkdir -p "$(dirname "${RUNTIME_LOG}")"

  # A stale daemon from an earlier, interrupted enrollment (or a healthy,
  # already-running daemon from a PRIOR enrollment on this machine) holds
  # ${RUNTIME_PORT} and would make the spawn below die on EADDRINUSE — with
  # its output going to the log file the user never opens. Reap it first
  # (identity-guarded via _pid_is_hivemind_runtime, never touches a foreign
  # process) unconditionally, healthy or not: re-enroll SUBSTITUTES the
  # running daemon rather than refusing or requiring a manual `hivemind stop`
  # first (single-owner-per-machine — decision
  # decision_hivemind-single-owner-per-machine-and-re-enroll-replaces,
  # founder 2026-08-07). The daemon this reaps only ever serves THIS
  # machine's single owner, so replacing it is always safe; there is no
  # multi-owner coexistence case to protect against here.
  _reap_stale_runtime

  # One-shot setup nonce (F2, security impl 9658277f, R2). The setup daemon's
  # POST /setup/enroll rewrites this machine's FOS_API_KEY/HIVEMIND_OWNER/cert,
  # so it only accepts a request carrying this secret: handed to the daemon
  # via the process environment ONLY (never written to disk, never passed on
  # argv where `ps` would show it, never logged — not even under --verbose)
  # and to the browser via the URL it opens below. The daemon burns it on the
  # first successful enroll. openssl is already a hard requirement (checked
  # above; the enroll handler shells out to it for the keypair/CSR).
  local _setup_nonce
  _setup_nonce="$(openssl rand -hex 32 2>/dev/null)" || _setup_nonce=''
  case "${_setup_nonce}" in
    *[!0-9a-f]*|'') _setup_nonce='' ;;
  esac
  if [ "${#_setup_nonce}" -ne 64 ]; then
    echo "Error: could not generate the setup nonce (openssl rand failed)." >&2
    exit 1
  fi

  _vecho "[hivemind] setup: runtime=${RUNTIME_BIN} port=${RUNTIME_PORT} log=${RUNTIME_LOG}"
  _vecho "[hivemind] setup: endpoint=${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443} (enrollment goes to the 443/LE surface of this host)"
  # Own session / process group (I8, see _detach_begin) — but unlike the
  # runtime this daemon belongs to the enrollment THIS launcher drives: on a
  # Ctrl+C / termination / hangup the trap stops it deliberately (SIGTERM,
  # identity-guarded, pidfile removed) instead of the terminal's SIGINT hitting
  # it by accident, and it is never left behind holding ${RUNTIME_PORT} with a
  # live nonce. The trap is armed BEFORE the spawn so no signal can land in a
  # window where the daemon exists and nothing will stop it.
  _SETUP_PID=""
  _SETUP_PRE_BANG="${!:-}"
  trap '_setup_interrupted INT' INT
  trap '_setup_interrupted TERM' TERM
  trap '_setup_interrupted HUP' HUP
  _detach_begin bun
  if [ "${_VERBOSE:-0}" = "1" ]; then
    # --verbose was INERT during enrollment: the setup daemon's stdout/stderr
    # went ONLY to ${RUNTIME_LOG}, so a failing enroll printed nothing on the
    # terminal and the user had to know to go read a file to see why. Tee it to
    # stderr as well when verbose.
    # Process substitution, NOT a `| tee` pipeline: in a pipeline `$!` is the
    # LAST command (tee), so _SETUP_PID would stop pointing at bun and every
    # kill below — including cmd_stop's leftover cleanup — would miss the
    # daemon. With `> >(...)`, `$!` is still bun.
    HIVEMIND_SETUP_NONCE="${_setup_nonce}" _in_new_session bun run "${RUNTIME_BIN}" --setup-only > >(tee -a "${RUNTIME_LOG}" >&2) 2>&1 < /dev/null &
  else
    HIVEMIND_SETUP_NONCE="${_setup_nonce}" _in_new_session bun run "${RUNTIME_BIN}" --setup-only >> "${RUNTIME_LOG}" 2>&1 < /dev/null &
  fi
  _SETUP_PID=$!
  _detach_end
  mkdir -p "$(dirname "${SETUP_PID_FILE}")"
  echo "${_SETUP_PID}" > "${SETUP_PID_FILE}"
  _vecho "[hivemind] setup: daemon spawned (pid=${_SETUP_PID}) — waiting for healthz"

  # Poll until setup server ready (timeout 15s).
  # Liveness check each tick: if OUR setup daemon already died (typically
  # EADDRINUSE — a foreign process holds ${RUNTIME_PORT}), fail fast with the
  # reason instead of polling a port it never bound. This also stops a
  # FOREIGN daemon's /healthz on that port from being mistaken for ours.
  _TRIES=0
  until kill -0 "${_SETUP_PID}" 2>/dev/null \
      && curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; do
    if ! kill -0 "${_SETUP_PID}" 2>/dev/null; then
      _setup_daemon_died
    fi
    _TRIES=$((_TRIES + 1))
    if [ "${_TRIES}" -ge 15 ]; then
      echo "Error: setup server did not start after 15s. Check: ${RUNTIME_LOG}" >&2
      trap - INT TERM HUP
      _setup_stop_daemon "${_SETUP_PID}"
      exit 1
    fi
    sleep 1
  done
  _vecho "[hivemind] setup: daemon answering healthz on ${RUNTIME_PORT}"

  # The nonce rides in the URL so the page can present it back as
  # x-setup-nonce (the page then strips it from the address bar). This URL is
  # printed to the user's own terminal — deliberately, so it can be opened by
  # hand when xdg-open/open does nothing (WSL, headless) — but it never goes to
  # RUNTIME_LOG or through _vecho. It is single-use and dies with this daemon.
  local _SETUP_URL="http://localhost:${RUNTIME_PORT}/setup?nonce=${_setup_nonce}"
  echo "Opening browser: ${_SETUP_URL}"

  if command -v xdg-open > /dev/null 2>&1; then
    xdg-open "${_SETUP_URL}" > /dev/null 2>&1 &
  elif command -v open > /dev/null 2>&1; then
    open "${_SETUP_URL}" &
  else
    echo "(Could not auto-open browser — open manually: ${_SETUP_URL})"
  fi

  echo "Fill in your API Key, then click 'Configure mTLS'."
  echo "Waiting for enrollment to complete (timeout: 5 min)..."

  # Poll /setup/status until done (timeout 300s / 5 min).
  # NOTE: `grep -q` used directly as the if-condition — a prior version used
  # `grep -c ... || echo 0` into a variable, but grep -c exits 1 when the
  # count is 0 (even though it prints "0"), which under pipefail ALSO fires
  # the `|| echo 0` fallback, producing a duplicated "0\n0" that broke the
  # `-gt` integer test every tick. grep -q as a bare condition has no such
  # count-vs-exit-code mismatch to trip over.
  _TRIES=0
  while :; do
    # Same liveness check as the healthz wait: a setup daemon that died
    # mid-enrollment must not cost the user the full 5-minute timeout.
    if ! kill -0 "${_SETUP_PID}" 2>/dev/null; then
      _setup_daemon_died
    fi
    if curl -sf "http://127.0.0.1:${RUNTIME_PORT}/setup/status" 2>/dev/null \
      | grep -q '"done":true'; then
      break
    fi
    _TRIES=$((_TRIES + 1))
    if [ "${_TRIES}" -ge 300 ]; then
      echo "Timeout: enrollment did not complete in 5 minutes." >&2
      trap - INT TERM HUP
      _setup_stop_daemon "${_SETUP_PID}"
      exit 1
    fi
    sleep 1
  done
  _vecho "[hivemind] setup: enrollment reported done — stopping the setup daemon"

  # The setup daemon must be GONE, not merely signalled, before we tell the user
  # to run `hivemind`: it holds ${RUNTIME_PORT}, and setup-only mode never starts
  # the mTLS proxy. A lingering one makes the very next `hivemind` see "runtime
  # up on ${RUNTIME_PORT}, proxy ${PROXY_PORT} dead" — the founder-reported
  # "mTLS proxy: not responding" right after a SUCCESSFUL enroll. The reap in
  # _start_proxy now recovers from that state; waiting here means it should
  # never be entered in the first place.
  trap - INT TERM HUP
  _setup_stop_daemon "${_SETUP_PID}"
  echo ""
  echo "Done. Run 'hivemind' in your project directory to start."
  # Wizard-was-orphan fix (reinforcement_zero-friction-setup-is-product-law):
  # proactively surface `hivemind install` right after a successful first
  # enrollment for any detectable-but-unmapped client target — non-blocking,
  # the offer itself is the discovery mechanism. One-time event (this
  # function only runs once per enrollment), so unthrottled here, unlike the
  # cmd_open/cmd_start call sites below.
  _detect_unmapped_install_candidates
  exit 0
}

# ── _proxy_ok: is the local mTLS proxy LISTENER (7779) alive? ─────────────────
# Semantics: LIVENESS of the local listener, NOT upstream (:4443) reachability.
# We do NOT use -f here (unlike _check_health's :119 probe): -f fails on any
# 4xx/5xx, so OFFLINE — when the proxy is healthy but its upstream is
# unreachable and it answers 502 — a -f probe would false-negative and the
# auto-heal would kill+restart a perfectly good runtime on every `hivemind`.
# Instead: any HTTP status back (incl. 502/4xx/5xx) means "process alive,
# listening" → OK; only connection-refused / timeout (curl writes http_code
# 000, or exits non-zero without connecting) means the listener is dead → FAIL.
# Gated on MTLS_PROXY_PORT: a dev setup without the proxy is a deliberate mode,
# not a failure, so it reports OK (reuse then proceeds on healthz alone,
# unchanged). --max-time 3 bounds a stuck/hung proxy; 3s mirrors :139.
_proxy_ok() {
  [ -n "${MTLS_PROXY_PORT:-}" ] || return 0
  local _code
  _code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
    "https://127.0.0.1:${PROXY_PORT}/v1/mcp" 2>/dev/null) || return 1
  [ "${_code}" != "000" ]
}

# ── _reap_orphan_runtimes: reap OUR runtimes that NO pidfile records ──────────
# A pidfile is not a reliable census of our own daemons: _spawn_runtime writes
# RUNTIME_PID_FILE only AFTER healthz answers (deliberate — see its header), and
# _setup_mode removes SETUP_PID_FILE the moment enrollment ends. So a daemon
# that outlived the shell that spawned it, or one left over from an interrupted
# enrollment, can hold ${RUNTIME_PORT} while being invisible to BOTH the pidfile
# reap below AND `hivemind stop` — which is exactly why the founder's only way
# out was a manual stop+start that, by luck, also cleared SETUP_PID_FILE.
#
# Selection is by IDENTITY, never by port: a candidate must carry the FULL
# absolute RUNTIME_BIN path on its command line (the same fixed-string,
# full-path guard as _pid_is_hivemind_runtime, and RUNTIME_BIN is derived from
# HIVEMIND_HOME — so this only ever matches THIS install's daemons). Reaping
# "whatever holds ${RUNTIME_PORT}" was rejected: on a developer box the very
# same default port is routinely held by an unrelated agent-runtime, and killing
# it would be a far worse bug than the one being fixed.
_reap_orphan_runtimes() {
  local _pids _pid
  if command -v pgrep > /dev/null 2>&1; then
    _pids=$(pgrep -f -- "${RUNTIME_BIN}" 2>/dev/null || true)
  else
    # No pgrep (minimal container): same census via ps. The grep in this
    # pipeline carries RUNTIME_BIN on its OWN command line, but it has exited
    # by the time the loop runs and the re-verification below drops it anyway.
    _pids=$(ps -eo pid=,command= 2>/dev/null | grep -F -- "${RUNTIME_BIN}" | awk '{print $1}' || true)
  fi
  for _pid in ${_pids}; do
    # `if` rather than `[ ... ] && continue`: the latter's non-zero status on a
    # non-match is an errexit trap waiting for the next edit to spring it.
    if [ "${_pid}" = "$$" ]; then continue; fi
    kill -0 "${_pid}" 2>/dev/null || continue
    # Re-verify before killing: `pgrep -f` treats its argument as a REGEX (every
    # '.' in the path is a wildcard) and the ps fallback matched a raw line —
    # confirm with the fixed-string check cmd_stop trusts, so a loose match can
    # never escalate into killing something that is not ours.
    _pid_is_hivemind_runtime "${_pid}" || continue
    _vecho "[hivemind] auto-heal: reaping orphan runtime with no pidfile (pid=${_pid})"
    _kill_wait_escalate "${_pid}" 5
  done
}

# ── _reap_stale_runtime: auto-heal what `hivemind stop` does by hand ──────────
# Kills the runtime recorded in the pidfile ONLY when it is genuinely a
# hivemind-runtime (via _pid_is_hivemind_runtime — the SAME guard cmd_stop
# uses), then clears the pidfile. Fail-safe: a recycled/foreign PID is NEVER
# killed (only the stale pidfile is cleared). Callers invoke this ONLY after
# establishing the current runtime is unhealthy (healthz down, or 7777 up but
# proxy 7779 broken), so it never touches a HEALTHY runtime.
#
# BOTH pidfiles are swept, not just RUNTIME_PID_FILE: a --setup-only daemon
# (SETUP_PID_FILE) listens on the SAME ${RUNTIME_PORT} as a normal runtime, and
# setup-only mode deliberately never starts the mTLS proxy (server.ts:
# `if (!isSetupOnly) startMtlsProxy()`). A leftover one therefore presents the
# exact state the auto-heal exists for — /healthz answers on ${RUNTIME_PORT},
# ${PROXY_PORT} is dead — while a RUNTIME_PID_FILE-only reap finds nothing to
# kill and the fresh spawn then dies on EADDRINUSE. That is the measured
# "enrolled fine, then 'mTLS proxy: not responding' until a manual stop+start"
# bug (founder, 2026-07-31): _setup_mode signalled its daemon and exited without
# waiting, and nothing downstream owned the leftover.
_reap_stale_runtime() {
  local _f _pid
  for _f in "${RUNTIME_PID_FILE}" "${SETUP_PID_FILE}"; do
    [ -f "${_f}" ] || continue
    _pid=$(cat "${_f}" 2>/dev/null || echo '')
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
      if _pid_is_hivemind_runtime "${_pid}"; then
        _vecho "[hivemind] auto-heal: stopping stale/stuck runtime (pid=${_pid}, pidfile=${_f})"
        _kill_wait_escalate "${_pid}" 5
      else
        _vecho "[hivemind] pidfile pid=${_pid} is not a hivemind runtime (recycled) — clearing pidfile only, not killing"
      fi
    fi
    rm -f "${_f}"
  done

  # Last resort: daemons no pidfile knows about (see _reap_orphan_runtimes).
  _reap_orphan_runtimes
}

# ── _spawn_runtime: launch a fresh runtime, wait for healthz, THEN write pidfile
# The pidfile is written ONLY after healthz confirms the process is actually up
# — never records the PID of a bun that died at startup (EADDRINUSE), which is
# exactly what used to sabotage a later `hivemind stop`. An early exit (bun
# dying on EADDRINUSE/crash) is detected via kill -0 and returns 1 FAST instead
# of burning the full 15s timeout. Returns 0 on success, 1 otherwise.
_spawn_runtime() {
  local _pid
  # Own session / process group (I8, see _detach_begin): a Ctrl+C in the
  # launching terminal — including the auto-update restart, which reaches here
  # through _start_proxy from the user's own `hivemind` — must never reach the
  # daemon. nohup + disown stay: the daemon must survive the terminal that launched it
  # closing (Fase 1, DR-1.1) — nohup makes the child IGNORE SIGHUP (portable
  # POSIX, kept on the pgid fallback where there is no setsid); disown drops the job
  # from bash's job table so the shell itself never signals the child when
  # this script exits. Neither alone is enough: nohup without disown can
  # still be waited on by a stray `wait` under `set -euo pipefail`. Redirect
  # stdin from /dev/null — nohup does not do this itself, and a detached
  # process with no terminal reading stdin can otherwise block/misbehave.
  # HIVEMIND_DEVICE_ID is exported into the daemon's env here so later
  # reconcile/event-emission (Fase 2/4) can tag its own device without a
  # second, divergent notion of "device" inside the daemon process.
  _detach_begin nohup
  HIVEMIND_DEVICE_ID="$(_resolve_device_id)" \
    _in_new_session nohup bun run "${RUNTIME_BIN}" >> "${RUNTIME_LOG}" 2>&1 < /dev/null &
  _pid=$!
  _detach_end
  disown

  local _tries=0
  until curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; do
    # Bun exited during startup (EADDRINUSE / crash) — bail immediately rather
    # than polling a dead PID for 15s.
    if ! kill -0 "${_pid}" 2>/dev/null; then
      _vecho "[hivemind] runtime exited during startup (pid=${_pid}) — see ${RUNTIME_LOG}"
      return 1
    fi
    _tries=$((_tries + 1))
    if [ "${_tries}" -ge 15 ]; then
      _vecho "[hivemind] runtime did not answer healthz after 15s — killing pid=${_pid}"
      kill "${_pid}" 2>/dev/null || true
      return 1
    fi
    sleep 1
  done

  # Up and answering — NOW it is safe to record the pid.
  echo "${_pid}" > "${RUNTIME_PID_FILE}"
  return 0
}

# ── _local_ca_trusted: is the CURRENT local-https CA already in the system
# store? Fingerprint-compared (not just presence) so a rotated/regenerated CA
# (e.g. ~/.engram/mtls/local-https/ wiped and regenerated) is detected and
# re-trusted, instead of silently trusting a stale copy forever.
_local_ca_trusted() {
  [ -f "${SYSTEM_CA_DEST}" ] || return 1
  local _have _want
  _have="$(_cert_fingerprint_sha256 "${SYSTEM_CA_DEST}" 2>/dev/null)"
  _want="$(_cert_fingerprint_sha256 "${LOCAL_HTTPS_CA}" 2>/dev/null)"
  [ -n "${_have}" ] && [ "${_have}" = "${_want}" ]
}

# ── _trust_local_ca: item 1.4 — trust the local HTTPS listener CA into the
# WSL/Linux system store (this machine only; Windows/Antigravity trust is
# Phase 4 item 4.4, out of scope here). No-op when the local CA has not been
# generated yet (mtls-proxy.ts generates it lazily on first proxy start —
# nothing to trust before that) or when already trusted (idempotent).
# System-level act (sudo + update-ca-certificates) — this is the ONE place
# in the codebase that escalates; never called speculatively, only from
# _start_proxy right after a runtime is confirmed up.
_trust_local_ca() {
  [ -f "${LOCAL_HTTPS_CA}" ] || return 0
  _local_ca_trusted && return 0

  if ! command -v update-ca-certificates > /dev/null 2>&1; then
    _vecho "[hivemind] update-ca-certificates not found (non-Debian/Ubuntu host?) — local HTTPS CA not trusted system-wide; strict-TLS clients will fail to verify 127.0.0.1:${PROXY_PORT}"
    return 0
  fi

  echo "[hivemind] trusting local HTTPS CA into the system store (sudo required): ${SYSTEM_CA_DEST}" >&2
  if sudo cp "${LOCAL_HTTPS_CA}" "${SYSTEM_CA_DEST}" 2>/dev/null \
    && sudo update-ca-certificates > /dev/null 2>&1; then
    _vecho "[hivemind] local HTTPS CA trusted"
  else
    echo "[hivemind] WARNING: failed to trust local HTTPS CA — a strict-TLS IDE client will fail to verify https://127.0.0.1:${PROXY_PORT}/v1/mcp until 'sudo update-ca-certificates' is run manually with ${LOCAL_HTTPS_CA} copied to ${SYSTEM_CA_DEST}" >&2
  fi
}

# ── Blocker 3b7a507e (b): a certificate alone does not make a running proxy ───
# The daemon starts the mTLS proxy only when MTLS_PROXY_PORT + MTLS_CERT_PATH/
# KEY_PATH/CA_PATH reach it (server.ts: "[mtls-proxy] disabled ..."), and the
# proxy authenticates with HIVEMIND_OWNER + FOS_API_KEY — all written to .env by
# enrollment (setup.ts). _has_cert only looks at the cert FILE, so a machine
# whose .env lost those keys (the reinstall after `uninstall --keep-certs`
# before this fix) skipped enrollment, answered healthz, and `hivemind` exited 0
# with no proxy behind it. With a certificate present, a start now requires the
# proxy listener, else it stops the daemon and exits 1 naming the missing keys.
_CREDENTIAL_KEYS=(MTLS_CERT_PATH MTLS_KEY_PATH MTLS_CA_PATH MTLS_PROXY_PORT HIVEMIND_OWNER FOS_API_KEY)

# _proxy_listening: 0 = something accepts TCP on 127.0.0.1:${PROXY_PORT}. A pure
# liveness probe: no TLS (an untrusted local CA cannot false-negative it), no
# request, nothing sent.
_proxy_listening() {
  (exec 3<>"/dev/tcp/127.0.0.1/${PROXY_PORT}") 2>/dev/null
}

# _proxy_up_if_enrolled: the _start_proxy fast path's extra condition. When
# MTLS_PROXY_PORT is set, _proxy_ok has already probed the listener — nothing
# more is done (a healthy install takes exactly the old path). Only when it is
# unset (_proxy_ok then passes without probing) AND a certificate is present is
# the listener probed, so a proxy-less runtime is never reused as healthy.
_proxy_up_if_enrolled() {
  [ -z "${MTLS_PROXY_PORT:-}" ] || return 0
  _has_cert || return 0
  _proxy_listening
}

_proxy_down_message() {
  local _k _missing=""
  for _k in "${_CREDENTIAL_KEYS[@]}"; do
    [ -n "${!_k:-}" ] || _missing="${_missing:+${_missing}, }${_k}"
  done
  echo "Error: a certificate is present in ${CERT_DIR} but the mTLS proxy is not listening on port ${PROXY_PORT} after start — the runtime was stopped." >&2
  if [ -n "${_missing}" ]; then
    echo "       ${HIVEMIND_HOME}/.env is missing ${_missing} (the enrollment credentials); the certificate alone cannot start the proxy." >&2
    echo "       Re-enroll: move the *.cert.pem / *.key.pem files out of ${CERT_DIR}, then run 'hivemind' again." >&2
  else
    echo "       Check the daemon log: ${RUNTIME_LOG}" >&2
  fi
}

# _require_proxy_listening <pid>: called by _start_proxy once a runtime answers
# healthz. No certificate → nothing to check (setup-only / dev mode, unchanged).
# Otherwise wait up to _PROXY_WAIT_SECS for the listener (fail fast if <pid>
# died); on failure stop OUR runtime(s) (identity-guarded, same reap the
# auto-heal uses), clear the pidfiles and exit 1.
_require_proxy_listening() {
  _has_cert || return 0
  local _pid="${1:-}" _i=0 _n=$((_PROXY_WAIT_SECS * 4))
  while :; do
    _proxy_listening && return 0
    [ "${_i}" -lt "${_n}" ] || break
    if [ -n "${_pid}" ] && ! kill -0 "${_pid}" 2>/dev/null; then break; fi
    sleep 0.25
    _i=$((_i + 1))
  done
  _reap_stale_runtime
  _proxy_down_message
  exit 1
}

# ── _start_proxy: ensure a HEALTHY runtime+proxy is running (idempotent) ──────
# Reuse only a genuinely healthy runtime: healthz(7777) AND proxy(7779) both OK.
# If 7777 answers but the proxy is broken (the orphaned/stuck runtime left by an
# abrupt Claude close — the "hivemind won't reopen, needs a manual stop" bug),
# auto-heal: reap OUR stale runtime + start fresh. EADDRINUSE (failure mode B)
# is handled explicitly — reap the orphan holding the port + one retry — rather
# than eating the 15s timeout, and the pidfile is never overwritten with a dead
# PID.
_start_proxy() {
  # Fast path: an already-healthy runtime+proxy is reused untouched.
  if curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; then
    # Item 1.4: ensure the local HTTPS cert (if present) is trusted BEFORE
    # the _proxy_ok probe below — that probe is now an https:// request, so
    # an untrusted CA would make a perfectly healthy proxy read as "down"
    # (SSL verify failure, not connection-refused) and trigger a needless
    # reap+restart loop. Idempotent/cheap when already trusted.
    _trust_local_ca
    if _proxy_ok && _proxy_up_if_enrolled; then
      return 0
    fi
    # 7777 up but proxy 7779 down/stuck → this runtime is unhealthy. Reap it
    # (only if it is really ours) and fall through to a clean fresh start.
    _vecho "[hivemind] runtime up on ${RUNTIME_PORT} but proxy ${PROXY_PORT} not responding — auto-healing"
    _reap_stale_runtime
  fi

  if ! command -v bun > /dev/null 2>&1; then
    echo "Error: 'bun' is required. Install: curl -fsSL https://bun.sh/install | bash" >&2
    exit 1
  fi
  if [ ! -f "${RUNTIME_BIN}" ]; then
    echo "Error: runtime not found at ${RUNTIME_BIN}. Re-run: bash install.sh" >&2
    exit 1
  fi

  mkdir -p "$(dirname "${RUNTIME_LOG}")"

  # Before spawning, clear any stale runtime WE own that may still hold the port
  # (failure mode B: EADDRINUSE from an orphan). Safe no-op when the pidfile is
  # absent or points to a non-hivemind PID.
  _reap_stale_runtime

  _vecho "[hivemind] starting runtime..."
  if ! _spawn_runtime; then
    # One retry: an orphan may have raced us for the port. Reap + retry once.
    _vecho "[hivemind] first start failed — reaping any port-holder and retrying once"
    _reap_stale_runtime
    if ! _spawn_runtime; then
      echo "Error: hivemind runtime did not start (port ${RUNTIME_PORT} busy or startup crash). Check: ${RUNTIME_LOG}" >&2
      exit 1
    fi
  fi
  _vecho "[hivemind] runtime up (pid=$(cat "${RUNTIME_PID_FILE}" 2>/dev/null || echo '?'))"

  # healthz(7777) confirmed above by _spawn_runtime — by server.ts's own
  # startup order, startMtlsProxy() (and its lazy cert generation) runs
  # synchronously BEFORE the main app's Bun.serve, so LOCAL_HTTPS_CA already
  # exists on disk here if the proxy is configured at all (item 1.4).
  _trust_local_ca
  _require_proxy_listening "$(cat "${RUNTIME_PID_FILE}" 2>/dev/null || echo '')"
}

# ── Subcommands ───────────────────────────────────────────────────────────────

cmd_version() {
  echo "HiveMind v${HIVEMIND_VERSION}"
}

cmd_help() {
  echo "Usage: hivemind [<slug>] | start | stop | restart | status | health | update | resume <slug> | install [<target>] | uninstall [all|harness] | autostart on|off|status | --version"
  echo ""
  echo "  hivemind [<slug>]     Start proxy + open Claude Code (slug = arg, else interactive picker)"
  echo "                         On a proxy-only install (install.sh --proxy-only, or after"
  echo "                         'hivemind uninstall harness'): start the proxy only and print how"
  echo "                         to connect your MCP client — Claude Code is never started."
  echo "  hivemind start        Start proxy only"
  echo "  hivemind stop         Stop the proxy"
  echo "  hivemind restart      Stop + start (best-effort)"
  echo "  hivemind status       Show proxy health and certificate validity (human-readable)"
  echo "  hivemind health       Same checks as status; exit 0=ok 1=degraded 2=down"
  echo "  hivemind update       Pull-agent: staged + verified + atomic update, auto-rollback"
  echo "  hivemind resume <slug>  Explicit crash recovery: close a dead-holder session for <slug>, then open"
  echo "  hivemind install [<target>]  Guided setup of another local MCP client (Cursor, Antigravity, ...)"
  echo "                         Interactive only — detects candidates, asks scope, confirms the exact"
  echo "                         path with you before writing anything. No default path, ever."
  echo "                         Under WSL2 (this runtime's supported environment), a Windows-native"
  echo "                         client (Cursor, Cowork, Antigravity) reaches the written"
  echo "                         https://127.0.0.1:<port>/v1/mcp URL AS-IS — WSL2's own default"
  echo "                         localhost-forwarding already bridges it to the Linux-side listener,"
  echo "                         no extra relay/bridge setup needed (confirmed working, founder-tested)."
  echo "  hivemind uninstall [all|harness] [--yes] [--keep-certs]"
  echo "                         Remove everything HiveMind installed on this machine (all, default),"
  echo "                         or only the Claude Code harness (harness) — lists it first."
  echo "                         See 'hivemind uninstall --help'."
  echo "  hivemind autostart on|off|status"
  echo "                         Start the proxy automatically at log-on (opt-in; off by default)."
  echo "                         Linux: a systemd --user unit (no systemd: an XDG autostart entry)."
  echo "                         WSL: also a Windows Startup trigger that boots this distro at"
  echo "                         Windows log-on and keeps it running. 'off' removes all of it."
  echo "  hivemind --version    Print version"
  echo ""
  echo "  --verbose             Show startup/debug logs (default: quiet, GO/NO-GO + errors only)"
}

cmd_status() {
  _check_health
  echo "HiveMind v${HIVEMIND_VERSION} — status"
  echo ""

  if [ "${_HEALTH_RUNTIME_OK}" = "1" ]; then
    echo "  Runtime:    $(_ok "OK") (port ${RUNTIME_PORT})"
  else
    echo "  Runtime:    $(_err "STOPPED") (port ${RUNTIME_PORT})"
  fi

  if [ "${_HEALTH_PROXY_CONFIGURED}" = "1" ]; then
    if [ "${_HEALTH_PROXY_OK}" = "1" ]; then
      echo "  mTLS proxy: $(_ok "OK") (port ${PROXY_PORT})"
    else
      echo "  mTLS proxy: $(_err "not responding") (port ${PROXY_PORT})"
    fi
  else
    echo "  mTLS proxy: $(_dim "not configured") (port ${PROXY_PORT})"
  fi

  local _owner="${HIVEMIND_OWNER:-}"
  case "${_HEALTH_CERT_STATE}" in
    valid)   echo "  Cert:       $(_ok "VALID") (owner=${_owner})" ;;
    invalid) echo "  Cert:       $(_err "INVALID") — re-enroll: rm -rf ${CERT_DIR} && hivemind" ;;
    unknown) echo "  Cert:       $(_dim "present (run 'hivemind' to validate)")" ;;
    *)       echo "  Cert:       $(_dim "NOT FOUND") — run 'hivemind' to enroll" ;;
  esac

  if [ "${_HEALTH_ENDPOINT_OK}" = "1" ]; then
    echo "  Endpoint:   $(_ok "reachable") (${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443})"
  else
    echo "  Endpoint:   $(_dim "unreachable") (${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443})"
  fi
}

cmd_health() {
  _check_health
  case "${_HEALTH_SEVERITY}" in
    0) echo "$(_ok "OK") — runtime, proxy, cert and endpoint healthy" ;;
    1) echo "$(_err "DEGRADED") — run 'hivemind status' for details" ;;
    2) echo "$(_err "DOWN") — runtime not responding on port ${RUNTIME_PORT}" ;;
  esac
  return "${_HEALTH_SEVERITY}"
}

cmd_start() {
  if ! _has_cert; then _setup_mode; fi
  _maybe_migrate_source || true
  _start_proxy
  echo "[hivemind] proxy running on port ${PROXY_PORT}"
  _maybe_surface_install_candidates
  # Proxy-only installs only (phase S4) — the proxy+harness output is unchanged.
  if ! _has_harness; then _print_connect_hints; fi
}

cmd_stop() {
  if [ -f "${RUNTIME_PID_FILE}" ]; then
    local _pid
    _pid=$(cat "${RUNTIME_PID_FILE}" 2>/dev/null || echo '')
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
      if _pid_is_hivemind_runtime "${_pid}"; then
        kill "${_pid}"
        # DR-3.2: wait (bounded) for the daemon to actually exit, escalating
        # to SIGKILL if it doesn't — mirrors _reap_stale_runtime's own
        # wait+escalate (:286-293). Without this, `cmd_stop` used to
        # return the instant the signal was SENT, not once the process was
        # actually gone — cmd_update's mid-swap cmd_stop (:700) could then
        # race on to the mv/rename of $HIVEMIND_HOME while the old process
        # was still up, holding open files/ports.
        local _t=0
        while kill -0 "${_pid}" 2>/dev/null && [ "${_t}" -lt 10 ]; do
          sleep 1; _t=$((_t + 1))
        done
        if kill -0 "${_pid}" 2>/dev/null; then
          _vecho "[hivemind] runtime still alive after 10s — escalating to SIGKILL (pid=${_pid})"
          kill -9 "${_pid}" 2>/dev/null || true
        fi
        rm -f "${RUNTIME_PID_FILE}"
        echo "[hivemind] runtime stopped"
      else
        # Stale pidfile: PID is alive but recycled by the OS for an unrelated
        # process (crash left the pidfile behind) — do NOT kill it.
        echo "[hivemind] pidfile PID ${_pid} is not a hivemind runtime (stale/recycled) — not killing, clearing pidfile" >&2
        rm -f "${RUNTIME_PID_FILE}"
      fi
    else
      echo "[hivemind] no running runtime at pid ${_pid}"
      rm -f "${RUNTIME_PID_FILE}"
    fi
  else
    echo "[hivemind] no runtime pid file found (already stopped?)"
  fi

  # Best-effort cleanup of a leftover --setup-only session (e.g. hivemind was
  # interrupted mid-enrollment and the background setup server never exited).
  if [ -f "${SETUP_PID_FILE}" ]; then
    local _setup_pid
    _setup_pid=$(cat "${SETUP_PID_FILE}" 2>/dev/null || echo '')
    if [ -n "${_setup_pid}" ] && kill -0 "${_setup_pid}" 2>/dev/null; then
      kill "${_setup_pid}" 2>/dev/null || true
    fi
    rm -f "${SETUP_PID_FILE}"
  fi
}

cmd_restart() {
  cmd_stop
  _start_proxy
  echo "[hivemind] restarted"
}

# ── Autostart (impl 3e2c90da, phase A: A1 + A3) ───────────────────────────────
# `hivemind autostart on|off|status` — opt-in, default OFF: nothing here runs
# unless the user (or `install.sh --autostart`) asks. A default install, an
# update and every other command never create an autostart entry.
#
#   systemd --user reachable  → ${XDG_CONFIG_HOME}/systemd/user/hivemind-proxy.service
#                               (oneshot + RemainAfterExit: ExecStart=<this binary> start,
#                               ExecStop=<this binary> stop — `start` detaches the daemon
#                               and returns, the daemon stays in the unit's cgroup; no
#                               Restart= so it never fights `hivemind`'s own auto-heal)
#   no systemd, not WSL       → ${XDG_CONFIG_HOME}/autostart/hivemind-proxy.desktop
#   WSL (either case)         → ALSO a per-user Windows Startup file
#                               (%APPDATA%\...\Startup\hivemind-wsl.cmd): Windows does not
#                               boot the distro at log-on, so this hidden trigger runs
#                               `wsl.exe -d <distro> -u <user> --exec <this binary> autostart
#                               wsl-boot`, which starts the proxy (only when no systemd unit
#                               owns it) and then keeps the distro alive with one
#                               `sleep infinity` (founder 2026-10-05 A-1: per-user keep-alive,
#                               no global .wslconfig change).
# Requires a certificate (a log-on start must never land in interactive
# enrollment). Paths are baked into the unit / Startup file, so a path the
# systemd or cmd/PowerShell quoting cannot carry verbatim is refused.
_AUTOSTART_UNIT="hivemind-proxy.service"
_AUTOSTART_STARTUP_NAME="hivemind-wsl.cmd"
_AUTOSTART_KEEPALIVE_PID="${HOME}/.engram/cache/hivemind-wsl-keepalive.pid"
# A7 refinement: the local record that `autostart on` wrote a Windows Startup
# trigger (one line: its Linux path; mode 600). Lets off/uninstall tell "the
# folder is unresolvable from this shell AND a trigger was written here" (a
# real leftover → failure + manual path) from "never enabled" (a note, rc 0).
# Removed together with the trigger.
_AUTOSTART_WSL_RECORD="${HOME}/.engram/autostart-wsl-startup"

_autostart_unit_path() { printf '%s\n' "${_AUTOSTART_CONFIG_HOME}/systemd/user/${_AUTOSTART_UNIT}"; }
_autostart_desktop_path() { printf '%s\n' "${_AUTOSTART_CONFIG_HOME}/autostart/hivemind-proxy.desktop"; }

_autostart_is_wsl() {
  case "${_AUTOSTART_WSL_OVERRIDE}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  # A6: WSL = a WSL distro name AND Windows interop. Never the kernel release
  # alone: a Linux container on Docker Desktop shares the WSL2 kernel
  # (osrelease says "microsoft") yet has no interop, so the WSL branch (Windows
  # Startup folder via cmd.exe) can only fail there — measured by the install
  # E2E, 2026-10-06. WSLInterop-late is the entry name on newer WSL builds.
  [ -n "${WSL_DISTRO_NAME:-}" ] || return 1
  [ -e "${_WSL_BINFMT_DIR}/WSLInterop" ] && return 0
  [ -e "${_WSL_BINFMT_DIR}/WSLInterop-late" ] && return 0
  command -v cmd.exe > /dev/null 2>&1
}

# A7: "a Windows Startup trigger MAY exist" — wider than _autostart_is_wsl,
# for the paths that REMOVE or LIST it (off / uninstall / status). A shell
# entered through ssh / su / sudo loses WSL_DISTRO_NAME and /mnt/c on PATH, so
# _autostart_is_wsl says no, yet the WSLInterop binfmt entry (system-wide, not
# per-env) still marks a WSL distro whose user may have run `autostart on`. A
# Docker Desktop container has neither (its binfmt_misc is not mounted), so it
# stays out — measured 2026-10-07. The explicit override wins both ways.
_autostart_maybe_wsl() {
  case "${_AUTOSTART_WSL_OVERRIDE}" in
    1) return 0 ;;
    0) return 1 ;;
  esac
  [ -n "${WSL_DISTRO_NAME:-}" ] && return 0
  [ -e "${_WSL_BINFMT_DIR}/WSLInterop" ] || [ -e "${_WSL_BINFMT_DIR}/WSLInterop-late" ]
}

# How to remove the Startup trigger by hand when this shell cannot resolve the
# folder (stderr). The %APPDATA% pattern is the folder `autostart on` writes to.
_autostart_manual_startup_hint() {
  echo "  ! could not resolve the Windows Startup folder from this shell (no WSL interop:" >&2
  echo "    cmd.exe / wslpath unreachable — e.g. an ssh, su or sudo session), so a Windows" >&2
  echo "    Startup trigger may be left behind. Delete it by hand (Windows Explorer):" >&2
  echo "      %APPDATA%\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\${_AUTOSTART_STARTUP_NAME}" >&2
  echo "    from WSL that is usually:" >&2
  echo "      /mnt/c/Users/<your Windows user>/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Startup/${_AUTOSTART_STARTUP_NAME}" >&2
  echo "    or re-run this from a normal WSL terminal (wsl.exe), where the folder resolves." >&2
}

# rc 0 when this user may have a Windows Startup trigger written by
# `autostart on`: the record above, or — for an `on` from before the record
# existed — the unit or the keep-alive pidfile it leaves. Evaluate BEFORE
# _autostart_remove deletes those.
_autostart_wsl_trigger_recorded() {
  [ -f "${_AUTOSTART_WSL_RECORD}" ] || [ -f "$(_autostart_unit_path)" ] || [ -f "${_AUTOSTART_KEEPALIVE_PID}" ]
}

# One-line note for a shell that cannot resolve the Startup folder when no
# trigger was ever recorded here (not a failure).
_autostart_unresolvable_note() {
  echo "  note: Windows Startup folder not resolvable from this shell; no record that autostart on wrote one here — nothing to remove."
}

_autostart_systemd_user() {
  command -v systemctl > /dev/null 2>&1 && systemctl --user show-environment > /dev/null 2>&1
}

# The Windows Startup folder as a Linux path (WSL only). Empty + rc 1 when it
# cannot be resolved (no interop, no cmd.exe on PATH, no wslpath).
_autostart_startup_dir() {
  if [ -n "${_AUTOSTART_STARTUP_OVERRIDE}" ]; then
    printf '%s\n' "${_AUTOSTART_STARTUP_OVERRIDE}"
    return 0
  fi
  command -v cmd.exe > /dev/null 2>&1 && command -v wslpath > /dev/null 2>&1 || return 1
  local _appdata _dir
  # From /mnt/c: cmd.exe refuses a UNC (\\wsl$) working directory.
  _appdata="$(cd /mnt/c 2>/dev/null && timeout 15 cmd.exe /d /c 'echo %APPDATA%' 2>/dev/null | tr -d '\r' | tail -n 1)" || return 1
  case "${_appdata}" in '' | *%*) return 1 ;; esac
  _dir="$(wslpath -u "${_appdata}\\Microsoft\\Windows\\Start Menu\\Programs\\Startup" 2>/dev/null)" || return 1
  [ -n "${_dir}" ] && [ -d "${_dir}" ] || return 1
  printf '%s\n' "${_dir}"
}

# A path baked into a unit / .desktop / .cmd: absolute, and only characters
# none of those quotings treat specially (no quotes, %, $, \, `, newline).
_autostart_safe_path() {
  case "$1" in
    /*) ;;
    *) return 1 ;;
  esac
  [[ "$1" =~ ^[A-Za-z0-9._/+@:,\ -]+$ ]]
}

_autostart_self() { readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s\n' "${BASH_SOURCE[0]}"; }

# PATH for the unit: the dir bun lives in (systemd's default PATH lacks
# ~/.bun/bin) + the standard system dirs, deduplicated, in that order.
_autostart_unit_env_path() {
  local _out="" _d _bun
  _bun="$(command -v bun 2>/dev/null || true)"
  for _d in ${_bun:+"$(dirname "${_bun}")"} /usr/local/sbin /usr/local/bin /usr/sbin /usr/bin /sbin /bin; do
    case ":${_out}:" in *":${_d}:"*) continue ;; esac
    _out="${_out:+${_out}:}${_d}"
  done
  printf '%s\n' "${_out}"
}

_autostart_write() {  # <path> <content> — tmp + mv
  local _tmp
  mkdir -p "$(dirname "$1")" || return 1
  _tmp="$1.tmp-$$"
  printf '%s' "$2" > "${_tmp}" && mv -f "${_tmp}" "$1" || { rm -f "${_tmp}"; return 1; }
}

# _proc_starttime <pid>: field 22 of /proc/<pid>/stat (clock ticks since boot
# at fork — unchanged by exec, so the wsl-boot shell and the `sleep infinity`
# it execs into share it). Parsed after the last ')' — comm may hold spaces.
_proc_starttime() {
  local _st
  _st="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  _st="${_st##*) }"
  set -- ${_st}
  [ "$#" -ge 20 ] || return 1
  printf '%s\n' "${20}"
}

# prints the live keep-alive pid, rc 1 if none. F11: OURS only when the pidfile
# ("<pid> <starttime>", written by _autostart_wsl_boot) matches a live process
# that is `sleep infinity`, owned by this user, with that exact start time — a
# recycled PID, or another user's / another tool's sleep, is never killed.
_autostart_keepalive_pid() {
  local _p _t _line
  [ -f "${_AUTOSTART_KEEPALIVE_PID}" ] || return 1
  _line="$(head -n 1 "${_AUTOSTART_KEEPALIVE_PID}" 2>/dev/null || true)"
  _p="${_line%% *}"; _t="${_line#* }"
  [ "${_t}" != "${_line}" ] || return 1
  case "${_p}" in '' | *[!0-9]*) return 1 ;; esac
  case "${_t}" in '' | *[!0-9]*) return 1 ;; esac
  [ -O "/proc/${_p}" ] || return 1
  [ "$(tr '\0' ' ' < "/proc/${_p}/cmdline" 2>/dev/null)" = "sleep infinity " ] || return 1
  [ "$(_proc_starttime "${_p}" || true)" = "${_t}" ] || return 1
  printf '%s\n' "${_p}"
}

_autostart_on() {
  local _bin _hh _unit _desktop _sdir="" _wsl=0 _systemd=0 _distro="" _user="" _path _content
  if ! _has_cert; then
    echo "Error: no certificate yet — run 'hivemind' first (enrollment), then 'hivemind autostart on'." >&2
    return 1
  fi
  _bin="$(_autostart_self)"
  _hh="$(readlink -m -- "${HIVEMIND_HOME}" 2>/dev/null || printf '%s' "${HIVEMIND_HOME}")"
  for _path in "${_bin}" "${_hh}"; do
    if ! _autostart_safe_path "${_path}"; then
      echo "Error: '${_path}' cannot be written safely into an autostart entry (use a path without quotes, %, \$, \\ or backticks)." >&2
      return 1
    fi
  done
  _autostart_is_wsl && _wsl=1
  _autostart_systemd_user && _systemd=1
  _unit="$(_autostart_unit_path)"
  _desktop="$(_autostart_desktop_path)"

  # Resolve everything that can fail BEFORE writing anything.
  if [ "${_wsl}" = "1" ]; then
    _distro="${WSL_DISTRO_NAME:-}"
    # F11: the account this process really runs as — never $USER, which any
    # caller can set to another name baked into the Windows trigger.
    _user="$(id -un 2>/dev/null || true)"
    if ! [[ "${_distro}" =~ ^[A-Za-z0-9._-]+$ ]] || ! [[ "${_user}" =~ ^[A-Za-z0-9._-]+$ ]]; then
      echo "Error: cannot tell which WSL distro/user to start (WSL_DISTRO_NAME='${_distro}', user='${_user}') — run this from a WSL shell." >&2
      return 1
    fi
    if ! _sdir="$(_autostart_startup_dir)"; then
      echo "Error: the Windows Startup folder could not be resolved from WSL (cmd.exe / wslpath interop) — nothing was written." >&2
      return 1
    fi
  fi

  if [ "${_systemd}" = "1" ]; then
    _content="# HiveMind - written by 'hivemind autostart on'; removed by 'hivemind autostart off' and 'hivemind uninstall'.
[Unit]
Description=HiveMind local mTLS proxy (hivemind start)

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=\"HIVEMIND_HOME=${_hh}\"
Environment=\"PATH=$(_autostart_unit_env_path)\"
ExecStart=\"${_bin}\" start
ExecStop=\"${_bin}\" stop
TimeoutStartSec=180

[Install]
WantedBy=default.target
"
    _autostart_write "${_unit}" "${_content}" || { echo "Error: could not write ${_unit}" >&2; return 1; }
    if ! systemctl --user daemon-reload > /dev/null 2>&1 \
       || ! systemctl --user enable "${_AUTOSTART_UNIT}" > /dev/null 2>&1; then
      rm -f "${_unit}"
      systemctl --user daemon-reload > /dev/null 2>&1 || true
      echo "Error: systemctl --user could not enable ${_AUTOSTART_UNIT} — nothing left enabled." >&2
      return 1
    fi
    echo "  systemd --user unit: ${_unit} (enabled — starts the proxy when your user manager starts)"
    if ! systemctl --user start "${_AUTOSTART_UNIT}" > /dev/null 2>&1; then
      echo "  ! enabled, but starting it now failed — see: systemctl --user status ${_AUTOSTART_UNIT}" >&2
    fi
    if [ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || true)" = "no" ]; then
      echo "  note: lingering is off for your user, so the unit starts at your first log-in session, not at boot" >&2
      echo "        (to start it at boot: loginctl enable-linger $(id -un))." >&2
    fi
  elif [ "${_wsl}" = "1" ]; then
    echo "  no systemd --user in this distro — the Windows Startup trigger starts the proxy itself."
  else
    _content="[Desktop Entry]
Type=Application
Name=HiveMind proxy
Comment=Written by 'hivemind autostart on'; removed by 'hivemind autostart off' and 'hivemind uninstall'.
Exec=env \"HIVEMIND_HOME=${_hh}\" \"${_bin}\" start
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
"
    _autostart_write "${_desktop}" "${_content}" || { echo "Error: could not write ${_desktop}" >&2; return 1; }
    echo "  no systemd --user — XDG autostart entry: ${_desktop} (runs at your desktop log-in)"
  fi

  if [ "${_wsl}" = "1" ]; then
    _content="@echo off
rem HiveMind (WSL distro ${_distro}) - written by 'hivemind autostart on'; removed by 'hivemind autostart off' and 'hivemind uninstall'.
start \"\" /min powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command \"& wsl.exe -d '${_distro}' -u '${_user}' --exec /usr/bin/env 'HIVEMIND_HOME=${_hh}' '${_bin}' autostart wsl-boot\"
"
    _content="${_content//$'\n'/$'\r\n'}"
    if ! _autostart_write "${_sdir}/${_AUTOSTART_STARTUP_NAME}" "${_content}"; then
      echo "Error: could not write ${_sdir}/${_AUTOSTART_STARTUP_NAME} — run 'hivemind autostart off' to undo the rest." >&2
      return 1
    fi
    mkdir -p "$(dirname "${_AUTOSTART_WSL_RECORD}")" \
      && ( umask 077; printf '%s\n' "${_sdir}/${_AUTOSTART_STARTUP_NAME}" > "${_AUTOSTART_WSL_RECORD}" ) \
      && chmod 600 "${_AUTOSTART_WSL_RECORD}" \
      || echo "  ! could not write the local record ${_AUTOSTART_WSL_RECORD} (the trigger itself is in place)" >&2
    echo "  Windows Startup trigger: ${_sdir}/${_AUTOSTART_STARTUP_NAME}"
    echo "    (at Windows log-on it boots WSL distro '${_distro}' hidden, starts the proxy and keeps the distro running)"
  fi
  echo "[hivemind] autostart on. Undo: hivemind autostart off"
  return 0
}

# _autostart_remove <mode>: mode "off" disables the unit but leaves the running
# proxy alone; mode "uninstall" also stops it (disable --now). Prints one
# "removed:" line per artefact; rc 0 always (best-effort, like the uninstall) —
# a file it could not remove is reported through _UNINSTALL_FAILED instead.
_AUTOSTART_REMOVED=0
# _autostart_rm_file <path>: rm + say so; a file left behind is a failure
# (F8: sets _UNINSTALL_FAILED, read by cmd_uninstall / cmd_autostart off).
_autostart_rm_file() {
  if rm -f -- "$1" 2>/dev/null && [ ! -e "$1" ] && [ ! -L "$1" ]; then
    echo "  removed: $1"
    _AUTOSTART_REMOVED=1
  else
    echo "  ! could not remove $1 — delete it by hand" >&2
    _UNINSTALL_FAILED=1
  fi
}

_autostart_remove() {
  local _mode="${1:-off}" _unit _desktop _sdir _p _recorded=0
  _AUTOSTART_REMOVED=0
  _unit="$(_autostart_unit_path)"
  _desktop="$(_autostart_desktop_path)"
  _autostart_wsl_trigger_recorded && _recorded=1
  if [ -f "${_unit}" ] || [ -L "${_unit}" ]; then
    if [ "${_mode}" = "uninstall" ]; then
      systemctl --user disable --now "${_AUTOSTART_UNIT}" > /dev/null 2>&1 || true
    else
      systemctl --user disable "${_AUTOSTART_UNIT}" > /dev/null 2>&1 || true
    fi
    _autostart_rm_file "${_unit}"
    systemctl --user daemon-reload > /dev/null 2>&1 || true
  fi
  if [ -f "${_desktop}" ]; then
    _autostart_rm_file "${_desktop}"
  fi
  if [ -n "${_AUTOSTART_STARTUP_OVERRIDE}" ] || _autostart_maybe_wsl; then
    if _sdir="$(_autostart_startup_dir)"; then
      if [ -f "${_sdir}/${_AUTOSTART_STARTUP_NAME}" ]; then
        _autostart_rm_file "${_sdir}/${_AUTOSTART_STARTUP_NAME}"
      fi
      # The record goes with the trigger — kept while the trigger is still there.
      [ -e "${_sdir}/${_AUTOSTART_STARTUP_NAME}" ] || rm -f "${_AUTOSTART_WSL_RECORD}"
    elif [ "${_recorded}" = "1" ]; then
      # A7 / G2: a trigger written here that we cannot even look for is a
      # failure, not "off". The record stays for a later run from a normal shell.
      _autostart_manual_startup_hint
      _UNINSTALL_FAILED=1
    else
      _autostart_unresolvable_note
    fi
  fi
  if _p="$(_autostart_keepalive_pid)"; then
    kill "${_p}" 2>/dev/null || true
    echo "  stopped: WSL keep-alive (pid ${_p})"
    _AUTOSTART_REMOVED=1
  fi
  rm -f "${_AUTOSTART_KEEPALIVE_PID}"
  return 0
}

# Plan lines for `hivemind uninstall` (listed before anything is removed).
_autostart_plan_lines() {
  local _sdir _p
  _uninstall_list "$(_autostart_unit_path)"
  _uninstall_list "$(_autostart_desktop_path)"
  if [ -n "${_AUTOSTART_STARTUP_OVERRIDE}" ] || _autostart_maybe_wsl; then
    if _sdir="$(_autostart_startup_dir)"; then
      _uninstall_list "${_sdir}/${_AUTOSTART_STARTUP_NAME}"
    elif _autostart_wsl_trigger_recorded; then
      echo "    Windows Startup trigger ${_AUTOSTART_STARTUP_NAME}: folder not resolvable from this shell — cannot be removed here (A7)"
    fi
  fi
  if _p="$(_autostart_keepalive_pid)"; then echo "    WSL keep-alive process (pid ${_p})"; fi
  return 0
}

_autostart_status() {
  local _unit _desktop _sdir _p _on=0 _en _ac
  _unit="$(_autostart_unit_path)"
  _desktop="$(_autostart_desktop_path)"
  echo "HiveMind autostart"
  if [ -f "${_unit}" ]; then
    _en="$(systemctl --user is-enabled "${_AUTOSTART_UNIT}" 2>/dev/null || true)"
    _ac="$(systemctl --user is-active "${_AUTOSTART_UNIT}" 2>/dev/null || true)"
    echo "  systemd --user unit: ${_unit} (${_en:-unknown}, ${_ac:-unknown})"
    [ "${_en}" = "enabled" ] && _on=1
  else
    echo "  systemd --user unit: not installed"
  fi
  if [ -f "${_desktop}" ]; then
    echo "  XDG autostart entry: ${_desktop}"
    _on=1
  fi
  if [ -n "${_AUTOSTART_STARTUP_OVERRIDE}" ] || _autostart_maybe_wsl; then
    if ! _sdir="$(_autostart_startup_dir)"; then
      echo "  Windows Startup trigger: unknown — the Startup folder is not resolvable from this shell (A7)"
    elif [ -f "${_sdir}/${_AUTOSTART_STARTUP_NAME}" ]; then
      echo "  Windows Startup trigger: ${_sdir}/${_AUTOSTART_STARTUP_NAME}"
      _on=1
    else
      echo "  Windows Startup trigger: not installed"
    fi
    if _p="$(_autostart_keepalive_pid)"; then
      echo "  WSL keep-alive: running (pid ${_p})"
    else
      echo "  WSL keep-alive: not running"
    fi
  fi
  if [ "${_on}" = "1" ]; then echo "autostart: on"; else echo "autostart: off"; fi
  return 0
}

# `autostart wsl-boot` — what the Windows Startup trigger runs inside the
# distro (not for interactive use). Starts the proxy unless the systemd unit
# owns it (the distro boot already started it — two concurrent starts would
# race), then becomes the single keep-alive: pidfile + exec `sleep infinity`
# (same PID), so `off` can stop exactly it. A live keep-alive → return at once.
_autostart_wsl_boot() {
  if [ ! -f "$(_autostart_unit_path)" ]; then
    ( cmd_start ) > /dev/null 2>&1 || true
  fi
  _autostart_keepalive_pid > /dev/null && return 0
  mkdir -p "$(dirname "${_AUTOSTART_KEEPALIVE_PID}")"
  echo "$$ $(_proc_starttime "$$" || echo 0)" > "${_AUTOSTART_KEEPALIVE_PID}"
  exec sleep infinity
}

cmd_autostart() {
  case "${1:-}" in
    on)       _autostart_on ;;
    off)
      _UNINSTALL_FAILED=0
      _autostart_remove off
      if [ "${_UNINSTALL_FAILED}" = "1" ]; then
        # G2: a trigger left behind is a failure, never "already off".
        echo "[hivemind] autostart off FAILED: an autostart trigger could not be removed or checked (see the '!' lines above) — autostart may still be on. Delete it by hand, then check: hivemind autostart status" >&2
        return 1
      elif [ "${_AUTOSTART_REMOVED}" = "1" ]; then
        echo "[hivemind] autostart off (a running proxy keeps running; 'hivemind stop' stops it)."
      else
        echo "[hivemind] autostart is already off — nothing to remove."
      fi ;;
    status)   _autostart_status ;;
    wsl-boot) _autostart_wsl_boot ;;
    *)
      echo "Usage: hivemind autostart on|off|status" >&2
      return 1 ;;
  esac
}

# ── Update mechanism (item 4.4) ───────────────────────────────────────────────
# Pull-agent for the thin client: bin/hivemind + runtime/src/* ONLY — prompts/
# seeds are never touched here (they live server-side).
# Hardened (silent auto-pull): pinned source, integrity check,
# staged+atomic swap, last-known-good rollback.

# _verify_commit_integrity: 0 = trusted, 1 = refuse to apply.
# Two paths, either sufficient: (a) valid GPG signature via `git verify-commit`
# from a signer git already trusts; (b) commit hash matches a LATEST_SHA
# manifest published on a channel separate from git itself (the product HTTPS
# domain, not the repo host) — fallback for when no signer is configured.
# The manifest endpoint (https://<host>/hivemind/LATEST_SHA) is LIVE — it is
# kept equal to the dist main HEAD by a pull timer on each box (silken-ops manifest-cd), so the (b)
# path resolves normally. If the fetch fails (endpoint unreachable / empty),
# this still fails closed for unsigned commits, which is the correct fail-safe
# default (spec: "se a verificação falhar → NÃO aplica"), not a bug.
_verify_commit_integrity() {
  local _dir="$1"
  if git -C "${_dir}" verify-commit HEAD > /dev/null 2>&1; then
    return 0
  fi
  local _host="${HIVEMIND_ENDPOINT%%:*}"
  local _manifest_url="https://${_host}/hivemind/LATEST_SHA"
  local _expected_sha
  _expected_sha="$(curl -sf --max-time 5 "${_manifest_url}" 2>/dev/null | tr -d '[:space:]')"
  [ -n "${_expected_sha}" ] || return 1
  local _actual_sha
  _actual_sha="$(git -C "${_dir}" rev-parse HEAD)"
  [ "${_actual_sha}" = "${_expected_sha}" ]
}

# _stage_build: mirrors install.sh's $HIVEMIND_HOME-scoped copy step (CLAUDE.md,
# .claude/settings.json, runtime/ + bun install) into a STAGING dir — never
# touches the live $HIVEMIND_HOME. Deliberately does NOT reinstall the CLI
# binary to PATH (that's handled separately, see _update_installed_binary) and
# does NOT run install.sh's dependency/PATH checks or smoke test (those are
# first-install concerns, not update concerns).
#
# Two-tier copy (code-review fix, post-5.1/5.2/5.3 — replaces a cherry-pick
# allowlist that was a BLOCKER): (1) GIT-MANAGED paths — CLAUDE.md, settings.json,
# commands/, runtime/ — the NEW version from HIVEMIND_SOURCE_DIR always wins;
# (2) RUNTIME-WRITTEN state — everything Claude Code / the enrollment flow
# writes into $HIVEMIND_HOME at runtime (NOT sourced from git: .env,
# .claude/.claude.json [mcpServers.engram, item 5.1], .claude/.credentials.json
# [item 5.0], plus whatever Claude Code writes next — history.jsonl, sessions/,
# projects/, shell-snapshots/, caches, none of it enumerable up front) — the
# LIVE state always wins. A fixed allowlist (the previous version of this
# function only preserved .env + .credentials.json) silently drops every other
# runtime-written file on the first 'hivemind update' — this is exactly what
# broke the item 5.1 MCP fix (.claude.json is written by the ENROLLMENT
# handler at runtime, not by git, so it was never in the allowlist and got
# wiped by the staging mv). Inverting the pattern to "preserve everything,
# except what git explicitly owns" closes that class of regression instead of
# cherry-picking the next file that turns out to matter.
#
# COMPONENT-AWARE (impl 3e2c90da, phase S3): a proxy-only install (marker
# "proxy") is staged by _stage_build_proxy_only instead — no harness file is
# ever (re)shipped to it. Every other install — marker "proxy harness" or NO
# marker (legacy, pre-split) — runs the steps below EXACTLY as before; the
# only addition is carrying an existing marker into staging (Tier 2). The
# staged tree of a legacy install is byte-identical to origin/main's
# (hivemind-split.test.ts).
_stage_build() {
  local _target="$1"
  if ! _has_harness; then
    _stage_build_proxy_only "${_target}"
    return $?
  fi
  mkdir -p "${_target}/.claude" "${_target}/.claude/hooks" "${_target}/bin" "${_target}/runtime" || return 1

  # ── Tier 1: git-managed — NEW version wins ────────────────────────────────
  # CLAUDE.md lands under .claude/ — mirrors install.sh's item 5.2 fix
  # (load-bearing: forgetting this side regresses the pull-agent silently).
  cp "${HIVEMIND_SOURCE_DIR}/CLAUDE.md" "${_target}/.claude/CLAUDE.md" || return 1
  # settings.json is TEMPLATED (F5.3), same as install.sh — __HIVEMIND_HOME__
  # resolves against the LIVE HIVEMIND_HOME (this update targets the same
  # install, not a fresh one), not the staging dir itself.
  sed "s|__HIVEMIND_HOME__|${HIVEMIND_HOME}|g" \
    "${HIVEMIND_SOURCE_DIR}/.claude/settings.json" > "${_target}/.claude/settings.json" || return 1
  # Product slash-commands (item 5.3) — same mirror requirement as above.
  # These are THIN STUBS (Branch B, decision_serve-boot-and-end-session-as-mcp-prompts-fail-closed):
  # the canonical procedure body is served by the engram (fos_procedure({id})) and fetched at
  # invocation, FAIL-CLOSED (engram unreachable → no local fallback, session does not
  # boot/close). This copy step only ships the stub files, not the procedure content — see
  # CLAUDE.md § Session start / § Session close.
  mkdir -p "${_target}/.claude/commands" || return 1
  cp -r "${HIVEMIND_SOURCE_DIR}/.claude/commands/." "${_target}/.claude/commands/" || return 1
  # Status-CLI (F5.1) + quota-capture hook (F5.2) — referenced by the
  # templated settings.json above; must ship alongside it on every update.
  cp "${HIVEMIND_SOURCE_DIR}/bin/hivemind-statusline.py" "${_target}/bin/hivemind-statusline.py" || return 1
  chmod +x "${_target}/bin/hivemind-statusline.py" || return 1
  # Copy the WHOLE hooks dir (the class), never a per-file allowlist. A forgotten
  # entry here is exactly what stripped stop.sweep-wip-md.mjs on update while the
  # freshly-templated settings.json still registered it → ERR_MODULE_NOT_FOUND at
  # the Stop event. settings.json (Tier 1, above) is the single source of which
  # hooks are registered; ship all of them so it can never dangle. Same
  # "preserve the class, not an allowlist" lesson as the Tier-2 runtime-state copy.
  cp -r "${HIVEMIND_SOURCE_DIR}/.claude/hooks/." "${_target}/.claude/hooks/" || return 1
  rsync -a --exclude='node_modules/' --exclude='bun.lock' \
    "${HIVEMIND_SOURCE_DIR}/runtime/" "${_target}/runtime/" 2>/dev/null \
    || cp -r "${HIVEMIND_SOURCE_DIR}/runtime/." "${_target}/runtime/" || return 1
  (cd "${_target}/runtime" && bun install --production --silent 2>/dev/null || bun install --production) || return 1

  # ── Tier 2: runtime-written — LIVE state wins ─────────────────────────────
  # Preserve the LIVE .env (cert paths, endpoint, update pinning) — the staged
  # build must boot with the same identity/config as the current one, not a
  # fresh/empty one.
  if [ -f "${HIVEMIND_HOME}/.env" ]; then
    cp "${HIVEMIND_HOME}/.env" "${_target}/.env" || return 1
  fi
  # Component marker (phase S3): carried as-is when present; never invented
  # for a legacy install (absent marker = proxy+harness, unchanged).
  if [ -f "$(_components_file)" ]; then
    cp "$(_components_file)" "${_target}/.components" || return 1
  fi
  # Merge the ENTIRE live .claude/ dir over the staged one, EXCLUDING exactly
  # the 4 git-managed paths already placed above (anchored to the transfer
  # root with a leading '/' so a same-named file/dir nested deeper — e.g. under
  # sessions/ or projects/ — is never accidentally excluded). No --delete: this
  # only ADDS/overwrites from live into staging, it never removes a
  # freshly-placed git file. Covers .claude.json (item 5.1) + .credentials.json
  # (item 5.0) + anything else Claude Code writes there, present or future.
  # /hooks/ added at F5.2 (quota-capture hook is git-managed like
  # CLAUDE.md/settings.json/commands/, not runtime-written).
  if [ -d "${HIVEMIND_HOME}/.claude" ]; then
    rsync -a \
      --exclude='/CLAUDE.md' \
      --exclude='/settings.json' \
      --exclude='/commands/' \
      --exclude='/hooks/' \
      "${HIVEMIND_HOME}/.claude/" "${_target}/.claude/" || return 1
  fi
  return 0
}

# _stage_build_proxy_only: the proxy-only counterpart of _stage_build. Tier 1
# ships ONLY runtime/ (+ bun install) — no CLAUDE.md, settings.json,
# commands/, hooks/ or statusline. Tier 2 carries the live .env, the marker
# and, only if it exists, the live .claude/ as-is (e.g. the .claude.json the
# enrollment writes) — it keeps user state and adds nothing.
_stage_build_proxy_only() {
  local _target="$1"
  mkdir -p "${_target}/runtime" || return 1
  rsync -a --exclude='node_modules/' --exclude='bun.lock' \
    "${HIVEMIND_SOURCE_DIR}/runtime/" "${_target}/runtime/" 2>/dev/null \
    || cp -r "${HIVEMIND_SOURCE_DIR}/runtime/." "${_target}/runtime/" || return 1
  (cd "${_target}/runtime" && bun install --production --silent 2>/dev/null || bun install --production) || return 1
  if [ -f "${HIVEMIND_HOME}/.env" ]; then
    cp "${HIVEMIND_HOME}/.env" "${_target}/.env" || return 1
  fi
  cp "$(_components_file)" "${_target}/.components" || return 1
  if [ -d "${HIVEMIND_HOME}/.claude" ]; then
    mkdir -p "${_target}/.claude" || return 1
    rsync -a "${HIVEMIND_HOME}/.claude/" "${_target}/.claude/" || return 1
  fi
  return 0
}

# _all_installed_bins: every executable `hivemind` found across $PATH, not
# just the first `command -v` match. A shadowed older copy earlier on PATH
# than the "real"/newer one can otherwise stay invoked forever while
# `hivemind update` reports success against a DIFFERENT, later-on-PATH copy
# it silently never touches (measured on this dev machine, 2026-08-07:
# ~/.local/bin/hivemind observed ~2 days stale while a newer copy existed
# elsewhere on PATH). De-duplicated (`sort -u`) since the same directory can
# legitimately appear more than once in $PATH.
_all_installed_bins() {
  local _d
  IFS=: read -ra _dirs <<< "${PATH}"
  for _d in "${_dirs[@]}"; do
    [ -n "${_d}" ] && [ -x "${_d}/hivemind" ] && printf '%s\n' "${_d}/hivemind"
  done | sort -u
}

# _update_installed_binary / _rollback_installed_binary: the system-PATH
# copy(ies) of bin/hivemind are outside $HIVEMIND_HOME, so each needs its own
# (small, already-atomic) swap — cp-to-temp + rename, mirroring the staging
# pattern at a smaller scale. Best-effort per-binary: an unwritable path is
# skipped, not fatal (not fatal overall — the $HIVEMIND_HOME swap is the
# load-bearing part). Every distinct match on PATH is updated, not just the
# first; if more than one distinct binary is found, warn once naming all of
# them so the user can clean up the shadow instead of having it silently
# patched forever.
_update_installed_binary() {
  local _bins _installed_bin _count=0 _updated=0
  _bins="$(_all_installed_bins)"
  [ -n "${_bins}" ] || return 0

  _count="$(printf '%s\n' "${_bins}" | wc -l)"
  if [ "${_count}" -gt 1 ]; then
    echo "Aviso: ${_count} binários 'hivemind' encontrados no PATH — atualizando todos:" >&2
    printf '%s\n' "${_bins}" | while IFS= read -r _b; do echo "  - ${_b}" >&2; done
  fi

  while IFS= read -r _installed_bin; do
    [ -n "${_installed_bin}" ] || continue
    # Writability of the file itself isn't enough — the load-bearing ops
    # below (cp …last-good, mv …new→bin) need to create/replace directory
    # entries, which requires write access to the containing directory.
    [ -w "${_installed_bin}" ] || continue
    [ -w "$(dirname "${_installed_bin}")" ] || continue
    cp "${_installed_bin}" "${_installed_bin}.last-good" 2>/dev/null || true
    if cp "${HIVEMIND_SOURCE_DIR}/bin/hivemind" "${_installed_bin}.new"; then
      chmod +x "${_installed_bin}.new"
      mv "${_installed_bin}.new" "${_installed_bin}"
      _updated=$((_updated + 1))
    else
      # Failed cp may still have left a partial/orphan .new behind — clean up.
      rm -f "${_installed_bin}.new"
    fi
  done <<< "${_bins}"
  [ "${_updated}" -gt 0 ] || return 1
  return 0
}
_rollback_installed_binary() {
  local _bins _installed_bin
  _bins="$(_all_installed_bins)"
  [ -n "${_bins}" ] || return 0
  while IFS= read -r _installed_bin; do
    [ -n "${_installed_bin}" ] || continue
    if [ -f "${_installed_bin}.last-good" ]; then
      mv "${_installed_bin}.last-good" "${_installed_bin}"
    fi
  done <<< "${_bins}"
}

cmd_update() {
  # D1: a dev / legacy source is moved to the managed clone first (fail-open).
  # D1b: only an EXPLICIT `hivemind update` bypasses the 24h clone backoff —
  # the silent on-launch auto-update (_maybe_auto_update → cmd_update) obeys it.
  if [ "${_HM_EXPLICIT_UPDATE:-0}" = "1" ]; then
    _maybe_migrate_source --force || true
  else
    _maybe_migrate_source || true
  fi
  if [ -z "${HIVEMIND_SOURCE_DIR:-}" ] || [ ! -d "${HIVEMIND_SOURCE_DIR}/.git" ]; then
    echo "Error: HIVEMIND_SOURCE_DIR not set or not a git clone — re-run install.sh to pin the update source." >&2
    exit 1
  fi
  # F4/G1: never `reset --hard` a source that holds local work (a dev-shaped
  # clone that is not the managed one, uncommitted tracked changes, or a git
  # query that fails). Checked BEFORE the fetch: a refused source is not written.
  local _why
  if _why="$(_update_source_unsafe "${HIVEMIND_SOURCE_DIR}")"; then
    _update_refuse "${_why}"
  fi

  local _branch="${HIVEMIND_UPDATE_BRANCH:-main}"

  # Source pinning guard (requirement 1): refuse if origin drifted from what
  # was recorded at install time — evicts a silent remote/DNS swap.
  local _current_remote
  _current_remote="$(git -C "${HIVEMIND_SOURCE_DIR}" remote get-url origin 2>/dev/null || echo '')"
  if [ -n "${HIVEMIND_UPDATE_REMOTE:-}" ] && [ "${_current_remote}" != "${HIVEMIND_UPDATE_REMOTE}" ]; then
    echo "Error: origin remote changed since install (pinned: ${HIVEMIND_UPDATE_REMOTE}, current: ${_current_remote}) — refusing to update." >&2
    exit 1
  fi

  echo "Checking ${_branch} for updates..."
  if ! git -C "${HIVEMIND_SOURCE_DIR}" fetch --quiet origin "${_branch}"; then
    echo "Error: fetch failed (network?) — staying on current version." >&2
    exit 1
  fi

  local _before _after
  _before="$(git -C "${HIVEMIND_SOURCE_DIR}" rev-parse HEAD)"
  _after="$(git -C "${HIVEMIND_SOURCE_DIR}" rev-parse "origin/${_branch}")"

  if [ "${_before}" = "${_after}" ]; then
    echo "Already up to date (${_before:0:12})."
    return 0
  fi

  # G1: AFTER the fetch, BEFORE any reset — the whole predicate again, now with
  # the fetched ref: HEAD must be reachable from origin/<branch> (no local
  # commit is ever dropped). Every reset below (this one and the rollbacks to
  # ${_before}) runs only on a source that passed here: clean, fast-forwardable.
  if _why="$(_update_source_unsafe "${HIVEMIND_SOURCE_DIR}" "origin/${_branch}")"; then
    _update_refuse "${_why}"
  fi
  exec 3>&-   # the auto-update's log fd is not inherited by the restarted daemon

  if ! git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "origin/${_branch}" > /dev/null 2>&1; then
    echo "Error: could not reset clone to origin/${_branch} — resolve manually." >&2
    exit 1
  fi

  # Requirement 2: integrity check. Fail-safe — on failure, revert the clone
  # to the pre-fetch commit and do NOT touch $HIVEMIND_HOME.
  if ! _verify_commit_integrity "${HIVEMIND_SOURCE_DIR}"; then
    echo "Error: integrity check FAILED for ${_after:0:12} — not applying, reverting clone to ${_before:0:12}." >&2
    git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "${_before}" > /dev/null 2>&1 || true
    exit 1
  fi

  echo "Verified ${_after:0:12} — staging..."

  # Requirement 3: apply atomically via a staging dir + rename swap (never
  # copy-in-place onto the live $HIVEMIND_HOME).
  local _staging="${HIVEMIND_HOME}.staging"
  local _lastgood="${HIVEMIND_HOME}.last-good"
  rm -rf "${_staging}"

  if ! _stage_build "${_staging}"; then
    echo "Error: staging build failed — current installation untouched." >&2
    rm -rf "${_staging}"
    git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "${_before}" > /dev/null 2>&1 || true
    exit 1
  fi

  echo "Staged — swapping in (atomic)..."
  cmd_stop > /dev/null 2>&1 || true
  rm -rf "${_lastgood}"
  # NOTE (deferred, not this pass — team-lead review): each `mv` below is
  # atomic on its own, but the two together are not a single atomic step —
  # there's a small window between them where $HIVEMIND_HOME doesn't exist at
  # all. Acceptable for now (auto-update is inert without a signer/manifest,
  # see _verify_commit_integrity); will be hardened alongside the signing
  # infra before update goes live. Manual recovery in the meantime: if a crash
  # lands here, restore from "${HIVEMIND_HOME}.last-good" (or re-run
  # install.sh from "${HIVEMIND_HOME}.staging" if last-good is also absent).
  if [ -d "${HIVEMIND_HOME}" ]; then
    mv "${HIVEMIND_HOME}" "${_lastgood}"
  fi
  mv "${_staging}" "${HIVEMIND_HOME}"
  # Best-effort: a failed binary swap here must NOT abort under set -e — the
  # $HIVEMIND_HOME swap already happened, and the health-check/rollback below
  # (requirement 4) still needs to run regardless of this side-swap's outcome.
  _update_installed_binary || true

  # Requirement 4: last-known-good + automatic rollback on a failed
  # post-update health check. _start_proxy exits(1) directly on its own
  # start-up failure (pre-existing behavior, relied on by cmd_start/cmd_open)
  # — run it in a SUBSHELL here so that exit only ends the subshell, not this
  # whole update, letting the rollback logic below actually run.
  ( _start_proxy ) || true
  _check_health

  if [ "${_HEALTH_SEVERITY}" -ge 2 ]; then
    echo "Error: post-update health check FAILED — rolling back to ${_before:0:12}." >&2
    cmd_stop > /dev/null 2>&1 || true
    rm -rf "${HIVEMIND_HOME}"
    mv "${_lastgood}" "${HIVEMIND_HOME}"
    git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "${_before}" > /dev/null 2>&1 || true
    _rollback_installed_binary
    ( _start_proxy ) || true
    echo "Rolled back — running ${_before:0:12}." >&2
    exit 1
  fi

  echo "$(_ok "Updated"): ${_before:0:12} -> ${_after:0:12}."
}

# _maybe_auto_update: silent on-launch check (OPEN-6, founder-approved).
# Best-effort + fail-open on ANY network/config hiccup — never blocks startup.
# Short timeout (~2s) on the remote check only; the actual update (if one
# applies) reuses cmd_update's hardened staged/atomic/rollback path.
_maybe_auto_update() {
  [ -n "${HIVEMIND_SOURCE_DIR:-}" ] || return 0
  [ -d "${HIVEMIND_SOURCE_DIR}/.git" ] || return 0
  # F4/G1: a source holding local work is never updated — skip silently
  # (logged under --verbose), the launch goes on. cmd_update re-checks after
  # its fetch (unpushed commits); that refusal reaches --verbose via fd 3.
  local _why
  if _why="$(_update_source_unsafe "${HIVEMIND_SOURCE_DIR}")"; then
    _vecho "[hivemind] auto-update skipped: ${HIVEMIND_SOURCE_DIR}: ${_why} — never reset --hard"
    return 0
  fi
  # BLOCKER FIX: `timeout` is not present on stock macOS (only via brew
  # coreutils). Without this guard, the `$(timeout ...)` command substitution
  # below fails with 127, and — being a variable assignment — set -e ABORTS
  # THE WHOLE SCRIPT right here, killing the default `hivemind`/`hivemind
  # <slug>` path before _start_proxy/exec claude ever run. Degrade instead:
  # no `timeout` → skip the silent auto-update, continue booting normally.
  command -v timeout > /dev/null 2>&1 || return 0

  local _branch="${HIVEMIND_UPDATE_BRANCH:-main}"
  local _remote_head
  # `|| true` is LOAD-BEARING: under `set -euo pipefail`, if `timeout` fires
  # (git ls-remote exceeds the limit) the command substitution exits non-zero
  # and — being a bare assignment — set -e would ABORT the whole script right
  # here, BEFORE the fail-open guard below ever runs (crash instead of degrade).
  # Timeout raised 2s->5s so a normal (~2s) remote check actually completes
  # instead of intermittently tripping the limit and skipping the update.
  _remote_head="$(timeout 5 git -C "${HIVEMIND_SOURCE_DIR}" ls-remote origin "refs/heads/${_branch}" 2>/dev/null | cut -f1)" || true
  [ -n "${_remote_head}" ] || return 0   # offline/timeout — fail-open, continue as-is

  local _local_head
  _local_head="$(git -C "${HIVEMIND_SOURCE_DIR}" rev-parse HEAD 2>/dev/null || echo '')"
  [ "${_remote_head}" != "${_local_head}" ] || return 0   # already current

  # cmd_update calls exit(1) directly on several failure paths — run it in a
  # SUBSHELL so a failed silent update can never take the whole launch down
  # with it (same reasoning as the _start_proxy wrapping inside cmd_update).
  ( _HM_AUTO_UPDATE=1; cmd_update ) 3>&2 > /dev/null 2>&1 || true
  return 0
}

# ── Managed update source (impl 3e2c90da, item D1) ───────────────────────────
# Every install updates from ${HIVEMIND_HOME}.src — a clone of the canonical
# remote (_CANONICAL_REMOTE) that only this CLI writes. An install whose
# HIVEMIND_SOURCE_DIR is still a dev / legacy clone (one that tracks .github/,
# which the dist repo never does) is moved there ONCE, before the on-launch
# auto-update and at the top of `hivemind update`: cmd_update runs
# `reset --hard` on the source, so on a developer's own tree it would rewrite
# their work.
#
# Invariants: the OLD clone is only READ (rev-parse, ls-files) — never cd'ed
# into, fetched, reset or deleted. Fail-open: any failure leaves the .env keys
# as they were, removes the half-made tmp clone, logs (--verbose) and the
# launch goes on exactly as before. An existing ${HIVEMIND_HOME}.src is reused
# only when it is a clone of the canonical remote; anything else at that path
# is left alone. .env: backed up once to ~/.engram/env.pre-managed-source (0600), rewritten
# atomically (tmp with the same mode + rename), only HIVEMIND_SOURCE_DIR /
# HIVEMIND_UPDATE_REMOTE / HIVEMIND_UPDATE_BRANCH change.
_managed_source_dir() { printf '%s\n' "${HIVEMIND_HOME}.src"; }

# _is_managed_clone <dir>: 0 = a real dir (not a symlink) holding a git clone
# whose origin is the canonical remote.
_is_managed_clone() {
  [ ! -L "$1" ] && [ -d "$1/.git" ] || return 1
  [ "$(git -C "$1" remote get-url origin 2>/dev/null || true)" = "${_CANONICAL_REMOTE}" ]
}

# F4/G1 — update integrity. INVARIANT: an update never discards local work in
# HIVEMIND_SOURCE_DIR. cmd_update runs `reset --hard` on its source, so it runs
# only on a source that is, by CONTENT:
#   (a) clean — `git status --porcelain --untracked-files=no` is empty (staged
#       or unstaged changes to tracked files, a staged `git rm`, all refuse);
#   (b) fast-forwardable — HEAD is reachable from the fetched origin/<branch>
#       (a local commit, another branch, an orphan history, all refuse);
#       checked only when <ref> is given (after the fetch);
#   (c) answerable — any git query here that fails refuses (fail CLOSED).
# Plus the shape signal: a DEV-shaped source (tracks .github/ — a dist clone
# never does) that is not the managed clone refuses, whatever made the move
# skip (24h backoff, a foreign .src, an unwritable .env, no timeout(1),
# offline). Nothing is exempt: the managed clone and dist clones pass only
# because they are clean and fast-forwardable. Read-only: ls-files, rev-parse,
# merge-base and `status` with --no-optional-locks (no index refresh written).
# _update_source_unsafe <dir> [<ref>]: 0 + prints the reason = refuse; 1 = safe.
_update_source_unsafe() {
  local _d="$1" _ref="${2:-}" _rc=0 _out
  git -C "${_d}" ls-files --error-unmatch .github > /dev/null 2>&1 || _rc=$?
  case "${_rc}" in
    0)
      if [ "$(_uninstall_norm "${_d}")" != "$(_uninstall_norm "$(_managed_source_dir)")" ] || ! _is_managed_clone "${_d}"; then
        echo "it is a development clone (it tracks .github/) and not the managed update source $(_managed_source_dir)"
        return 0
      fi ;;
    1) ;;
    *) echo "a git query on it failed (git ls-files, exit ${_rc}) — cannot prove it holds no local work"; return 0 ;;
  esac
  _rc=0
  git -C "${_d}" rev-parse --verify -q HEAD > /dev/null 2>&1 || _rc=$?
  if [ "${_rc}" -ne 0 ]; then
    echo "a git query on it failed (git rev-parse HEAD, exit ${_rc}) — cannot prove it holds no local work"; return 0
  fi
  _rc=0
  _out="$(git --no-optional-locks -C "${_d}" status --porcelain --untracked-files=no 2>/dev/null)" || _rc=$?
  if [ "${_rc}" -ne 0 ]; then
    echo "a git query on it failed (git status, exit ${_rc}) — cannot prove it holds no local work"; return 0
  fi
  if [ -n "${_out}" ]; then
    echo "it has uncommitted changes to tracked files"; return 0
  fi
  if [ -n "${_ref}" ]; then
    _rc=0
    git -C "${_d}" merge-base --is-ancestor HEAD "${_ref}" > /dev/null 2>&1 || _rc=$?
    case "${_rc}" in
      0) ;;
      1) echo "its HEAD has commits that are not on ${_ref} (local or unpushed work)"; return 0 ;;
      *) echo "a git query on it failed (git merge-base, exit ${_rc}) — cannot prove it holds no local work"; return 0 ;;
    esac
  fi
  return 1
}

# _update_refuse <reason>: explicit `hivemind update` → stderr + exit 1; the
# silent on-launch update → one line under --verbose (on fd 3, the launcher's
# stderr — cmd_update's own output is discarded there), exit 1 (subshell).
_update_refuse() {
  if [ "${_HM_AUTO_UPDATE:-0}" = "1" ]; then
    { _vecho "[hivemind] auto-update skipped: ${HIVEMIND_SOURCE_DIR}: $1 — never reset --hard"; } 2>&3 || true
    exit 1
  fi
  local _hint="Commit and push (or stash) that work, or point HIVEMIND_SOURCE_DIR at a clean clone, then run 'hivemind update' again."
  case "$1" in
    *"development clone"*) _hint="The source moves to the managed clone on its own once the canonical remote is reachable (re-run with --verbose to see why the move was skipped)." ;;
  esac
  echo "Error: refusing to update — ${HIVEMIND_SOURCE_DIR}: $1. An update runs 'git reset --hard' on its source and would discard that work. Nothing was changed. ${_hint}" >&2
  exit 1
}

# D1b — retry backoff. An install whose canonical remote is unreachable
# (offline, github.com blocked) would otherwise pay the 30s clone timeout on
# EVERY launch. The network clone is attempted at most once per 24h: the
# marker ~/.engram/src-migrate-last-attempt holds the epoch seconds of
# the last attempt (content, not mtime — no stat(1) GNU/BSD split). A marker
# that is unreadable, not a number or in the future does not block. An
# explicit `hivemind update` (_maybe_migrate_source --force) always attempts.
# A completed move removes the marker. Reusing an existing managed clone is
# not a network step and is never gated.
_SRC_MIGRATE_BACKOFF_SECS=86400
# F5: the marker and the .env backup live in ~/.engram, OUTSIDE $HIVEMIND_HOME —
# an update's staged swap replaces $HIVEMIND_HOME wholesale (_stage_build
# carries only .env / .components / harness files), so anything kept inside it
# was lost on the first update after the move. ~/.engram is never touched by an
# update (DR-6.1) and goes away with `uninstall` (also under --keep-certs, which
# keeps only mtls/, device-id*, kept-credentials.env).
_src_migrate_marker() { printf '%s\n' "${HOME}/.engram/src-migrate-last-attempt"; }
_src_migrate_env_backup() { printf '%s\n' "${HOME}/.engram/env.pre-managed-source"; }

# _src_migrate_backoff_active: 0 = a clone was attempted < 24h ago → skip.
_src_migrate_backoff_active() {
  local _m _t _now
  _m="$(_src_migrate_marker)"
  [ -f "${_m}" ] || return 1
  _t="$(head -n 1 "${_m}" 2>/dev/null | tr -d '[:space:]' || true)"
  case "${_t}" in ''|*[!0-9]*) return 1 ;; esac
  _now="$(date +%s 2>/dev/null || true)"
  case "${_now}" in ''|*[!0-9]*) return 1 ;; esac
  [ "${_t}" -le "${_now}" ] || return 1
  [ $((_now - _t)) -lt "${_SRC_MIGRATE_BACKOFF_SECS}" ]
}

# _mv_dir_exclusive <src> <dst>: rename the directory <src> to <dst>; fails —
# never moving <src> INTO <dst> — when <dst> already exists. GNU `mv -T` is one
# rename(2), which refuses an existing non-empty target. Without -T (BSD/macOS
# mv): exists-check + mv, and a nesting that slipped through the check window
# is taken back out (rc 1).
_mv_dir_exclusive() {
  local _src="$1" _dst="$2"
  mv -T -- "${_src}" "${_dst}" 2>/dev/null && return 0
  { [ -e "${_dst}" ] || [ -L "${_dst}" ]; } && return 1
  mv -- "${_src}" "${_dst}" 2>/dev/null || return 1
  if [ -e "${_dst}/$(basename -- "${_src}")" ]; then
    rm -rf -- "${_dst:?}/$(basename -- "${_src}")" 2>/dev/null || true
    return 1
  fi
  return 0
}

_maybe_migrate_source() {
  local _force=0
  [ "${1:-}" = "--force" ] && _force=1
  local _src="${HIVEMIND_SOURCE_DIR:-}" _dst _tmp _old_head _env _bak _envtmp
  [ -n "${_src}" ] && [ -d "${_src}/.git" ] || return 0
  _dst="$(_managed_source_dir)"
  [ "$(_uninstall_norm "${_src}")" != "$(_uninstall_norm "${_dst}")" ] || return 0
  # Dev / legacy clone predicate — read-only (no index refresh, no write).
  git -C "${_src}" ls-files --error-unmatch .github > /dev/null 2>&1 || return 0

  _env="${HIVEMIND_HOME}/.env"
  if [ ! -f "${_env}" ] || [ ! -w "${_env}" ]; then
    _vecho "[hivemind] source move skipped: ${_env} missing or not writable"; return 0
  fi
  # Same degrade as _maybe_auto_update: no timeout(1) → no network step.
  command -v timeout > /dev/null 2>&1 || { _vecho "[hivemind] source move skipped: no timeout(1)"; return 0; }
  _old_head="$(git -C "${_src}" rev-parse --verify -q HEAD 2>/dev/null || true)"

  if [ -e "${_dst}" ] || [ -L "${_dst}" ]; then
    if ! _is_managed_clone "${_dst}"; then
      _vecho "[hivemind] source move skipped: ${_dst} exists and is not a clone of the canonical remote — left as is"
      return 0
    fi
  else
    if [ "${_force}" -ne 1 ] && _src_migrate_backoff_active; then
      _vecho "[hivemind] source move skipped: last clone attempt < 24h ago (run 'hivemind update' to retry now)"; return 0
    fi
    # Stamp BEFORE the network step: a launch killed mid-clone still backs off.
    mkdir -p -m 700 "${HOME}/.engram" 2>/dev/null || true
    date +%s > "$(_src_migrate_marker)" 2>/dev/null || true
    _tmp="${_dst}.tmp.$$"
    rm -rf -- "${_tmp}" 2>/dev/null || true
    if ! GIT_TERMINAL_PROMPT=0 timeout 30 git clone --quiet "${_CANONICAL_REMOTE}" "${_tmp}" > /dev/null 2>&1; then
      rm -rf -- "${_tmp}" 2>/dev/null || true
      _vecho "[hivemind] source move skipped: clone of the canonical remote failed (offline?)"; return 0
    fi
    # Start the managed clone at the INSTALLED commit when the canonical
    # history has it — so the next update really stages the new tree instead
    # of no-op'ing on a clone already at the remote head.
    if [ -n "${_old_head}" ] && git -C "${_tmp}" cat-file -e "${_old_head}^{commit}" 2>/dev/null; then
      if ! git -C "${_tmp}" reset --quiet --hard "${_old_head}" > /dev/null 2>&1; then
        rm -rf -- "${_tmp}" 2>/dev/null || true
        _vecho "[hivemind] source move skipped: could not check out the installed commit"; return 0
      fi
    fi
    # F6: two launches may race here. Never nest one clone inside the other:
    # the loser drops its temp clone and reuses the winner's (if it is valid).
    if ! _mv_dir_exclusive "${_tmp}" "${_dst}"; then
      rm -rf -- "${_tmp}" 2>/dev/null || true
      if ! _is_managed_clone "${_dst}"; then
        _vecho "[hivemind] source move skipped: could not place ${_dst}"; return 0
      fi
      _vecho "[hivemind] ${_dst} was placed by a concurrent launch — reusing it"
    fi
  fi

  # The backup holds FOS_API_KEY: created user-only (umask 077 + chmod 600),
  # in ~/.engram (F5 — survives every later update).
  _bak="$(_src_migrate_env_backup)"
  # G3: `! -e` alone is true for a DANGLING symlink — cp would follow it and
  # write the .env (FOS_API_KEY) wherever it points. A link is never written.
  if [ ! -e "${_bak}" ] && [ ! -L "${_bak}" ] && ! { mkdir -p -m 700 "${HOME}/.engram" 2>/dev/null \
      && ( umask 077; cp -- "${_env}" "${_bak}" ) 2>/dev/null && chmod 600 -- "${_bak}" 2>/dev/null; }; then
    rm -f -- "${_bak}" 2>/dev/null || true
    _vecho "[hivemind] source move skipped: could not back up ${_env}"; return 0
  fi
  _envtmp="${_env}.tmp.$$"
  if ! { cp -p -- "${_env}" "${_envtmp}" \
      && _MIG_SRC="${_dst}" _MIG_REMOTE="${_CANONICAL_REMOTE}" awk '
           /^HIVEMIND_SOURCE_DIR=/    { print "HIVEMIND_SOURCE_DIR=" ENVIRON["_MIG_SRC"]; s = 1; next }
           /^HIVEMIND_UPDATE_REMOTE=/ { print "HIVEMIND_UPDATE_REMOTE=" ENVIRON["_MIG_REMOTE"]; r = 1; next }
           /^HIVEMIND_UPDATE_BRANCH=/ { print "HIVEMIND_UPDATE_BRANCH=main"; b = 1; next }
           { print }
           END {
             if (!s) print "HIVEMIND_SOURCE_DIR=" ENVIRON["_MIG_SRC"]
             if (!r) print "HIVEMIND_UPDATE_REMOTE=" ENVIRON["_MIG_REMOTE"]
             if (!b) print "HIVEMIND_UPDATE_BRANCH=main"
           }' "${_env}" > "${_envtmp}" \
      && mv -- "${_envtmp}" "${_env}"; }; then
    rm -f -- "${_envtmp}" 2>/dev/null || true
    _vecho "[hivemind] source move skipped: could not rewrite ${_env} (the clone at ${_dst} is reused next time)"
    return 0
  fi

  rm -f -- "$(_src_migrate_marker)" 2>/dev/null || true
  HIVEMIND_SOURCE_DIR="${_dst}"
  HIVEMIND_UPDATE_REMOTE="${_CANONICAL_REMOTE}"
  HIVEMIND_UPDATE_BRANCH="main"
  export HIVEMIND_SOURCE_DIR HIVEMIND_UPDATE_REMOTE HIVEMIND_UPDATE_BRANCH
  echo "[hivemind] update source moved to the managed clone ${_dst} (update branch set to main) — ${_src} is no longer used for updates and was left untouched (.env backup: ${_bak})." >&2
  return 0
}

# ── Session spine (WS-0.3, P0.1) ──────────────────────────────────────────────
# Opens a real fos_session BEFORE exec'ing claude, through the
# product's MCP tool surface (fos_session/fos_registry over the local mTLS
# proxy).

# _resolve_device_id: stable device_id for this machine.
# Created once (first run), reused thereafter.
#
# Fase 6:
#
# DR-6.1 — `~/.engram/device-id` lives OUTSIDE ${HIVEMIND_HOME} (see the
# ~/.engram-vs-~/.hivemind isolation note at :25-28). Measured: `cmd_update`
# only mv/rm's inside ${HIVEMIND_HOME}[.staging|.last-good], and install.sh
# only writes inside ${HIVEMIND_HOME}/{.claude,runtime,bin} — neither ever
# touches ~/.engram. device_id (and its cert binding below) already survive
# both `hivemind update` and a full reinstall as a side effect of that
# isolation; this comment makes the invariant explicit instead of leaving it
# an accident nobody wrote down.
#
# DR-6.2 — the write is atomic (tmp+rename via _atomic_write, not a bare
# redirect a crash/SIGKILL mid-write could truncate) and self-healing: an
# absent OR empty/corrupted file both regenerate rather than sticking as a
# permanently-broken device_id.
#
# DR-6.3 — every caller here (_spawn_runtime, _open_session_spine) already
# runs AFTER cmd_open's/cmd_start's `_has_cert || _setup_mode` gate at the
# top of each command — measured, not
# assumed: `_setup_mode` always `exit 0`s (no fallthrough), so control only
# reaches _start_proxy/_spawn_runtime once a cert exists. Combined with
# _spawn_runtime resolving device_id INLINE on the same line that launches
# the daemon (`HIVEMIND_DEVICE_ID="$(_resolve_device_id)" nohup ...`), the
# daemon is never spawned before device-id exists on a fresh machine — no
# separate reordering was needed once these two facts are put together.
#
# DR-6.4 — device_id is CROSS-CHECKED against the enrolled cert's SHA-256
# fingerprint (~/.engram/device-id-cert-binding), never DERIVED from it — a
# cert renewal on the SAME machine must not churn device_id (see the plan
# for why derive-from was rejected). Mismatch (re-enrollment, or device-id
# copied to a machine without its matching cert) regenerates device_id +
# rebinds to the current cert, loudly logged — never silent.
_resolve_device_id() {
  local _id_file="${HOME}/.engram/device-id"
  local _binding_file="${HOME}/.engram/device-id-cert-binding"

  # DR-6.2: validate-on-read. `-s` is false for both "absent" and "present
  # but empty/truncated" — one branch self-heals both cases.
  [ -s "${_id_file}" ] || _regenerate_device_id "${_id_file}"

  # DR-6.4: only meaningful once a cert actually exists — pre-enrollment
  # callers (degenerate today, see DR-6.3 above) just skip this block;
  # device_id is already durable from the step above, only unbound until
  # enrollment completes (the binding is written the first time this runs
  # with a cert present).
  local _owner="${HIVEMIND_OWNER:-}"
  local _cert_file="${CERT_DIR}/${_owner}.cert.pem"
  if [ -n "${_owner}" ] && [ -f "${_cert_file}" ] && command -v openssl > /dev/null 2>&1; then
    local _fp
    _fp="$(_cert_fingerprint_sha256 "${_cert_file}")"
    if [ -n "${_fp}" ]; then
      if [ -s "${_binding_file}" ] && [ "$(cat "${_binding_file}")" != "${_fp}" ]; then
        echo "[hivemind] device_id/cert binding MISMATCH — cert changed (re-enrollment) or device-id was copied from another machine. Regenerating device_id and rebinding to the current cert." >&2
        _regenerate_device_id "${_id_file}"
      fi
      # First bind (no binding file yet) or just-regenerated above — write/
      # refresh the binding against the CURRENT cert either way.
      _atomic_write "${_binding_file}" "${_fp}"
    fi
  fi

  cat "${_id_file}"
}

# _mint_uuid: RFC4122 uuid via uuidgen, /proc fallback, then a last-resort
# non-RFC4122-but-locally-unique fallback. Extracted from
# _regenerate_device_id's inline chain (Fase 6) so item 18cff9b7's port-map
# device_id minting (_resolve_target_port_and_device_id below) shares the
# exact same fallback discipline instead of duplicating it — the two are
# independent identity namespaces (~/.engram/device-id vs a per-target
# device_id inside port-map.json), but "how do we mint a uuid on this
# machine" is one concern, not two.
_mint_uuid() {
  if command -v uuidgen > /dev/null 2>&1; then
    uuidgen
  elif [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  else
    # Last-resort fallback (no uuidgen, no /proc — e.g. some minimal
    # containers): not RFC4122, but stable across runs on THIS machine,
    # which is all a device_id needs to be.
    printf '%s-%s-%s' "$(hostname)" "$(date +%s)" "$$"
  fi
}

# _regenerate_device_id: mint a fresh uuid and persist it atomically
# (DR-6.2). Shared by first-creation and self-heal/rebind paths.
_regenerate_device_id() {
  local _id_file="$1"
  mkdir -p "$(dirname "${_id_file}")"
  _atomic_write "${_id_file}" "$(_mint_uuid)"
}

# _atomic_write: write $2 (+ trailing newline) to $1 via tmp+rename (DR-6.2)
# — a crash/SIGKILL mid-write leaves the ORIGINAL file untouched instead of
# a truncated one. `.tmp.$$` keys the scratch file to this process so two
# concurrent first-run writers (fresh machine, two `hivemind` windows at
# once) never clobber each other's in-flight tmp file — the `mv` is still a
# last-writer-wins race between the two, which is an accepted, named window
# (both produce a valid value; only "which one survives" is unspecified),
# not a corruption risk.
_atomic_write() {
  local _path="$1" _content="$2" _tmp
  _tmp="${_path}.tmp.$$"
  printf '%s\n' "${_content}" > "${_tmp}"
  mv "${_tmp}" "${_path}"
}

# _cert_fingerprint_sha256: SHA-256 fingerprint of a cert (DR-6.4), colon-
# separated hex after the `=`. `cut -d= -f2` rather than matching a literal
# "SHA256 Fingerprint=" prefix: measured openssl on this box prints the
# lowercase "sha256 Fingerprint=" label (casing is openssl-version-
# dependent) — splitting on `=` sidesteps that instead of guessing a prefix
# that might not match every build.
_cert_fingerprint_sha256() {
  local _cert="$1"
  openssl x509 -in "${_cert}" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2
}

# _mcp_call: POST a JSON-RPC tools/call to the local mTLS proxy; prints the
# raw SSE "data:" payload line (prefix stripped), or nothing on any failure
# (network, auth, malformed response). Never trips errexit — `|| true` is
# unconditional on the pipeline regardless of which stage would otherwise
# fail. The proxy forwards EVERY local path to the single fixed upstream it's
# built for (mtls-proxy.ts: cfg.upstream, incoming path ignored) — /v1/mcp
# here is for readability/parity with the upstream URL shape, not a routing
# requirement.
_mcp_call() {
  local _tool="$1" _args_json="$2" _id="$3"
  curl -s --max-time 5 \
    -H "x-fos-key: ${FOS_API_KEY:-}" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -d "{\"jsonrpc\":\"2.0\",\"id\":${_id},\"method\":\"tools/call\",\"params\":{\"name\":\"${_tool}\",\"arguments\":${_args_json}}}" \
    "https://127.0.0.1:${PROXY_PORT}/v1/mcp" 2>/dev/null \
    | grep "^data:" | head -1 | sed 's/^data: //' || true
}

# _mcp_result_field: extract one field from an MCP tool result. Two
# JSON.parse hops — the outer JSON-RPC envelope, then result.content[0].text
# (the tool's own JSON payload, per the MCP tool-result convention:
# content:[{type:'text', text:JSON.stringify(result)}]). Uses bun — already a
# hard dependency of this script (checked in _start_proxy) — no new
# dependency introduced. Prints nothing on any parse failure.
_mcp_result_field() {
  local _envelope="$1" _field="$2"
  [ -n "${_envelope}" ] || return 0
  bun -e '
    try {
      const envelope = JSON.parse(process.argv[1]);
      const inner = JSON.parse(envelope.result.content[0].text);
      const v = inner[process.argv[2]];
      if (v !== undefined && v !== null) console.log(v);
    } catch {}
  ' "${_envelope}" "${_field}" 2>/dev/null || true
}

# _open_session_spine: opens the fos_session for this launch and sets globals
# ENGRAM_SESSION_ID / ENGRAM_DEVICE_ID (read by cmd_open's final exec).
# $1 = project slug.
#
# BEST-EFFORT (deliberate divergence from silken-runtime, which hard-aborts
# on an empty session_id): this is the shipped client — a flaky network or a
# transient engram outage must not block the user from opening Claude at all.
# A missing ENGRAM_SESSION_ID just degrades /boot (no next_note surfaced) and
# /end-session (no real close — the watchdog reclaims the orphan) rather than
# refusing to start.
#
# NO auto-registration (WS-0.3.3 — REMOVED, F2.1). A prior version silently
# upserted the slug into the registry on the first slug_not_found here (dupla
# cobertura). That silently created a registry row for any typo'd/unknown slug
# on the user's behalf — the exact behavior the explicit slug-selection work
# (F2.2 picker) and explicit first-project bootstrap (F3.2, confirmed create)
# replace. Slug existence is now settled BEFORE this function runs (cmd_open
# resolves via arg / picker / confirmed bootstrap). If a slug still turns up
# unknown here (slug_not_found / project_required from the engram's open
# gate), we ABORT before claude starts (Phase 9) — we do NOT create it.
# This comment is a headstone, not an invitation: do not reintroduce the
# auto-upsert.
_open_session_spine() {
  local _slug="$1"
  ENGRAM_DEVICE_ID="$(_resolve_device_id)"
  ENGRAM_SESSION_ID=""

  if [ -z "${FOS_API_KEY:-}" ]; then
    _vecho "[hivemind] FOS_API_KEY ausente — sem sessão nesta janela (enrollment incompleto?)"
    return 0
  fi

  # `default` is never a session place (impl 4e978e9c Phase 9): the opener
  # refuses it outright, whatever the caller — no session is ever opened on it.
  if [ "${_slug}" = "default" ]; then
    echo "Erro: 'default' não é um lugar de sessão — abortando antes de abrir sessão." >&2
    exit 2
  fi

  local _open_args _resp _err_field _session_id
  _open_args="{\"action\":\"open\",\"slug\":\"${_slug}\",\"mode\":\"manual-cli\",\"device_id\":\"${ENGRAM_DEVICE_ID}\",\"pid\":$$}"
  _resp="$(_mcp_call "fos_session" "${_open_args}" 1)"
  _err_field="$(_mcp_result_field "${_resp}" "_err")"

  # The engram's open gate (impl 4e978e9c Phase 8) answers `project_required`
  # (default / archived / retired / blank) or `slug_not_found`: NO project, NO
  # session — abort BEFORE claude starts, never degrade, never auto-create
  # (F2.1). The other degrades below (no API key, no session_id) stay
  # best-effort: an engram outage must not block the launch.
  case "${_err_field}" in
    project_required|slug_not_found)
      _no_project_message "Erro: o engram recusou abrir sessão em '${_slug}' (${_err_field})."
      exit 1
      ;;
  esac
  # warn-mode gate (Phase 8): the open proceeds but carries a warning only this
  # launcher can show (the agent never sees the open response).
  local _gate_warn
  _gate_warn="$(_mcp_result_field "${_resp}" "project_required_warning")"
  if [ -n "${_gate_warn}" ]; then
    echo "[hivemind] aviso: este projeto não deveria abrir sessão (${_gate_warn}) — em breve será recusado. Use um projeto real: $(_web_create_url)" >&2
  fi

  _session_id="$(_mcp_result_field "${_resp}" "session_id")"
  if [ -z "${_session_id}" ]; then
    _vecho "[hivemind] fos_session open não retornou session_id — seguindo sem espinha de sessão nesta janela"
    return 0
  fi

  ENGRAM_SESSION_ID="${_session_id}"

  # Adopt-back (decision 3cab5d01, Option B device-identity): fos_session(open)'s
  # response now echoes device_id — supplied-and-reused (the normal case here,
  # since we always sent one from _resolve_device_id above) or freshly minted
  # (only for callers who had none — never us, DR-6.1-6.4 already resolves one
  # locally before this point). If it ever differs from what we sent, the
  # server's answer is treated as canonical and persisted the same atomic way
  # _regenerate_device_id does. In steady state this is a no-op echo — see
  # DR-6.3/_spawn_runtime's unavoidable local-bootstrap need, unchanged here.
  #
  # code-review fix: this is a TRUST-DIRECTION change — the server is telling
  # the client to overwrite its own local identity file — so it now logs at
  # the SAME unconditional visibility as the cert/device-id binding-mismatch
  # path above (_resolve_device_id, "MISMATCH — cert changed..."), not just
  # -v. And the value is now shape-VALIDATED as a UUID before either being
  # persisted OR assigned into ENGRAM_DEVICE_ID: this variable is later
  # interpolated UNESCAPED into hand-built JSON literals (e.g. this very
  # function's own _open_args above, `"device_id":"${ENGRAM_DEVICE_ID}"`) —
  # an unvalidated server string containing a `"` or `\` would corrupt that
  # JSON or inject fields into subsequent calls. A response that fails the
  # shape check is DROPPED (kept on the locally-resolved id) rather than
  # adopted, and reported unconditionally so it's never silently ignored.
  local _server_device_id
  _server_device_id="$(_mcp_result_field "${_resp}" "device_id")"
  if [ -n "${_server_device_id}" ] && [ "${_server_device_id}" != "${ENGRAM_DEVICE_ID}" ]; then
    case "${_server_device_id}" in
      [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
        echo "[hivemind] device_id adotado do servidor: ${_server_device_id} (era ${ENGRAM_DEVICE_ID})" >&2
        _atomic_write "${HOME}/.engram/device-id" "${_server_device_id}"
        ENGRAM_DEVICE_ID="${_server_device_id}"
        ;;
      *)
        echo "[hivemind] aviso: servidor propôs device_id '${_server_device_id}' fora do formato UUID esperado — ignorado, mantendo o local (${ENGRAM_DEVICE_ID})" >&2
        ;;
    esac
  fi

  _vecho "[hivemind] sessão aberta: ${ENGRAM_SESSION_ID} (slug=${_slug})"
}

# ── Slug selection (F2.2 / F3) ────────────────────────────────────────────────
# The registry is owner-scoped SERVER-SIDE (every read is scoped to the owner
# derived from your certificate), so `fos_registry(action:list)` already returns
# ONLY this owner's slugs — the client never filters by owner and cannot see
# another's. Response envelope: {items:[{slug,name,status,...}], count}.

# _list_slugs: populate _SLUGS_RAW ("slug<TAB>name" lines, owned + not
# archived/retired) for the
# current owner. Returns 0 on a VALID registry response — the list may be EMPTY
# (a genuine count:0 for an owner with no projects yet, the F3 bootstrap case).
# Returns 1 on transport/parse failure (no API key, proxy/network down,
# malformed payload). The caller MUST distinguish these two (F3.1): an EMPTY
# list means "bootstrap first project", an UNREACHABLE registry means "abort,
# don't guess" — collapsing them would silently offer to create a duplicate of
# an existing project during a network blip.
_list_slugs() {
  _SLUGS_RAW=""
  [ -n "${FOS_API_KEY:-}" ] || return 1
  local _resp
  _resp="$(_mcp_call "fos_registry" '{"action":"list"}' 1)"
  [ -n "${_resp}" ] || return 1
  local _out
  # bun exits 3 on parse failure / missing items array → the `||` maps that
  # (and any bun failure) to return 1. A valid empty array exits 0 with no
  # output → _SLUGS_RAW="" + return 0 (the count:0 bootstrap signal).
  _out="$(bun -e '
    try {
      const env = JSON.parse(process.argv[1]);
      const inner = JSON.parse(env.result.content[0].text);
      if (!inner || !Array.isArray(inner.items)) process.exit(3);
      for (const it of inner.items) {
        // REAL project = same rule as the backend gate and the web: NOT
        // archived/retired (legacy `inactive` counts as real). Rows the
        // caller does not own (owned === false) are never candidates; an
        // absent flag (older engram) is tolerated as owned.
        if (it.status === "archived" || it.status === "retired") continue;
        if (it.owned === false) continue;
        if (!it.slug) continue;
        process.stdout.write(`${it.slug}\t${it.name || it.slug}\n`);
      }
    } catch { process.exit(3); }
  ' "${_resp}" 2>/dev/null)" || return 1
  _SLUGS_RAW="${_out}"
  return 0
}

# _nondefault_slugs_raw: filter _SLUGS_RAW ("slug<TAB>name" lines, set by
# _list_slugs) down to every row EXCEPT the deliberate `default` home (Phase
# 2, H1/2.1). `default` is now ALWAYS a registry row (Phase 3 seed +
# backfill), so a bare `-z "${_SLUGS_RAW}"` emptiness test would never fire
# again — "does this owner have a REAL project yet" must exclude the home
# row first. Echoes the filtered lines; empty output means "no real project"
# (no project besides `default`, or no project at all).
_nondefault_slugs_raw() {
  local _s _n
  while IFS=$'\t' read -r _s _n; do
    [ -n "${_s}" ] || continue
    [ "${_s}" = "default" ] && continue
    printf '%s\t%s\n' "${_s}" "${_n}"
  done <<< "${_SLUGS_RAW}"
}

# NOTE (impl 4e978e9c Phase 9 — supersedes P3-1/P3-2): the onboarding-field
# routing (_onboarding_probe / _onboarding_state / _is_first_timer → `default`
# + ENGRAM_STARTUP=1) was REMOVED. "No project, no session": the launcher never
# routes anyone to `default`. Onboarding is SELF-only, runs inside the first
# session of the first real project, and is driven by the served boot
# (skeleton.onboarding_completed) — the runtime no longer looks at it.
# This comment is a headstone: do not reintroduce onboarding routing here.

# NOTE (P4 — impl 989cb79b): the double-access slug-lock (formerly "Fase 7 /
# DR-7.A": _fetch_lock_table + _lock_state_for_slug + a pre-open refuse in
# cmd_open) was REMOVED here. It was a Claude-Code-harness-only lock that
# masked a real open() clobber — now fixed at the engram level by P1 (the
# lane-safe open() freshness guard, live in prod v1.57.1: a NULL/different-pid
# open never closes a FRESH live sibling; only a same-pid reconnect or a
# genuinely-stale orphan is reclaimed). With that guard live, N concurrent
# sessions per slug is the intended behavior, so the harness no longer blocks
# a second open. cmd_resume (below) is now pure crash-recovery that delegates
# reclaim to that engram open() guard rather than to a client-side lock.

# _pick_project — render this owner's slugs and set _PICKED_SLUG. Mirrors
# silken-runtime:_pick_project (fzf when available; numbered-read fallback;
# same color scheme + Ctrl-C/Ctrl-D → 130). Input: _SLUGS_RAW (from
# _list_slugs). The picker simply lists every slug as selectable — there are
# no lock-state markers anymore (P4, impl 989cb79b): a slug already open in
# another window is no longer greyed out or blocked, because N concurrent
# sessions per slug is now the intended behavior (the engram P1 open()
# freshness guard is what keeps the sibling rows safe, not a client-side lock).
_pick_project() {
  _PICKED_SLUG=""
  local -a slugs names
  local _s _n
  while IFS=$'\t' read -r _s _n; do
    [ -n "${_s}" ] || continue
    slugs+=("${_s}"); names+=("${_n:-$_s}")
  done <<< "${_SLUGS_RAW}"

  local n="${#slugs[@]}"
  if [ "${n}" -eq 0 ]; then
    return 1
  fi

  local i
  local C_HEAD C_NUM C_RSTL C_BLOCK
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_HEAD=$'\033[1;36m'; C_NUM=$'\033[1;33m'; C_BLOCK=$'\033[2;31m'; C_RSTL=$'\033[0m'
  else
    C_HEAD=""; C_NUM=""; C_BLOCK=""; C_RSTL=""
  fi

  printf '%s┌─ HIVEMIND ─────────────────────────────────────┐%s\n' "$C_HEAD" "$C_RSTL" >&2
  printf '%s│  Selecione o projeto                           │%s\n' "$C_HEAD" "$C_RSTL" >&2
  printf '%s├────────────────────────────────────────────────┤%s\n' "$C_HEAD" "$C_RSTL" >&2
  for ((i=0; i<n; i++)); do
    printf '   %s%2d)%s  %s\n' "$C_NUM" "$((i+1))" "$C_RSTL" "${names[$i]}" >&2
  done
  printf '%s└────────────────────────────────────────────────┘%s\n' "$C_HEAD" "$C_RSTL" >&2

  if command -v fzf > /dev/null 2>&1; then
    local menu="" sel idx
    for ((i=0; i<n; i++)); do
      menu+="$((i+1))	${names[$i]}"$'\n'
    done
    sel=$(printf '%s' "$menu" | fzf --ansi --prompt='projeto> ' \
      --header='Enter seleciona · Esc/Ctrl-C cancela' \
      --with-nth=2.. --delimiter='\t') || return 130
    idx=$(printf '%s' "$sel" | cut -f1)
    [ -z "$idx" ] && return 130
    _PICKED_SLUG="${slugs[$((idx-1))]}"
  else
    local choice
    while :; do
      printf '%s  → número [1-%d] (Ctrl-C cancela): %s' "$C_NUM" "$n" "$C_RSTL" >&2
      if ! IFS= read -r choice; then
        echo "" >&2; return 130
      fi
      case "$choice" in
        ''|*[!0-9]*)
          printf '%s  ✗ Entrada inválida.%s\n' "$C_BLOCK" "$C_RSTL" >&2; continue ;;
      esac
      if [ "$choice" -lt 1 ] || [ "$choice" -gt "$n" ]; then
        printf '%s  ✗ Fora do intervalo.%s\n' "$C_BLOCK" "$C_RSTL" >&2; continue
      fi
      _PICKED_SLUG="${slugs[$((choice-1))]}"
      break
    done
  fi
  return 0
}

# _bootstrap_first_slug (the bare bash "type your first project's name" flow)
# was REMOVED (Phase 2, H2/2.2) and the `default` + ENGRAM_STARTUP first-timer
# route that replaced it was REMOVED too (impl 4e978e9c Phase 9). The launcher
# creates NOTHING: projects are created on the HiveMind web app, and a
# project-less owner is pointed at _web_create_url (see _resolve_project_slug).
#
# ARCHITECTURAL NOTE: creating a slug is a MUTATION that converges on the
# engram's ONE create rule (RegistryService, fos_registry(action:create) /
# POST /v1/registry) — the web create form is its client, never this script.

# _seed_engram_mcp_config: re-assert mcpServers.engram in
# $HIVEMIND_HOME/.claude/.claude.json at OPEN time (papercut d,
# pattern_hivemind-runtime-mcp-config-is-user-scope-not-project-mcp-json,
# measured 2026-08-04).
#
# WHY: cmd_open execs `claude --setting-sources user`, so Claude Code
# discovers MCP servers ONLY from this user-scope file. The enrollment-time
# seed (routes/setup.ts ~387-440) writes it ONCE, but Claude Code itself can
# clobber the file on exit — leaving a future `/mcp` with no engram entry
# until someone hand-reseeds it. Re-running the same merge-safe write on
# every open closes that gap without ever needing a second source of truth.
#
# MERGE-SAFE, mirrors setup.ts's write EXACTLY (do not reinvent): preserve
# every OTHER top-level key and every OTHER mcpServers.* entry; overwrite
# ONLY mcpServers.engram; self-heal a missing/corrupted/non-object top-level
# document AND a missing/null/array `mcpServers` to {} rather than throwing.
# NO headers, NO FOS_API_KEY or other secret material in the written entry —
# the mTLS proxy injects x-fos-key server-side (atomic-flip, round-2
# 2026-07-30; setup.ts:414-423) — so this file, readable by anything with fs
# access to $HIVEMIND_HOME, carries zero secrets regardless of who wrote or
# reads it. Atomic write (temp file + rename) + chmod 0600, same posture as
# setup.ts's own write of this file.
#
# No new dependency: bun is already a hard requirement of this script
# (checked in _start_proxy) and is what setup.ts itself runs under, so this
# reuses the same JS runtime rather than introducing a `node`/`jq` dependency.
#
# BEST-EFFORT (same fail-soft posture as _open_session_spine above, "engram
# outage must not block opening Claude"): any failure here (disk full,
# permissions, a transient bun hiccup) is logged via _vecho and swallowed —
# it only degrades the NEXT session's /mcp discovery, never blocks THIS
# session from opening Claude. Idempotent: running it twice back-to-back
# produces byte-identical output on the second run.
# _write_generic_mcp_config: the same merge-safe mcpServers.engram write,
# EXTRACTED so it can target an ARBITRARY path — not just Claude Code's own
# $HIVEMIND_HOME/.claude/.claude.json. Shared by _seed_engram_mcp_config
# below (Claude Code's user-scope file) and `hivemind install`'s carrier
# (P2, item ef1c9385 — reuse, don't reinvent) for any OTHER local client's
# own mcp.json-shaped config. $1 = absolute path to write/merge, $2 = port.
#
# PORT IS NOW AN EXPLICIT REQUIRED ARG (Option 2, item 18cff9b7) — this used
# to hardcode the implicit shared "${PROXY_PORT}" as its 2nd positional bun
# arg; every caller now decides which port an entry points at.
# _seed_engram_mcp_config (Claude Code's own self-seed) still passes
# "${PROXY_PORT}" explicitly — that entry stays on the shared/default port,
# unchanged behavior. `hivemind install`'s guided flow (_install_run) now
# passes a DEDICATED port allocated by _resolve_target_port_and_device_id
# below, instead.
#
# Same contract as before this extraction (behavior-preserving refactor):
# preserve every other top-level key + mcpServers.* entry; self-heal a
# missing/corrupted/non-object document AND a missing/null/array
# `mcpServers` to {} rather than throwing; atomic tmp+rename; chmod 0600;
# NO headers/FOS_API_KEY or other secret material in the written entry — the
# mTLS proxy injects the credential server-side (decision `bee7f370`:
# HTTPS-loopback-by-default, no stdio, no header/${VAR} dependency for any
# client). Returns bun's exit status — 0 on a clean write, non-zero on any
# failure (disk full, permissions, malformed args) — callers decide whether
# a failure is fail-soft (re-seed) or fail-loud (a fresh `install`).
_write_generic_mcp_config() {
  local _target_path="$1"
  local _port="$2"
  bun -e '
    import { existsSync, readFileSync, writeFileSync, renameSync, chmodSync, mkdirSync } from "node:fs";
    import { dirname } from "node:path";

    const configPath = process.argv[1];
    const proxyPort = process.argv[2];

    let existing = {};
    if (existsSync(configPath)) {
      try {
        const parsed = JSON.parse(readFileSync(configPath, "utf8"));
        if (typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)) {
          existing = parsed;
        }
        // else: corrupted/non-object document → {} (never throws, never
        // aborts the caller — same "corrompido → {}" contract as setup.ts).
      } catch { /* unparseable → {} */ }
    }

    let existingServers = existing.mcpServers;
    if (typeof existingServers !== "object" || existingServers === null || Array.isArray(existingServers)) {
      existingServers = {};
    }

    const merged = {
      ...existing,
      mcpServers: {
        ...existingServers,
        engram: { type: "http", url: `https://127.0.0.1:${proxyPort}/v1/mcp` },
      },
    };

    mkdirSync(dirname(configPath), { recursive: true });
    const tmpPath = `${configPath}.tmp-${process.pid}`;
    writeFileSync(tmpPath, JSON.stringify(merged, null, 2), { mode: 0o600 });
    renameSync(tmpPath, configPath);
    chmodSync(configPath, 0o600);
  ' "${_target_path}" "${_port}"
  # code-review fix: stderr used to be swallowed HERE (`2>/dev/null` on the
  # bun invocation), which made every caller's failure branch blind — in
  # particular _install_run's interactive "✗ falha ao gravar <path>" (below)
  # showed NO reason at all (permission denied, disk full, ...), the exact
  # moment a human is standing there waiting to know why. Left un-swallowed
  # now; each caller decides what to do with stderr — _seed_engram_mcp_config
  # (best-effort, non-blocking re-seed) captures it into its own -v-gated
  # line, _install_run (interactive, blocking) surfaces it directly.
}

_seed_engram_mcp_config() {
  local _claude_config="${HIVEMIND_HOME}/.claude/.claude.json"
  local _seed_err
  if ! _seed_err="$(_write_generic_mcp_config "${_claude_config}" "${PROXY_PORT}" 2>&1)"; then
    _vecho "[hivemind] aviso: falha ao re-selar mcpServers.engram em .claude.json (não bloqueante)${_seed_err:+: ${_seed_err}}"
  fi
  return 0
}

# ── Option 2 per-target proxy — port-map.json helpers (item 18cff9b7) ───────
# Full design: fos_sketchpad 4f8142e3 § ADDENDUM 3. `hivemind install
# <target>` allocates a DEDICATED loopback port + mints a device_id per
# installed target, persisted to PORT_MAP_FILE — read at daemon boot and on
# every POST /internal/proxy/reload by runtime/src/lib/mtls-proxy.ts's
# startAllMtlsProxies()/reloadNewProxyListeners(). Shape: {"version":1,
# "entries":[{"path","target_id","scope","port","device_id","created_at",
# "updated_at"}]}, keyed on `path` (the resolved absolute config file path —
# unique per installed target/scope combination).

# _port_map_used_ports: prints every entries[].port on its own line. Never
# throws — same self-heal posture as every other JSON read in this file
# (absent/corrupted file, non-array entries, or a non-numeric port on any one
# entry all degrade to "not used", never abort the caller).
_port_map_used_ports() {
  bun -e '
    import { existsSync, readFileSync } from "node:fs";
    const mapPath = process.argv[1];
    if (!existsSync(mapPath)) process.exit(0);
    try {
      const parsed = JSON.parse(readFileSync(mapPath, "utf8"));
      const entries = Array.isArray(parsed?.entries) ? parsed.entries : [];
      for (const e of entries) {
        if (e && typeof e.port === "number") console.log(e.port);
      }
    } catch { /* corrupted -> no used ports on record */ }
  ' "${PORT_MAP_FILE}" 2>/dev/null
}

# _port_map_lookup: prints "<port>\t<device_id>" for the entry whose `path`
# matches $1, or nothing (empty stdout) if PORT_MAP_FILE is absent/corrupted/
# has no matching entry. Never throws.
_port_map_lookup() {
  local _path="$1"
  bun -e '
    import { existsSync, readFileSync } from "node:fs";
    const mapPath = process.argv[1];
    const targetPath = process.argv[2];
    if (!existsSync(mapPath)) process.exit(0);
    try {
      const parsed = JSON.parse(readFileSync(mapPath, "utf8"));
      const entries = Array.isArray(parsed?.entries) ? parsed.entries : [];
      const hit = entries.find((e) => e && e.path === targetPath);
      if (hit && typeof hit.port === "number" && typeof hit.device_id === "string") {
        console.log(`${hit.port}\t${hit.device_id}`);
      }
    } catch { /* corrupted -> no match, caller allocates fresh */ }
  ' "${PORT_MAP_FILE}" "${_path}" 2>/dev/null
}

# _port_map_write_entry: merge-safe upsert of ONE entry, keyed on `path` (any
# prior entry for the same path is replaced, preserving its created_at).
# Atomic tmp+rename + chmod 0600 — same posture as _write_generic_mcp_config.
# $1=path $2=target_id $3=scope $4=port $5=device_id.
_port_map_write_entry() {
  local _path="$1" _target_id="$2" _scope="$3" _port="$4" _device_id="$5"
  bun -e '
    import { existsSync, readFileSync, writeFileSync, renameSync, chmodSync, mkdirSync } from "node:fs";
    import { dirname } from "node:path";

    const mapPath  = process.argv[1];
    const path_    = process.argv[2];
    const targetId = process.argv[3];
    const scope    = process.argv[4];
    const port     = Number(process.argv[5]);
    const deviceId = process.argv[6];

    let doc = { version: 1, entries: [] };
    if (existsSync(mapPath)) {
      try {
        const parsed = JSON.parse(readFileSync(mapPath, "utf8"));
        if (parsed && typeof parsed === "object" && Array.isArray(parsed.entries)) {
          doc = parsed;
        }
        // else: corrupted/non-shaped document -> start fresh {version:1,
        // entries:[]} rather than throwing (same self-heal contract as every
        // other JSON read/write in this file).
      } catch { /* unparseable -> start fresh */ }
    }

    const priorEntries = Array.isArray(doc.entries) ? doc.entries : [];
    const prior = priorEntries.find((e) => e && e.path === path_);
    const others = priorEntries.filter((e) => !(e && e.path === path_));

    const now = new Date().toISOString();
    const entry = {
      path: path_,
      target_id: targetId || undefined,
      scope: scope || undefined,
      port,
      device_id: deviceId,
      created_at: (prior && prior.created_at) || now,
      updated_at: now,
    };

    const merged = { version: 1, entries: [...others, entry] };

    mkdirSync(dirname(mapPath), { recursive: true, mode: 0o700 });
    const tmpPath = `${mapPath}.tmp-${process.pid}`;
    writeFileSync(tmpPath, JSON.stringify(merged, null, 2), { mode: 0o600 });
    renameSync(tmpPath, mapPath);
    chmodSync(mapPath, 0o600);
  ' "${PORT_MAP_FILE}" "${_path}" "${_target_id}" "${_scope}" "${_port}" "${_device_id}"
}

# _allocate_target_port: lowest free port in
# [MTLS_INSTALL_PORT_RANGE_START, MTLS_INSTALL_PORT_RANGE_END] not already a
# port-map entries[].port. Prints the chosen port on stdout; on range
# exhaustion, prints nothing and returns 1 with a message on stderr (max
# targets = range size, 100 by default) rather than silently colliding.
_allocate_target_port() {
  local _used
  _used="$(_port_map_used_ports)"
  local _p
  for ((_p = MTLS_INSTALL_PORT_RANGE_START; _p <= MTLS_INSTALL_PORT_RANGE_END; _p++)); do
    if ! printf '%s\n' "${_used}" | grep -qx "${_p}"; then
      echo "${_p}"
      return 0
    fi
  done
  echo "Erro: intervalo de portas para 'hivemind install' esgotado (${MTLS_INSTALL_PORT_RANGE_START}-${MTLS_INSTALL_PORT_RANGE_END}) — máximo de alvos instalados atingido." >&2
  return 1
}

# _resolve_target_port_and_device_id: idempotent port+device_id resolution
# for `hivemind install`. Keyed on the resolved absolute config file PATH
# (the same value _install_run computes as _final_path) — re-running install
# against an ALREADY-mapped path REUSES that entry's existing port+device_id
# rather than reallocating (self-heal, no-silent-reallocate posture, mirrors
# _write_generic_mcp_config's own idempotency). $1=path $2=target_id $3=scope.
# Prints "<port>\t<device_id>" on success; returns 1 (nothing printed, error
# already on stderr via _allocate_target_port) if the range is exhausted on a
# fresh allocation.
#
# code-review FIX (TOCTOU): the lookup-then-allocate-then-write sequence used
# to run WITHOUT any cross-process lock, so N concurrent `hivemind install`s
# (or N concurrent callers of this function) could all read the SAME "used
# ports" snapshot before any of them persisted — measured: 8 concurrent
# installs all minted port 7780, and 3 of the 8 port-map entries were lost
# outright (each writer's read-merge-write raced the others' unflushed
# write). The whole read+allocate+write critical section now runs inside a
# single `flock -x` on ${PORT_MAP_FILE}.lock, so allocation and persistence
# are atomic per install — a second concurrent caller blocks until the first
# has both picked ITS port and written it to disk, and therefore always sees
# it as "used". Same lock file guards every caller (this is the ONLY writer
# of port-map.json), so this also serializes against itself when called
# twice back-to-back for different paths in the same process (idempotent
# re-install, two-distinct-targets tests below).
_resolve_target_port_and_device_id() {
  local _path="$1" _target_id="$2" _scope="$3"
  mkdir -p "$(dirname "${PORT_MAP_FILE}")" 2>/dev/null || true
  local _lock_file="${PORT_MAP_FILE}.lock"
  local _rc=0
  (
    flock -x 200
    local _existing
    _existing="$(_port_map_lookup "${_path}")"
    if [ -n "${_existing}" ]; then
      printf '%s\n' "${_existing}"
      exit 0
    fi

    local _port
    _port="$(_allocate_target_port)" || exit 1
    local _device_id
    _device_id="$(_mint_uuid)"
    _port_map_write_entry "${_path}" "${_target_id}" "${_scope}" "${_port}" "${_device_id}"
    printf '%s\t%s\n' "${_port}" "${_device_id}"
  ) 200>"${_lock_file}" || _rc=$?
  return "${_rc}"
}

# _preview_target_port: READ-ONLY preview of the port `_resolve_target_port_
# and_device_id` would return right now — reuses an existing port-map entry
# for `path` if one is already there (the idempotent re-install case, so the
# confirmation prompt shows the SAME port the commit below will reuse), or
# computes the lowest currently-free port in range for DISPLAY ONLY: no
# lock, no write, no minted device_id, no port-map.json mutation.
#
# Exists so `_install_run` can show the human "here's the port you're about
# to wire up" at the y/N confirmation WITHOUT allocating/persisting anything
# yet (code-review FIX: declining used to still leave a minted device_id +
# reserved port behind — see _resolve_target_port_and_device_id's caller in
# _install_run). Because this is a lock-free peek, under real concurrent
# installs the previewed port could in principle differ from the one
# actually committed after confirmation (another install grabs it in
# between) — cosmetic only (never a collision: the real allocation is still
# atomic), and _install_run re-displays the committed port if that happens.
# $1=path. Prints "<port>" (no device_id — not minted yet for a fresh path).
_preview_target_port() {
  local _path="$1"
  local _existing
  _existing="$(_port_map_lookup "${_path}")"
  if [ -n "${_existing}" ]; then
    printf '%s' "${_existing}" | cut -f1
    return 0
  fi
  _allocate_target_port
}

# _web_create_url: where a project is created — the web app on the SAME host
# as the configured endpoint (HIVEMIND_ENDPOINT minus :port), never a
# hardcoded host beyond the documented default.
_web_create_url() {
  local _host="${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443}"
  _host="${_host%%:*}"
  printf 'https://%s/app' "${_host}"
}

# _no_project_message: the shared "no project, no session" text (stderr).
# $1 = headline. Callers exit themselves.
_no_project_message() {
  echo "$1" >&2
  echo "      Toda sessão acontece dentro de um projeto. Crie seu primeiro projeto (ou restaure um) em $(_web_create_url) e rode \`hivemind\` de novo." >&2
}

# _resolve_project_slug: resolve the slug cmd_open opens and set _RESOLVED_SLUG.
# $1 = typed slug or "". It calls `exit` on every abort path, so callers that
# need to survive run it in a subshell (the tests do).
# The tty test goes through _is_interactive so tests can shadow it.
#
# NO PROJECT, NO SESSION (impl 4e978e9c Phase 9, decisions 6d7c8491/78dfeaf0):
# a session exists only on a REAL project — owned, not `default`, not
# archived. Candidates = _nondefault_slugs_raw (_list_slugs already returns
# owned, not archived/retired). Order: explicit arg > interactive selection. There is
# deliberately NO basename(cwd) fallback (F2.3) and NO routing to `default`.
#   - explicit arg: registry FIRST (unreachable → abort). `default` → exit 2;
#     unknown/archived → exit 1 "projeto '<x>' não encontrado" + create URL.
#     Claude never starts.
#   - no arg + tty: 0 candidates → message + create URL, exit 1; exactly 1 →
#     opened directly with a one-line notice; 2+ → picker (candidates only).
#   - no arg + no tty: fail closed, unchanged.
_is_interactive() { [ -t 0 ] && [ -t 1 ]; }

# _slug_in_candidates: 0 when $1 is a REAL project row (non-default, active).
_slug_in_candidates() {
  local _s _n
  while IFS=$'\t' read -r _s _n; do
    [ -n "${_s}" ] && [ "${_s}" = "$1" ] && return 0
  done <<< "$(_nondefault_slugs_raw)"
  return 1
}

_registry_unreachable_abort() {
  echo "Erro: não foi possível consultar o registry (rede/proxy indisponível?) —" >&2
  echo "      não é seguro selecionar um projeto às cegas. Verifique 'hivemind status'." >&2
  exit 1
}

_resolve_project_slug() {
  local _slug="${1:-}"
  _RESOLVED_SLUG=""

  if [ -n "${_slug}" ]; then
    if [ "${_slug}" = "default" ]; then
      echo "Erro: 'default' é a casa interna do HiveMind e não é um lugar de sessão." >&2
      echo "      Rode \`hivemind <projeto>\` com um projeto real (ou \`hivemind\` para escolher)." >&2
      exit 2
    fi
    _list_slugs || _registry_unreachable_abort
    if ! _slug_in_candidates "${_slug}"; then
      _no_project_message "Erro: projeto '${_slug}' não encontrado (inexistente ou arquivado)."
      exit 1
    fi
    _RESOLVED_SLUG="${_slug}"
  elif _is_interactive; then
    _list_slugs || _registry_unreachable_abort
    local _cand _count
    _cand="$(_nondefault_slugs_raw)"
    _count="$(printf '%s' "${_cand}" | grep -c . || true)"
    if [ "${_count}" -eq 0 ]; then
      echo "┌─ HIVEMIND ──────────────────────────────────────────────────┐" >&2
      echo "  Você ainda não tem um projeto." >&2
      echo "  Toda sessão acontece dentro de um projeto. Crie seu primeiro projeto em" >&2
      echo "  $(_web_create_url)" >&2
      echo "  e rode \`hivemind\` de novo." >&2
      echo "└──────────────────────────────────────────────────────────────┘" >&2
      exit 1
    elif [ "${_count}" -eq 1 ]; then
      local _only _only_name
      IFS=$'\t' read -r _only _only_name <<< "${_cand}"
      echo "[hivemind] abrindo o único projeto: ${_only_name:-${_only}} (${_only})" >&2
      _RESOLVED_SLUG="${_only}"
    else
      # Picker over the candidates ONLY — never `default`, never archived.
      _SLUGS_RAW="${_cand}"
      local _rc=0
      _pick_project || _rc=$?
      if [ "${_rc}" -eq 130 ]; then
        echo "Seleção cancelada." >&2
        exit 130
      elif [ "${_rc}" -ne 0 ] || [ -z "${_PICKED_SLUG}" ]; then
        echo "Erro: falha ao selecionar o projeto." >&2
        exit 1
      fi
      _RESOLVED_SLUG="${_PICKED_SLUG}"
    fi
  else
    # No arg + non-interactive: fail closed (F2.3, founder-accepted). No
    # basename(cwd) fallback — automation must pass an explicit slug.
    echo "Erro: nenhum slug informado e a entrada não é um terminal interativo." >&2
    echo "      Rode 'hivemind <slug>' explicitamente em contexto não-interativo." >&2
    exit 1
  fi
}

# cmd_open: start proxy + exec claude.
# $1 = slug (optional); remaining $@ passed to claude.
# ── Proxy-only launch (impl 3e2c90da, phase S4) ─────────────────────────────
# Direct engram MCP endpoint for the bearer fallback — measured in the engram
# (read-only, engram@d7d2034): apps/backend/src/config/env.config.ts:839
# FOS_MCP_URL default; header shape from modules/me/mcp-config.service.ts:85
# (`Authorization: Bearer fospb_…`, prefix common/porta-b-token-registry.ts:48),
# accepted on /v1/mcp by common/mcp-tenant-context.middleware.ts:442-444
# (Layer 0, Porta-B). Whether a plan may use it is decided server-side
# (access posture), never here. That default is the PROD engram, so it is
# printed only for an install pointed at the default PROD endpoint; any other
# endpoint (e.g. LAB) gets the fallback only with HIVEMIND_DIRECT_MCP_URL set
# in the process env (_DIRECT_MCP_URL_OVERRIDE).
DIRECT_MCP_URL_DEFAULT="https://api.hivemind.ia.br/v1/mcp"
DEFAULT_HIVEMIND_ENDPOINT="hivemind.ia.br:4443"

# _direct_mcp_url: the fallback URL to print, or nothing (return 1).
_direct_mcp_url() {
  if [ -n "${_DIRECT_MCP_URL_OVERRIDE}" ]; then
    printf '%s\n' "${_DIRECT_MCP_URL_OVERRIDE}"; return 0
  fi
  if [ "${HIVEMIND_ENDPOINT:-${DEFAULT_HIVEMIND_ENDPOINT}}" = "${DEFAULT_HIVEMIND_ENDPOINT}" ]; then
    printf '%s\n' "${DIRECT_MCP_URL_DEFAULT}"; return 0
  fi
  return 1
}

# _print_connect_hints: how to point an MCP client at the running proxy.
# Printed by a proxy-only `hivemind` / `hivemind start` only.
_print_connect_hints() {
  local _url="https://127.0.0.1:${PROXY_PORT}/v1/mcp" _direct=""
  echo ""
  echo "HiveMind proxy is running (proxy-only install — Claude Code is not started)."
  echo ""
  echo "  MCP URL:  ${_url}"
  echo ""
  echo "  Connect a client to it:"
  echo "    Claude Code:  claude mcp add --transport http --scope user engram ${_url}"
  echo "    Codex:        add to ~/.codex/config.toml:"
  echo "                    [mcp_servers.engram]"
  echo "                    url = \"${_url}\""
  echo "    Cursor, Antigravity, Cowork or any other client:"
  echo "                  hivemind install [cursor|antigravity|cowork|manual]"
  echo ""
  echo "  TLS: the proxy's certificate is issued by a local CA (${LOCAL_HTTPS_CA}),"
  echo "  trusted into the system store by hivemind. If a client still rejects it, point the"
  echo "  client at that file (Node-based clients: NODE_EXTRA_CA_CERTS=${LOCAL_HTTPS_CA})."
  echo ""
  if _direct="$(_direct_mcp_url)"; then
    echo "  Fallback — a client that cannot use this local proxy can connect directly to the"
    echo "  engram MCP over HTTPS with a bearer key (where your plan allows it):"
    echo "    URL:     ${_direct}"
    echo "    Header:  Authorization: Bearer fospb_…"
    echo "    Key:     create it in the HiveMind web app ($(_web_create_url)), API Key access."
    echo ""
  fi
  echo "  Add the Claude Code harness later: bash install.sh (from the HiveMind clone)."
}

# _open_proxy_only: `hivemind [<slug>]` on a proxy-only install. Enrollment
# (if no cert yet) → silent auto-update → proxy → connect hints. No project
# picker, no session open, no claude exec — a proxy-only vessel opens its own
# session, as any foreign client does.
_open_proxy_only() {
  if ! _has_cert; then
    _setup_mode
  else
    _brand_header
  fi
  _maybe_migrate_source || true
  _maybe_auto_update
  _start_proxy
  _maybe_surface_install_candidates
  if [ -n "${1:-}" ]; then
    echo "[hivemind] '${1}' ignored — this install has no Claude Code harness, so no session is opened here." >&2
  fi
  _print_connect_hints
}

cmd_open() {
  # Proxy-only install (phase S4) — everything below this branch is the
  # proxy+harness path, unchanged.
  if ! _has_harness; then
    _open_proxy_only "$@"
    exit 0
  fi
  local _slug="${1:-}"
  if [ $# -gt 0 ]; then shift; fi

  if ! _has_cert; then
    _setup_mode
  else
    _brand_header
  fi

  _maybe_migrate_source || true
  _maybe_auto_update
  _start_proxy
  _maybe_surface_install_candidates

  _resolve_project_slug "${_slug}"
  local _project_slug="${_RESOLVED_SLUG}"

  if [ -z "${_project_slug}" ]; then
    echo "Erro: nenhum projeto resolvido — encerrando." >&2
    exit 1
  fi

  # ── P4 (impl 989cb79b): NO pre-open slug-lock here anymore ───────────────
  # The former "Fase 7 / DR-7.A" double-access lock refused to open a slug
  # already held by a live session on this device. It was removed: a second
  # session on the same slug now opens FREELY (N concurrent lanes per slug is
  # the intended behavior). The clobber that lock masked is fixed at the
  # engram level by P1 — the lane-safe open() freshness guard (live in prod
  # v1.57.1) never closes a FRESH live sibling, so a concurrent open() cannot
  # destroy the other lane's session row. There is nothing to check here; we
  # go straight to opening.

  # Espinha de sessão (WS-0.3) — abre DEPOIS do proxy responder no health,
  # ANTES do exec (silken-runtime mirror). Sets ENGRAM_SESSION_ID/
  # ENGRAM_DEVICE_ID (globals, best-effort — see _open_session_spine).
  _open_session_spine "${_project_slug}"

  # Fase 3 (DR-3.1) — adopt-before-exec: register this session's pid with
  # the daemon so its pid-watcher + heartbeat (Fase 2, routes/sessions.ts)
  # start tracking it. Must run AFTER _open_session_spine (needs a real
  # ENGRAM_SESSION_ID) and BEFORE `exec` below replaces this script's process
  # image — $$ only stays valid as the tracked pid across that exec because
  # exec preserves the pid (same trick silken-runtime:376-377 relies on).
  # Best-effort, same fail-soft spirit as _open_session_spine itself: a
  # daemon hiccup here must never block the user from opening Claude.
  if [ -n "${ENGRAM_SESSION_ID}" ]; then
    curl -s -X POST --max-time 3 \
      -H "Content-Type: application/json" \
      -d "{\"session_id\":\"${ENGRAM_SESSION_ID}\",\"pid\":$$,\"slug\":\"${_project_slug}\"}" \
      "http://127.0.0.1:${RUNTIME_PORT}/sessions/adopt" > /dev/null 2>&1 || true
  fi

  # F0 auth fail-safe (item 5.0) — the isolated CONFIG_DIR may have no
  # credential at all (install.sh only seeds it best-effort from the user's
  # personal ~/.claude, and a brand-new CONFIG_DIR on a machine with no prior
  # personal login has nothing to seed from). Missing credential triggers a
  # login flow INSIDE the same isolated CONFIG_DIR, so the resulting auth
  # state stays apartada from the user's personal Claude Code account.
  # Confirmed live (G3, Claude Code CLI v2.1.207): `claude auth login`
  # authenticates-AND-EXITS (prints an OAuth URL, waits for the pasted
  # callback code, writes the credential, then returns) — it does NOT enter an
  # interactive session, so it is safe to run here and fall through to the
  # normal `exec claude` below afterwards. Fail-safe, not fail-closed: if the
  # login is skipped/cancelled/times out, we still proceed to `exec` (the
  # interactive session will show its own auth prompt if needed) — never abort
  # the whole command over auth. NOTE (P2, out of scope for this pass): this
  # only covers ABSENCE, not an EXPIRED-but-present credential — known
  # limitation.
  if [ ! -f "${HIVEMIND_HOME}/.claude/.credentials.json" ]; then
    echo ""
    echo "Nenhuma credencial encontrada no runtime isolado do HiveMind — fazendo login..."
    env CLAUDE_CONFIG_DIR="${HIVEMIND_HOME}/.claude" claude auth login || true
  fi

  # Re-assert mcpServers.engram in the user-scope .claude.json RIGHT BEFORE
  # exec (papercut d) — closes the window where a prior Claude Code exit
  # clobbered the enrollment-time seed, without depending on anything else
  # in cmd_open having run first. Best-effort, never blocks the exec below.
  _seed_engram_mcp_config

  # --setting-sources user (item 5.2, F2 isolation): the isolated CONFIG_DIR
  # already redirects commands/skills/MCP/global-CLAUDE.md (CLAUDE_CONFIG_DIR
  # above), but without this flag the user's PROJECT ./CLAUDE.md (walk-up from
  # cwd) still leaks into context — measured (P3/P4, CLI v2.1.207). This flag
  # is the scalpel that suppresses project-scoped settings/CLAUDE.md/.mcp.json
  # while keeping the product's user-scoped config intact — intentional, not
  # a side effect (re-measure if the embedded CLI version changes).
  exec env \
    CLAUDE_CONFIG_DIR="${HIVEMIND_HOME}/.claude" \
    ENGRAM_SLUG="${_project_slug}" \
    ENGRAM_SESSION_ID="${ENGRAM_SESSION_ID}" \
    ENGRAM_DEVICE_ID="${ENGRAM_DEVICE_ID}" \
    HIVEMIND_HOME="${HIVEMIND_HOME}" \
    claude --setting-sources user "$@"
}

# cmd_resume: explicit crash recovery. NEVER auto-triggered; the user names
# the command themselves. $1 = slug (required, no picker here — recovery
# targets a specific known-crashed slug, not a browse-and-pick flow).
#
# P4 (impl 989cb79b): this is now PURE crash-recovery — it no longer carries
# the old client-side alive/dead slug-lock model (that whole lock was removed,
# see the note above _pick_project and the P4 block in cmd_open). Recovery of
# a stale/crashed session is now owned by the engram's lane-safe open() guard
# (P1, live in prod v1.57.1): a fresh open() on the slug reconnects a same-pid
# session and reclaims a genuinely-stale orphan, while never clobbering a
# FRESH live sibling. So `resume` just re-opens the slug through the normal
# cmd_open path — same slug, same spine, same adopt-before-exec — and lets the
# engram reclaim/reconnect. It no longer force-closes anything itself, and it
# no longer refuses when another live lane exists (concurrent lanes are fine
# now); `resume` and a plain `hivemind <slug>` differ only in intent/messaging.
cmd_resume() {
  local _slug="${1:-}"
  if [ -z "${_slug}" ]; then
    echo "Erro: uso: hivemind resume <slug>" >&2
    exit 1
  fi

  if ! _has_cert; then
    echo "Erro: nenhum certificado encontrado — rode 'hivemind' (sem argumentos) primeiro para completar o enrollment." >&2
    exit 1
  fi
  if [ -z "${FOS_API_KEY:-}" ]; then
    echo "Erro: FOS_API_KEY ausente — enrollment incompleto?" >&2
    exit 1
  fi

  # Proxy-only: no session is opened here — cmd_open prints its own "ignored" note.
  if _has_harness; then
    echo "[hivemind] recuperando '${_slug}' — reabrindo (a reconexão/reclamação de sessão travada é resolvida no open do engram)..." >&2
  fi

  # Hand off to the normal open path (explicit slug — cmd_open never shows the
  # picker when a slug is given). cmd_open runs _maybe_auto_update + _start_proxy
  # itself, then opens; the engram's lane-safe open() reclaims a stale orphan or
  # reconnects a same-pid session for this slug. One open path, not two.
  cmd_open "${_slug}"
}

# ── install (P2 — guided MCP-client installer, platform-agnostic core) ──────
# `hivemind install [<target>]` walks a human through wiring the SAME generic
# entry `_seed_engram_mcp_config` already writes for Claude Code itself
# (`mcpServers.engram = {type:"http", url:"https://127.0.0.1:<port>/v1/mcp"}`,
# decision `bee7f370`: HTTPS-loopback-by-default, no stdio, no header/${VAR}
# dependency for any client — the mTLS proxy injects the credential
# server-side) into ANOTHER local client's own mcp.json-shaped config
# (Cursor, Antigravity, ...).
#
# FOUNDER CONSTRAINT — NO DEFAULT PATH, EVER: every write is preceded by an
# explicit, typed confirmation of the EXACT path about to be touched.
# Candidates are DETECTED and PRESENTED, never assumed; scope (global vs
# per-project) is ASKED, never assumed. This is why the whole command is
# TTY-gated (cmd_install below) — a guided confirmation cannot happen
# non-interactively. Supplying `<target>` only skips the "which client"
# menu; it never skips the scope/path confirmation.
#
# SCOPE (per the task order — core, platform-agnostic): this command and
# _install_run below own the command skeleton, detection, prompts, and the
# generic carrier (_write_generic_mcp_config, above). Per-client FORMAT
# quirks (e.g. a client whose own config uses a different top-level
# key/shape than the mcpServers convention) are explicitly OUT of scope —
# _INSTALL_IDS/_INSTALL_LABELS below is the seam a P3 per-client writer
# would extend or override, not something to speculatively build now.

# _install_target_catalog: populates the static candidate list. Parallel
# arrays (matches this file's existing convention — see _pick_project's
# slugs/names) rather than an associative array, since bash 3.2-compatible
# arrays are what the rest of the script already assumes.
_install_target_catalog() {
  _INSTALL_IDS=(cursor antigravity cowork)
  _INSTALL_LABELS=("Cursor" "Antigravity (Windows, via WSL)" "Cowork (Claude desktop, via device bridge)")
}

# _cowork_skills_dir: prints the Cowork (Claude desktop, MSIX) skills-plugin dir
# this machine writes client-side skills to; returns non-zero if not found.
# Cowork is the ONE target that gets skill FILES written (exception to decision
# bee7f370): it reaches the engram via the device bridge, which proxies TOOLS
# (fos_*) but NOT MCP prompts — so it cannot discover the served
# /mcp__engram__boot|end-session prompts and needs thin-stub carriers that call
# the fos_procedure TOOL.
#
# Cowork = MSIX build (package Claude_pzs8sxrjxfjjc). Skills live under an
# account/org-scoped skills-plugin, folder-per-skill, inside the MSIX LocalCache
# (the Windows-side AppData\Roaming\Claude is empty/logs-only). There is NO
# native per-project scope — the desktop app applies one account plugin to every
# session, so scope is effectively global-only.
#
# Overrides: COWORK_SKILLS_ROOT replaces the whole resolved path (mirrors
# ANTIGRAVITY_WINDOWS_USERS_ROOT); COWORK_WINDOWS_USERS_ROOT replaces just the
# /mnt/c/Users base (non-default Windows mount).
_cowork_skills_dir() {
  if [ -n "${COWORK_SKILLS_ROOT:-}" ]; then
    echo "${COWORK_SKILLS_ROOT}"; return 0
  fi
  local _users="${COWORK_WINDOWS_USERS_ROOT:-/mnt/c/Users}"
  local _pkg="Claude_pzs8sxrjxfjjc"
  # Glob skills-plugin/<orgId>/<accountId>/skills across all Windows users.
  local _hit
  for _hit in "${_users}"/*/AppData/Local/Packages/"${_pkg}"/LocalCache/Roaming/Claude/local-agent-mode-sessions/skills-plugin/*/*/skills; do
    [ -d "${_hit}" ] && { echo "${_hit}"; return 0; }
  done
  return 1  # Cowork not installed, or no local-agent session has created the plugin dir yet
}

# _detect_unmapped_install_candidates: the wizard-was-orphan fix
# (reinforcement_zero-friction-setup-is-product-law's own named example:
# "o wizard multi-client (hivemind install) existindo mas ÓRFÃO — nunca
# oferecido."). Reuses the SAME detection `hivemind install` already has
# (Antigravity via ANTIGRAVITY_WINDOWS_USERS_ROOT/*/.gemini/config, Cowork
# via _cowork_skills_dir) to print a one-line, NON-BLOCKING advisory for any
# target that is DETECTED on this machine but not yet wired — the offer
# itself IS the discovery mechanism, no forced prompt, no hidden subcommand
# to stumble onto. "Already wired" per target:
#   - antigravity: its resolved mcp_config.json path already has a
#     port-map.json entry (_port_map_lookup non-empty).
#   - cowork: the boot skill file is already present at the detected
#     skills-plugin dir (no port-map entry exists for this target — it gets
#     client-side skill FILES, not URL wiring — see _install_cowork_skills).
# Never touches disk, never prompts — read-only detection + echo only.
_detect_unmapped_install_candidates() {
  local _wp _unmapped_antigravity=0
  for _wp in "${ANTIGRAVITY_WINDOWS_USERS_ROOT}"/*/.gemini/config; do
    [ -d "${_wp}" ] || continue
    if [ -z "$(_port_map_lookup "${_wp}/mcp_config.json")" ]; then
      _unmapped_antigravity=1
      break
    fi
  done
  if [ "${_unmapped_antigravity}" -eq 1 ]; then
    echo "  Detectado: Antigravity (Windows, via WSL) — conecte com: hivemind install antigravity" >&2
  fi

  local _cw_dir
  if _cw_dir="$(_cowork_skills_dir)" && [ ! -f "${_cw_dir}/hivemind-boot/SKILL.md" ]; then
    echo "  Detectado: Cowork (Claude desktop, via device bridge) — conecte com: hivemind install cowork" >&2
  fi
}

# _maybe_surface_install_candidates: throttled wrapper around
# _detect_unmapped_install_candidates for the ONGOING (post-enrollment)
# surfaces — cmd_open/cmd_start — so a new candidate (e.g. Antigravity
# installed after this machine already enrolled) still gets offered without
# nagging on every single invocation. Gate: a lightweight date marker under
# ~/.engram/cache/ — at most one nudge-check's worth of output per calendar
# day. _setup_mode's own first-enrollment success path calls
# _detect_unmapped_install_candidates directly (unthrottled — that is a
# one-time event, not a repeated invocation to guard against).
_maybe_surface_install_candidates() {
  local _marker="${HOME}/.engram/cache/install-nudge-last-seen"
  local _today
  _today="$(date +%Y-%m-%d 2>/dev/null || echo '')"
  [ -n "${_today}" ] || return 0
  if [ -f "${_marker}" ] && [ "$(cat "${_marker}" 2>/dev/null || echo '')" = "${_today}" ]; then
    return 0
  fi
  _detect_unmapped_install_candidates
  mkdir -p "$(dirname "${_marker}")" 2>/dev/null || true
  printf '%s' "${_today}" > "${_marker}" 2>/dev/null || true
}

# _install_cowork_skills: the Cowork exception to bee7f370. Writes the thin-stub
# skill files (boot + end-session) from the repo into Cowork's skills dir — the
# skills only CALL fos_procedure (the served body stays the single source of
# truth; nothing is inlined). Copies from HIVEMIND_SOURCE_DIR/skills (the clone).
# $1 = destination skills dir, $2 = label.
_install_cowork_skills() {
  local _dir="$1" _label="$2"
  local _src="${HIVEMIND_SOURCE_DIR:-}/skills"
  local -a _skills=(hivemind-boot.SKILL.md hivemind-end-session.SKILL.md)

  local _s
  for _s in "${_skills[@]}"; do
    if [ ! -f "${_src}/${_s}" ]; then
      echo "Erro: skill de origem não encontrada: ${_src}/${_s}" >&2
      echo "      (esperada em HIVEMIND_SOURCE_DIR/skills — clone válido e atualizado?)" >&2
      return 1
    fi
  done

  echo "" >&2
  echo "  Alvo:    ${_label}" >&2
  echo "  Skills:  ${_skills[*]}" >&2
  echo "  Destino: ${_dir}/" >&2
  echo "  $(_dim "Cowork recebe skills client-side (thin-stub que busca fos_procedure) — exceção à bee7f370: a device bridge proxia tools, não os prompts MCP servidos.")" >&2
  printf '  Confirma a escrita? [y/N]: ' >&2
  local _confirm
  if ! IFS= read -r _confirm; then echo "" >&2; return 130; fi
  case "${_confirm}" in
    y | Y | yes | YES | s | S | sim | SIM) ;;
    *) echo "Cancelado — nada escrito." >&2; return 130 ;;
  esac

  if ! mkdir -p "${_dir}"; then
    echo "  $(_err "✗") não foi possível criar ${_dir}" >&2
    return 1
  fi
  # Cowork requires FOLDER-PER-SKILL: <dir>/<stem>/SKILL.md — a flat *.SKILL.md
  # file is NOT discovered. Strip the ".SKILL.md" suffix to get the skill's
  # directory name.
  for _s in "${_skills[@]}"; do
    local _stem="${_s%.SKILL.md}"
    local _skdir="${_dir}/${_stem}"
    if mkdir -p "${_skdir}" && cp "${_src}/${_s}" "${_skdir}/SKILL.md"; then
      echo "  $(_ok "✓") ${_skdir}/SKILL.md" >&2
    else
      echo "  $(_err "✗") falha ao escrever ${_skdir}/SKILL.md" >&2
      return 1
    fi
  done
  echo "  $(_dim "Pronto. No Cowork: invoque a skill hivemind-boot para iniciar e hivemind-end-session para fechar.")" >&2
  echo "  $(_dim "Nota: o [SkillsPlugin] do Cowork faz sync periódico e limpa 'órfãos' — se a skill sumir, rode 'hivemind install' de novo.")" >&2
  return 0
}

# _install_detected: $1 = target id → prints 1 (detected) or 0 (not) on
# stdout. A "not detected" candidate still appears in the picker (labeled
# accordingly) — detection narrows nothing, it only informs the human.
_install_detected() {
  case "$1" in
    cursor)
      [ -d "${HOME}/.cursor" ] && echo 1 || echo 0
      ;;
    antigravity)
      compgen -G "${ANTIGRAVITY_WINDOWS_USERS_ROOT}/*/.gemini/config" > /dev/null 2>&1 && echo 1 || echo 0
      ;;
    cowork)
      # Detected if the MSIX skills-plugin dir resolves (or COWORK_SKILLS_ROOT is
      # set). "not detected" only informs the human; it never narrows the picker.
      _cowork_skills_dir > /dev/null 2>&1 && echo 1 || echo 0
      ;;
    *)
      echo 0
      ;;
  esac
}

# _install_pick_target: renders the detected-candidates menu (+ an always-
# present "manual path" option) and sets _INSTALL_PICKED_ID/_LABEL from an
# explicit numeric choice — never a default, never auto-accepted on a bare
# Enter. Mirrors _pick_project's box/number styling. Returns 130 on
# cancel (Ctrl-C/Ctrl-D), matching this file's existing convention.
_install_pick_target() {
  _INSTALL_PICKED_ID=""; _INSTALL_PICKED_LABEL=""
  _install_target_catalog
  local n="${#_INSTALL_IDS[@]}"
  local -a _det=()
  local i
  for ((i = 0; i < n; i++)); do
    _det+=("$(_install_detected "${_INSTALL_IDS[$i]}")")
  done

  echo "" >&2
  echo "  Clientes MCP locais detectados nesta máquina:" >&2
  for ((i = 0; i < n; i++)); do
    if [ "${_det[$i]}" = "1" ]; then
      printf '   %2d) %-32s %s\n' "$((i + 1))" "${_INSTALL_LABELS[$i]}" "$(_ok "[detectado]")" >&2
    else
      printf '   %2d) %-32s %s\n' "$((i + 1))" "${_INSTALL_LABELS[$i]}" "$(_dim "[não detectado]")" >&2
    fi
  done
  printf '   %2d) Outro (informar o caminho manualmente)\n' "$((n + 1))" >&2
  echo "" >&2

  local _choice
  while :; do
    printf '  → número [1-%d] (Ctrl-C cancela): ' "$((n + 1))" >&2
    if ! IFS= read -r _choice; then
      echo "" >&2
      return 130
    fi
    case "${_choice}" in
      # code-review fix: a >8-digit all-numeric string used to pass this
      # filter and reach the `-ge`/`-le` arithmetic test below, where bash
      # prints a raw "value too large for defined data type" / "integer
      # expression expected" straight to the terminal BEFORE falling through
      # to the friendly "Fora do intervalo" — cosmetic, but jarring, and
      # menus here are never anywhere close to 9 digits long, so this range
      # costs nothing real.
      '' | *[!0-9]* | ?????????*)
        printf '  ✗ Entrada inválida.\n' >&2
        continue
        ;;
    esac
    if [ "${_choice}" -ge 1 ] && [ "${_choice}" -le "$((n + 1))" ]; then
      break
    fi
    printf '  ✗ Fora do intervalo.\n' >&2
  done

  if [ "${_choice}" -eq "$((n + 1))" ]; then
    _INSTALL_PICKED_ID="manual"
    _INSTALL_PICKED_LABEL="Outro (caminho manual)"
  else
    _INSTALL_PICKED_ID="${_INSTALL_IDS[$((_choice - 1))]}"
    _INSTALL_PICKED_LABEL="${_INSTALL_LABELS[$((_choice - 1))]}"
  fi
  return 0
}

# _install_ask_scope: $1 = human label for the chosen target. Sets
# _INSTALL_SCOPE to "global" or "project" from an explicit numeric choice
# (never a default). Returns 130 on cancel.
_install_ask_scope() {
  local _label="$1"
  echo "" >&2
  echo "  Escopo da configuração para ${_label}:" >&2
  echo "   1) Global (todos os projetos deste usuário)" >&2
  printf '   2) Apenas este projeto (diretório atual: %s)\n' "$(pwd)" >&2
  local _choice
  while :; do
    printf '  → número [1-2] (Ctrl-C cancela): ' >&2
    if ! IFS= read -r _choice; then
      echo "" >&2
      return 130
    fi
    case "${_choice}" in
      1) _INSTALL_SCOPE="global"; return 0 ;;
      2) _INSTALL_SCOPE="project"; return 0 ;;
      *) printf '  ✗ Entrada inválida.\n' >&2 ;;
    esac
  done
}

# _install_run: the guided flow itself, WITHOUT the TTY gate (that lives in
# cmd_install, its only caller in production) — kept separate so a test can
# drive it directly with piped stdin ("mock the interactive prompts") without
# fighting a `[ -t 0 ]` check that a pipe can never satisfy. $1 = optional
# target id arg.
_install_run() {
  local _target_arg="${1:-}"

  local -a _INSTALL_IDS=() _INSTALL_LABELS=()
  _install_target_catalog

  local _chosen_id="" _chosen_label=""
  if [ -n "${_target_arg}" ]; then
    if [ "${_target_arg}" = "manual" ]; then
      _chosen_id="manual"; _chosen_label="Outro (caminho manual)"
    else
      local i
      for ((i = 0; i < ${#_INSTALL_IDS[@]}; i++)); do
        if [ "${_INSTALL_IDS[$i]}" = "${_target_arg}" ]; then
          _chosen_id="${_INSTALL_IDS[$i]}"
          _chosen_label="${_INSTALL_LABELS[$i]}"
          break
        fi
      done
      if [ -z "${_chosen_id}" ]; then
        echo "Erro: alvo desconhecido '${_target_arg}'." >&2
        echo "      Alvos suportados: ${_INSTALL_IDS[*]}, manual (caminho informado por você)." >&2
        return 1
      fi
    fi
  else
    local _rc=0
    _install_pick_target || _rc=$?
    if [ "${_rc}" -ne 0 ]; then
      echo "Instalação cancelada." >&2
      return "${_rc}"
    fi
    _chosen_id="${_INSTALL_PICKED_ID}"
    _chosen_label="${_INSTALL_PICKED_LABEL}"
  fi

  # Resolve the candidate path(s) for the chosen target — never fewer/more
  # than what the target structurally supports, never a silent pick among
  # several without asking.
  local -a _paths=()
  case "${_chosen_id}" in
    manual)
      printf 'Caminho completo do arquivo de configuração (ex: /home/voce/.algum-cliente/mcp.json): ' >&2
      local _typed
      if ! IFS= read -r _typed; then
        echo "" >&2
        return 130
      fi
      _typed="$(printf '%s' "${_typed}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      if [ -z "${_typed}" ]; then
        echo "Caminho vazio — nada instalado." >&2
        return 1
      fi
      _paths=("${_typed}")
      ;;
    cursor)
      local _rc=0
      _install_ask_scope "${_chosen_label}" || _rc=$?
      if [ "${_rc}" -ne 0 ]; then
        echo "Instalação cancelada." >&2
        return "${_rc}"
      fi
      if [ "${_INSTALL_SCOPE}" = "project" ]; then
        _paths=("$(pwd)/.cursor/mcp.json")
      else
        _paths=("${HOME}/.cursor/mcp.json")
      fi
      ;;
    cowork)
      # Cowork gets client-side skill FILES (not URL wiring) — see
      # _install_cowork_skills / _cowork_skills_dir. Global-only (the MSIX desktop
      # app applies one account plugin to every session — no per-project scope),
      # so there is no scope to ask. The "path" is the skills-plugin DIRECTORY.
      echo "" >&2
      echo "  $(_dim "Cowork é global-only (o app desktop aplica um único plugin de conta a toda sessão — não há escopo por projeto).")" >&2
      local _cw_dir
      if ! _cw_dir="$(_cowork_skills_dir)"; then
        echo "Erro: diretório de skills do Cowork não encontrado (app não instalado, ou nenhuma sessão local-agent criou o plugin ainda)." >&2
        echo "      Se o caminho for não-padrão, defina COWORK_SKILLS_ROOT e rode de novo." >&2
        return 1
      fi
      _paths=("${_cw_dir}")
      ;;
    antigravity)
      # Global-only — a Windows-side per-user config, there is no
      # per-project equivalent crossing the WSL↔Windows boundary. Stated
      # plainly rather than silently skipped, per the "guided, never
      # assumed" bar even where there is structurally only one scope.
      echo "" >&2
      echo "  $(_dim "Antigravity só suporta configuração global (não há escopo por projeto).")" >&2
      echo "  $(_dim "Antigravity roda nativo no Windows; a URL abaixo (127.0.0.1) atravessa a fronteira WSL↔Windows via o localhost-forwarding PADRÃO do WSL2 — nenhuma ponte/relay adicional é necessária (confirmado em teste real do founder).")" >&2
      local _wp
      for _wp in "${ANTIGRAVITY_WINDOWS_USERS_ROOT}"/*/.gemini/config; do
        [ -d "${_wp}" ] || continue
        _paths+=("${_wp}/mcp_config.json")
      done
      if [ "${#_paths[@]}" -eq 0 ]; then
        echo "Erro: nenhum diretório de configuração do Antigravity encontrado (${ANTIGRAVITY_WINDOWS_USERS_ROOT}/*/.gemini/config)." >&2
        return 1
      fi
      ;;
    *)
      echo "Erro interno: alvo '${_chosen_id}' sem resolução de caminho." >&2
      return 1
      ;;
  esac

  local _final_path
  if [ "${#_paths[@]}" -eq 1 ]; then
    _final_path="${_paths[0]}"
  else
    # More than one structural candidate (e.g. >1 Windows user profile) —
    # guided pick among them, still no default.
    echo "" >&2
    echo "  Mais de um caminho candidato encontrado:" >&2
    local i
    for ((i = 0; i < ${#_paths[@]}; i++)); do
      printf '   %2d) %s\n' "$((i + 1))" "${_paths[$i]}" >&2
    done
    local _idx
    while :; do
      printf '  → número [1-%d] (Ctrl-C cancela): ' "${#_paths[@]}" >&2
      if ! IFS= read -r _idx; then
        echo "" >&2
        return 130
      fi
      case "${_idx}" in
        # code-review fix: same overly-long-digit-string guard as the target
        # picker above — keeps the arithmetic test below from ever seeing a
        # value it can't parse.
        '' | *[!0-9]* | ?????????*)
          printf '  ✗ Entrada inválida.\n' >&2
          continue
          ;;
      esac
      if [ "${_idx}" -ge 1 ] && [ "${_idx}" -le "${#_paths[@]}" ]; then
        _final_path="${_paths[$((_idx - 1))]}"
        break
      fi
      printf '  ✗ Fora do intervalo.\n' >&2
    done
  fi

  # Cowork exception (bee7f370): this target writes a client-side skill FILE,
  # not an mcpServers URL entry — so it bypasses the entire per-target proxy
  # port + device_id + generic-MCP-config machinery below. Its own confirm +
  # write lives in _install_cowork_skills.
  if [ "${_chosen_id}" = "cowork" ]; then
    _install_cowork_skills "${_final_path}" "${_chosen_label:-${_chosen_id}}"
    return $?
  fi

  # Option 2 (fos_decision 1caee6a7, item 18cff9b7): a DEDICATED loopback
  # port + device_id for this exact config path — never PROXY_PORT (that
  # stays the shared/default port for the CLI's OWN self-seed entry only,
  # unchanged). Idempotent: re-running install against an already-mapped
  # path reuses its existing port+id rather than reallocating
  # (_resolve_target_port_and_device_id above).
  #
  # code-review FIX: allocation + port-map.json persistence used to happen
  # HERE, before the y/N confirmation below — so declining ("Cancelado —
  # nada escrito") was a lie: a device_id was already minted and a port
  # already reserved/written to disk regardless of the answer. The prompt
  # below now shows a READ-ONLY preview (_preview_target_port — no lock, no
  # write, no minted device_id); the REAL allocate-or-reuse + persist
  # (_resolve_target_port_and_device_id, lock-protected) only runs AFTER
  # the human confirms, so a decline truly writes nothing.
  local _scope_for_map="${_INSTALL_SCOPE:-}"
  case "${_chosen_id}" in
    antigravity) _scope_for_map="global" ;; # structurally single-scope
    manual)      _scope_for_map="manual" ;;
  esac
  local _preview_port
  if ! _preview_port="$(_preview_target_port "${_final_path}")"; then
    echo "  $(_err "✗") falha ao calcular uma porta dedicada para '${_chosen_id}' — nada escrito." >&2
    return 1
  fi

  echo "" >&2
  echo "  Alvo:    ${_chosen_label:-${_chosen_id}}" >&2
  echo "  Arquivo: ${_final_path}" >&2
  echo "  Porta dedicada: ${_preview_port}" >&2
  echo "  Entrada: mcpServers.engram = {type:\"http\", url:\"https://127.0.0.1:${_preview_port}/v1/mcp\"}" >&2
  if [ "${_chosen_id}" = "antigravity" ] || [ "${_chosen_id}" = "cursor" ]; then
    echo "  $(_dim "Se este cliente roda nativo no Windows (fora do WSL): a URL 127.0.0.1 acima funciona sem ajuste — o WSL2 já encaminha, por padrão, uma porta de loopback do lado Linux para o localhost do Windows (localhost-forwarding). Nenhuma ponte/relay manual é necessária; confirmado em teste real (Cursor + Cowork, founder, 2026-08-08).")" >&2
  fi
  printf '  Confirma a escrita neste caminho? [y/N] ' >&2
  local _confirm
  if ! IFS= read -r _confirm; then
    echo "" >&2
    return 130
  fi
  case "${_confirm}" in
    y | Y | yes | YES | s | S | sim | SIM) ;;
    *)
      echo "Cancelado — nada escrito." >&2
      return 130
      ;;
  esac

  # Confirmed — NOW allocate-or-reuse + persist, atomically (lock-protected,
  # see _resolve_target_port_and_device_id). Under real concurrent installs
  # the committed port could in principle differ from the preview shown
  # above (another install won the race in between); surface that plainly
  # rather than silently writing a config that doesn't match what the human
  # just confirmed.
  local _port_resolved
  if ! _port_resolved="$(_resolve_target_port_and_device_id "${_final_path}" "${_chosen_id}" "${_scope_for_map}")"; then
    echo "  $(_err "✗") falha ao alocar uma porta dedicada para '${_chosen_id}' — nada escrito." >&2
    return 1
  fi
  local _target_port _target_device_id
  _target_port="$(printf '%s' "${_port_resolved}" | cut -f1)"
  _target_device_id="$(printf '%s' "${_port_resolved}" | cut -f2)"
  if [ "${_target_port}" != "${_preview_port}" ]; then
    echo "  $(_dim "(porta ajustada para ${_target_port} — outra instalação reservou ${_preview_port} nesse meio-tempo)")" >&2
  fi

  local _write_err
  if _write_err="$(_write_generic_mcp_config "${_final_path}" "${_target_port}" 2>&1)"; then
    echo "  $(_ok "✓") gravado: ${_final_path} (device_id ${_target_device_id})" >&2
    # Best-effort: tell an already-running daemon about the freshly-mapped
    # port so it's live immediately, no daemon restart needed (item
    # 46d0eeed's POST /internal/proxy/reload). NOT a hard dependency — if
    # the daemon isn't running (or this call fails for any reason), the
    # next _start_proxy spawn reads the full port-map.json at boot anyway.
    # JSON content-type + empty object body: the daemon's global request guard
    # (F2, runtime/src/lib/request-guard.ts) answers 415 to any POST that is
    # not application/json. Harmless to an older daemon, which ignores both.
    curl -sf --max-time 3 -X POST -H "Content-Type: application/json" -d '{}' \
      "http://127.0.0.1:${RUNTIME_PORT}/internal/proxy/reload" > /dev/null 2>&1 || true
  else
    echo "  $(_err "✗") falha ao gravar ${_final_path}" >&2
    # code-review fix: surface the real reason (permission denied, disk
    # full, malformed path, ...) instead of swallowing it — a human is
    # standing at this prompt waiting to know why, not scripting around it.
    [ -n "${_write_err}" ] && echo "      ${_write_err}" >&2
    return 1
  fi

  # ef1c9385 — no local skill/stub file is written for ANY P2 target: per
  # decision bee7f370 the URL+header (server-injected credential) wiring
  # above is sufficient on its own for every target this pass ships. A
  # thin-stub carrier (aea3837b/boot.md's shape — a fetch+inject pointer,
  # never the full procedure body) would only be needed for a FUTURE target
  # whose client cannot discover served MCP prompts/resources on its own —
  # none of today's targets need that, so none is speculatively built here.
  echo "  $(_dim "Nenhum arquivo local de skill/stub foi escrito para '${_chosen_id}' — apenas o wiring de URL acima (decisão bee7f370).")" >&2
  return 0
}

# cmd_install: TTY gate + dispatch to _install_run. The gate lives HERE
# (not inside _install_run) specifically so tests can call _install_run
# directly with piped stdin to exercise the guided flow — the pipe itself
# is never a TTY, so a gate inside _install_run would make that untestable.
# Same fail-closed posture as the slug-picker (cmd_open, F2.3): a target arg
# does NOT bypass this gate — the scope/path confirmation below still needs
# a real terminal, so a non-interactive `hivemind install <target>` would
# only hang or silently fail a `read`, never a safe outcome.
cmd_install() {
  if ! { [ -t 0 ] && [ -t 1 ]; }; then
    echo "Erro: 'hivemind install' é guiado e interativo (sem caminho padrão) — a entrada não é um terminal." >&2
    echo "      Rode 'hivemind install' (ou 'hivemind install <target>') em um terminal interativo." >&2
    exit 1
  fi

  # code-review fix: unlike cmd_open, this command used to write the OTHER
  # client's mcpServers.engram entry (pointing at https://127.0.0.1:${PROXY_PORT})
  # WITHOUT ever ensuring anything is listening on that port — "✓ gravado" with
  # nothing behind it. This machine must already be enrolled (a proxy cannot
  # authenticate without a cert; _setup_mode is an enrollment flow of its own
  # and out of scope for a command whose whole point is "wire up ANOTHER
  # client to the cert THIS one already has") — warn+instruct rather than
  # silently degrade. If enrolled, mirror cmd_open and ensure a healthy
  # proxy is actually up before the guided write below.
  if ! _has_cert; then
    echo "Erro: nenhum certificado encontrado para este usuário — 'hivemind install' conecta OUTRO" >&2
    echo "      cliente ao mesmo proxy que este dispositivo já usa, então este dispositivo precisa" >&2
    echo "      estar inscrito primeiro. Rode 'hivemind' (sem argumentos) para inscrever, depois" >&2
    echo "      tente 'hivemind install' de novo." >&2
    exit 1
  fi
  _start_proxy

  _install_run "$@"
}

# ── hivemind uninstall (impl 3e2c90da, phase U) ─────────────────────────────
# Removes everything install.sh + enrollment + `hivemind install <target>`
# wrote on this machine, component by component:
#   HARNESS (Claude Code layer): $HIVEMIND_HOME/.claude — INCLUDING the
#     isolated Claude Code state (history, projects, sessions, credentials;
#     founder Q4 2026-10-05 "apaga tudo", listed before deletion) — and
#     $HIVEMIND_HOME/bin/hivemind-statusline.py.
#   PROXY (connection layer): the mcpServers.engram entry in every config file
#     recorded in PORT_MAP_FILE (only when it still points at its HiveMind
#     port), the Cowork skill dirs, $HIVEMIND_HOME{,.staging,.last-good}
#     (runtime/, .env), ~/.engram, the system-trusted local HTTPS CA, and the
#     installed `hivemind` binaries (LAST).
# Invariants: the daemon is stopped through its pidfile only (cmd_stop — never
# the port-based _reap_orphan_runtimes); only paths HiveMind itself recorded
# are touched (no filesystem scan); every rm -rf root passes _uninstall_guard;
# no server-side device revoke (founder Q6, out of v1). Seams for tests:
# HIVEMIND_UNINSTALL_BIN_DIRS (colon-separated, like PATH),
# HIVEMIND_SYSTEM_CA_DEST (process env only, snapshotted before the .env
# load into _UNINSTALL_CA_DEST_OVERRIDE; basename must be
# hivemind-local-https-ca.crt; the install-time trust path _trust_local_ca
# keeps the fixed SYSTEM_CA_DEST),
# COWORK_SKILLS_ROOT.

# The system CA path uninstall removes. Test seam scoped to uninstall only.
_uninstall_ca_dest() {
  printf '%s\n' "${_UNINSTALL_CA_DEST_OVERRIDE:-${SYSTEM_CA_DEST}}"
}

# _uninstall_bin_dirs: fills the global array _UNINSTALL_BIN_DIRS from
# HIVEMIND_UNINSTALL_BIN_DIRS (colon-separated) or the install.sh defaults.
# An array, never word-split — dirs may contain spaces.
_uninstall_bin_dirs() {
  _UNINSTALL_BIN_DIRS=()
  if [ -n "${HIVEMIND_UNINSTALL_BIN_DIRS:-}" ]; then
    IFS=: read -ra _UNINSTALL_BIN_DIRS <<< "${HIVEMIND_UNINSTALL_BIN_DIRS}"
  else
    _UNINSTALL_BIN_DIRS=("/usr/local/bin" "${HOME}/.local/bin")
  fi
}

_uninstall_help() {
  cat <<'EOF'
Usage: hivemind uninstall [all|harness] [--yes|-y] [--keep-certs]

  all (default)  Removes everything HiveMind installed on this machine.
  harness        Removes ONLY the Claude Code harness (the list below) plus
                 the update's $HIVEMIND_HOME.staging / .last-good copies
                 (no backup is left), and keeps the proxy running: runtime, .env, ~/.engram, client
                 wiring and the binary stay. Afterwards `hivemind` starts
                 the proxy only. Add it back with: bash install.sh
  (There is no `proxy` alone — the harness depends on the proxy.)

  The full list of paths is printed first; without --yes you are asked to
  confirm [y/N] (a terminal is required — without one, pass --yes).

  Harness (Claude Code layer):
    $HIVEMIND_HOME/.claude — including the ISOLATED Claude Code state
    (history.jsonl, projects/, sessions/, .credentials.json, .claude.json)
    $HIVEMIND_HOME/bin/hivemind-statusline.py
  Proxy (connection layer):
    mcpServers.engram in every client config `hivemind install` wired
    (other servers/keys in those files are kept), Cowork skills
    hivemind-boot / hivemind-end-session, $HIVEMIND_HOME (runtime/, .env),
    $HIVEMIND_HOME.staging / .last-good, the managed update clone
    $HIVEMIND_HOME.src, ~/.engram (certs, device id, cache),
    the system-trusted local HTTPS CA (sudo), the `hivemind` binaries.

  --yes, -y       Do not ask for confirmation.
  --keep-certs    Keep ~/.engram/mtls certs + device-id and the system CA, and
                  the enrollment credentials of .env (MTLS_*, HIVEMIND_OWNER,
                  FOS_API_KEY) in ~/.engram/kept-credentials.env (mode 0600),
                  which install.sh merges back and deletes — re-enroll not
                  needed; port-map.json and the cache go. Only with `all`.

  Never touched: ~/.bun, your personal ~/.claude, ~/.claude.json, ~/.mcp.json,
  your own git clones, shell rc files. No server-side device revoke.
  Same as: bash uninstall.sh [--yes] [--keep-certs] (from the clone).
EOF
}

# Canonical absolute form of a path, without requiring it to exist
# (symlinks resolved).
_uninstall_norm() {
  realpath -m -- "$1" 2>/dev/null || printf '%s\n' "${1%/}"
}

# Same, but the LAST component is not dereferenced — the form `rm -rf` acts on
# (rm on a symlink removes the link, never its target).
_uninstall_norm_link() {
  local _p="${1%/}"
  [ -n "${_p}" ] || _p="/"
  printf '%s/%s\n' "$(_uninstall_norm "$(dirname -- "${_p}")")" "$(basename -- "${_p}")" | sed 's#^//#/#'
}

# Roots approved by _uninstall_guard / _uninstall_root_check. _uninstall_rm
# refuses anything that is not one of them or inside one of them.
_UNINSTALL_ROOTS=()

# _uninstall_root_check <label> <path> <kind>: THE decider for every rm -rf
# root (invariant: uninstall removes only paths HiveMind's own install /
# enroll / setup created). An absent path passes (nothing to remove) and is
# not approved. Kinds and their fingerprint (measured @16bb428):
#   hivemind     — runtime/src/server.ts (install.sh runtime copy),
#                  bin/hivemind-statusline.py or
#                  .claude/hooks/session-end.close-session.js (harness copy);
#                  NOT .claude/settings.json, which any Claude Code project has
#   hivemind-aux — $HIVEMIND_HOME.staging / .last-good: no fingerprint (a
#                  partial staging dir is legit), path rules only
#   engram       — mtls/ (setup.ts enroll), cache/ (runtime log/pid) or
#                  device-id (_resolve_device_id)
#   cowork-skill — SKILL.md (_install_cowork_skills); outside $HOME by design
#                  (Windows MSIX dir), so the inside-$HOME rule does not apply
# Path rules (all kinds but cowork-skill): the RESOLVED path is strictly
# inside the resolved $HOME (never $HOME, never an ancestor, never outside).
# All kinds: never equal to / inside / containing HIVEMIND_SOURCE_DIR, never
# inside a git work tree below $HOME, never containing a .git.
_uninstall_root_check() {
  local _label="$1" _p="$2" _kind="$3" _n _h _s _up
  if [ -z "${_p}" ]; then
    echo "Error: ${_label} is empty — refusing to uninstall." >&2; return 1
  fi
  [ -e "${_p}" ] || [ -L "${_p}" ] || return 0
  _n="$(_uninstall_norm "${_p}")"
  _h="$(_uninstall_norm "${HOME}")"
  if [ "${_kind}" = "managed-src" ]; then
    _uninstall_managed_src_check "${_p}" "${_n}" "${_h}"
    return $?
  fi
  if [ -z "${_n}" ] || [ "${_n}" = "/" ]; then
    echo "Error: ${_label} (${_p}) resolves to '/' — refusing to uninstall." >&2; return 1
  fi
  if [ "${_kind}" != "cowork-skill" ]; then
    case "${_n}" in
      "${_h}"/?*) ;;
      *)
        echo "Error: ${_label} (${_p} → ${_n}) is not strictly inside your home (${_h}) — refusing to uninstall." >&2
        return 1 ;;
    esac
  fi
  if [ -n "${HIVEMIND_SOURCE_DIR:-}" ]; then
    _s="$(_uninstall_norm "${HIVEMIND_SOURCE_DIR}")"
    if [ "${_n}" = "${_s}" ] || [[ "${_n}/" == "${_s}/"* ]] || [[ "${_s}/" == "${_n}/"* ]]; then
      echo "Error: ${_label} (${_n}) overlaps the HiveMind git clone (HIVEMIND_SOURCE_DIR=${_s}) — refusing to uninstall." >&2
      return 1
    fi
  fi
  if [ -e "${_n}/.git" ] || [ -n "$(find "${_n}" -maxdepth 4 -name .git -print -quit 2>/dev/null)" ]; then
    echo "Error: ${_label} (${_n}) is or contains a git repository — refusing to uninstall." >&2
    return 1
  fi
  _up="$(dirname -- "${_n}")"
  while [ "${_up}" != "/" ] && [ "${_up}" != "${_h}" ] && [ -n "${_up}" ]; do
    if [ -e "${_up}/.git" ]; then
      echo "Error: ${_label} (${_n}) is inside a git repository (${_up}) — refusing to uninstall." >&2
      return 1
    fi
    _up="$(dirname -- "${_up}")"
  done
  case "${_kind}" in
    hivemind)
      # HiveMind-specific files install.sh writes (install.sh:191, :198,
      # :223-226) — NOT .claude/settings.json, which any Claude Code project has.
      if [ ! -f "${_n}/runtime/src/server.ts" ] && [ ! -f "${_n}/bin/hivemind-statusline.py" ] \
        && [ ! -f "${_n}/.claude/hooks/session-end.close-session.js" ]; then
        echo "Error: ${_label} (${_n}) has no HiveMind fingerprint (runtime/src/server.ts, bin/hivemind-statusline.py or .claude/hooks/session-end.close-session.js) — refusing to uninstall." >&2
        return 1
      fi ;;
    engram)
      if [ ! -d "${_n}/mtls" ] && [ ! -d "${_n}/cache" ] && [ ! -f "${_n}/device-id" ]; then
        echo "Error: ${_label} (${_n}) has no HiveMind fingerprint (mtls/, cache/ or device-id) — refusing to uninstall." >&2
        return 1
      fi ;;
    cowork-skill)
      if [ ! -f "${_n}/SKILL.md" ]; then
        echo "Error: ${_label} (${_n}) has no SKILL.md — refusing to remove it." >&2
        return 1
      fi ;;
    hivemind-aux) ;;
  esac
  _UNINSTALL_ROOTS+=("$(_uninstall_norm_link "${_p}")" "${_n}")
  return 0
}

# managed-src (item D1) — the ONE git clone uninstall may remove: exactly
# ${HIVEMIND_HOME}.src, strictly inside $HOME, a real dir (not a symlink)
# holding a clone whose origin is the canonical remote (_is_managed_clone),
# not inside another git work tree. It is allowed to BE HIVEMIND_SOURCE_DIR
# (that is what it is for). Anything else at that path is never a refusal of
# the whole uninstall: it is KEPT (_UNINSTALL_SRC_STATE=foreign) and said so.
_UNINSTALL_SRC_STATE=""
_uninstall_managed_src_check() {
  local _p="$1" _n="$2" _h="$3" _up
  _UNINSTALL_SRC_STATE="foreign"
  [ "${_n}" = "$(_uninstall_norm "$(_managed_source_dir)")" ] || return 0
  case "${_n}" in "${_h}"/?*) ;; *) return 0 ;; esac
  _is_managed_clone "${_p}" || return 0
  _up="$(dirname -- "${_n}")"
  while [ "${_up}" != "/" ] && [ "${_up}" != "${_h}" ] && [ -n "${_up}" ]; do
    [ -e "${_up}/.git" ] && return 0
    _up="$(dirname -- "${_up}")"
  done
  _UNINSTALL_SRC_STATE="managed"
  _UNINSTALL_ROOTS+=("$(_uninstall_norm_link "${_p}")" "${_n}")
  return 0
}

# _uninstall_guard: runs BEFORE anything is stopped or removed, on the FINAL
# values (after the $HIVEMIND_HOME/.env re-load at the top of this file, which
# can override HIVEMIND_HOME). Any refusal aborts the whole uninstall.
_uninstall_guard() {
  _UNINSTALL_ROOTS=()
  if [ -z "${HOME:-}" ] || [ "$(_uninstall_norm "${HOME}")" = "/" ]; then
    echo "Error: HOME is empty or '/' — refusing to uninstall." >&2; return 1
  fi
  _uninstall_root_check "HIVEMIND_HOME" "${HIVEMIND_HOME:-}" hivemind || return 1
  _uninstall_root_check "HIVEMIND_HOME.staging" "${HIVEMIND_HOME}.staging" hivemind-aux || return 1
  _uninstall_root_check "HIVEMIND_HOME.last-good" "${HIVEMIND_HOME}.last-good" hivemind-aux || return 1
  _uninstall_root_check "the engram dir" "${HOME}/.engram" engram || return 1
  _UNINSTALL_SRC_STATE=""
  _uninstall_root_check "the managed update clone" "$(_managed_source_dir)" managed-src || return 1
  return 0
}

# _uninstall_guard_harness: the guard for `uninstall harness` — the same
# HOME + HIVEMIND_HOME checks as _uninstall_guard (nothing outside
# $HIVEMIND_HOME is removed, so ~/.engram is neither checked nor approved).
_uninstall_guard_harness() {
  _UNINSTALL_ROOTS=()
  if [ -z "${HOME:-}" ] || [ "$(_uninstall_norm "${HOME}")" = "/" ]; then
    echo "Error: HOME is empty or '/' — refusing to uninstall." >&2; return 1
  fi
  _uninstall_root_check "HIVEMIND_HOME" "${HIVEMIND_HOME:-}" hivemind || return 1
  # The update's staging / rollback copies hold their own .claude (credentials,
  # history) — approved (path rules only) so they go ENTIRELY: no backup of
  # the harness is left behind (founder 2026-10-05, finding b354891e).
  _uninstall_root_check "HIVEMIND_HOME.staging" "${HIVEMIND_HOME}.staging" hivemind-aux || return 1
  _uninstall_root_check "HIVEMIND_HOME.last-good" "${HIVEMIND_HOME}.last-good" hivemind-aux || return 1
  if [ ! -d "${HIVEMIND_HOME}" ]; then
    echo "Error: HiveMind is not installed here (${HIVEMIND_HOME} not found)." >&2; return 1
  fi
  return 0
}

# _uninstall_rm <path>: rm -rf one path if present — ONLY when it is an
# approved root or inside one (no removal bypasses _uninstall_guard). One line
# per removal; a failure or refusal is reported and skipped, never fatal.
_uninstall_rm() {
  local _p="$1" _c _r _ok=0
  [ -e "${_p}" ] || [ -L "${_p}" ] || return 0
  _c="$(_uninstall_norm_link "${_p}")"
  for _r in "${_UNINSTALL_ROOTS[@]+"${_UNINSTALL_ROOTS[@]}"}"; do
    if [ "${_c}" = "${_r}" ] || [[ "${_c}" == "${_r}/"* ]]; then _ok=1; break; fi
  done
  if [ "${_ok}" != "1" ]; then
    echo "  ! not removing ${_p}: outside every guarded HiveMind root" >&2
    return 0
  fi
  if rm -rf -- "${_p}" 2>/dev/null && ! { [ -e "${_p}" ] || [ -L "${_p}" ]; }; then
    echo "  removed: ${_p}"
  else
    echo "  ! could not remove ${_p} — remove it by hand" >&2
    _UNINSTALL_FAILED=1  # F8: a failed removal → exit 1 (same as Windows)
  fi
  return 0
}

# _uninstall_port_map_entries: "<port>\t<path>" per PORT_MAP_FILE entry.
# Absent file → nothing; unreadable/corrupted → exit 2.
_uninstall_port_map_entries() {
  [ -f "${PORT_MAP_FILE}" ] || return 0
  bun -e '
    import { readFileSync } from "node:fs";
    let doc;
    try { doc = JSON.parse(readFileSync(process.argv[1], "utf8")); } catch { process.exit(2); }
    const entries = Array.isArray(doc?.entries) ? doc.entries : null;
    if (!entries) process.exit(2);
    for (const e of entries) {
      if (e && typeof e.path === "string" && e.path && Number.isInteger(e.port)) {
        console.log(`${e.port}\t${e.path}`);
      }
    }
  ' "${PORT_MAP_FILE}" 2>/dev/null
}

# _uninstall_unwire_target <path> <port>: merge-safe removal of
# mcpServers.engram from one recorded config file — ONLY when its url is
# exactly the one HiveMind wrote for that port; every other key/server is
# kept; atomic tmp+rename with the original mode preserved. Prints one
# "<status>\t<message>" line: changed | warn | skip. Never aborts the caller.
_uninstall_unwire_target() {
  bun -e '
    import { existsSync, readFileSync, writeFileSync, renameSync, chmodSync, statSync, realpathSync, unlinkSync } from "node:fs";
    const recorded = process.argv[1];
    const want = `https://127.0.0.1:${process.argv[2]}/v1/mcp`;
    const out = (s, m) => { console.log(`${s}\t${m}`); process.exit(0); };
    if (!existsSync(recorded)) out("skip", "file not found");
    // A symlinked config is edited at its real target; the link stays a link.
    const p = realpathSync(recorded);
    let doc;
    try { doc = JSON.parse(readFileSync(p, "utf8")); } catch { out("skip", "not valid JSON — left as is"); }
    if (typeof doc !== "object" || doc === null || Array.isArray(doc)) out("skip", "not a JSON object — left as is");
    const servers = doc.mcpServers;
    if (typeof servers !== "object" || servers === null || Array.isArray(servers) || !("engram" in servers)) {
      out("skip", "no mcpServers.engram entry");
    }
    const url = servers.engram && typeof servers.engram === "object" ? servers.engram.url : undefined;
    if (url !== want) {
      out("warn", `mcpServers.engram points at ${JSON.stringify(url ?? null)}, not ${want} — not removed (changed after install)`);
    }
    delete servers.engram;
    const mode = statSync(p).mode & 0o777;
    const tmp = `${p}.tmp-${process.pid}`;
    try {
      writeFileSync(tmp, JSON.stringify(doc, null, 2) + "\n", { mode });
      renameSync(tmp, p);
    } catch (e) {
      try { unlinkSync(tmp); } catch { /* never created */ }
      out("warn", `edit failed (file left as is): ${e && e.message ? e.message : e}`);
    }
    // The edit landed; a chmod failure only means the mode was not restored.
    try { chmodSync(p, mode); } catch (e) {
      out("changed", `removed mcpServers.engram (mode not restored: ${e && e.message ? e.message : e})`);
    }
    out("changed", "removed mcpServers.engram");
  ' "$1" "$2" 2>&1
}

# _uninstall_targets: target wiring recorded in PORT_MAP_FILE + Cowork skill
# dirs. MUST run before ~/.engram is removed (port-map.json lives there).
_uninstall_targets() {
  if [ -f "${PORT_MAP_FILE}" ]; then
    if ! command -v bun > /dev/null 2>&1; then
      echo "  ! bun not found — cannot unwire the clients recorded in ${PORT_MAP_FILE};" >&2
      echo "    remove the mcpServers.engram entry from them by hand." >&2
      _UNINSTALL_FAILED=1
    else
      local _entries="" _rc=0
      _entries="$(_uninstall_port_map_entries)" || _rc=$?
      if [ "${_rc}" -ne 0 ]; then
        echo "  $(_dim "skip: ${PORT_MAP_FILE} is unreadable — no client config unwired")"
      else
        local _port _path _res _status _msg
        while IFS=$'\t' read -r _port _path; do
          [ -n "${_path}" ] || continue
          if _res="$(_uninstall_unwire_target "${_path}" "${_port}")"; then
            _status="${_res%%$'\t'*}"; _msg="${_res#*$'\t'}"
          else
            _status="warn"; _msg="edit failed: ${_res}"
          fi
          # F8: an entry that could not be removed fails the uninstall; a
          # deliberate "changed after install" refusal does not.
          case "${_status}:${_msg}" in warn:"edit failed"*) _UNINSTALL_FAILED=1 ;; esac
          case "${_status}" in
            changed) echo "  removed: mcpServers.engram from ${_path}${_msg#removed mcpServers.engram}" ;;
            warn)    echo "  ! ${_path}: ${_msg}" >&2 ;;
            *)       echo "  $(_dim "skip: ${_path} (${_msg})")" ;;
          esac
        done <<< "${_entries}"
      fi
    fi
  fi

  local _cw="" _s
  if _cw="$(_cowork_skills_dir 2>/dev/null)" && [ -n "${_cw}" ] && [ "$(_uninstall_norm "${_cw}")" != "/" ]; then
    for _s in hivemind-boot hivemind-end-session; do
      if _uninstall_root_check "Cowork skill ${_s}" "${_cw}/${_s}" cowork-skill; then
        _uninstall_rm "${_cw}/${_s}"
      fi
    done
  fi
  return 0
}

_uninstall_harness() {
  _uninstall_rm "${HIVEMIND_HOME}/.claude"
  _uninstall_rm "${HIVEMIND_HOME}/bin/hivemind-statusline.py"
  return 0
}

# _uninstall_system_ca: sudo best-effort; any failure (no sudo, no TTY for a
# password, no update-ca-certificates) prints the manual commands, never fatal.
_uninstall_system_ca() {
  local _ca
  _ca="$(_uninstall_ca_dest)"
  [ -e "${_ca}" ] || [ -L "${_ca}" ] || return 0
  if [ "$(basename -- "${_ca}")" != "hivemind-local-https-ca.crt" ]; then
    echo "  ! not removing ${_ca}: the system CA file must be named hivemind-local-https-ca.crt" >&2
    return 0
  fi
  # Only HiveMind's own CA: the system copy must be byte-identical to the
  # local HTTPS CA it was copied from (_trust_local_ca: sudo cp). Must run
  # BEFORE ~/.engram (which holds LOCAL_HTTPS_CA) is removed.
  if [ ! -f "${LOCAL_HTTPS_CA}" ] || ! cmp -s -- "${LOCAL_HTTPS_CA}" "${_ca}"; then
    if [ ! -f "${LOCAL_HTTPS_CA}" ]; then
      echo "  ! ${_ca} not removed automatically: the local HTTPS CA (${LOCAL_HTTPS_CA}) is gone, so it cannot be verified as HiveMind's." >&2
    else
      echo "  ! ${_ca} not removed automatically: its content does not match HiveMind's local HTTPS CA." >&2
    fi
    echo "    If it is HiveMind's, run:" >&2
    echo "      sudo rm -f ${_ca}" >&2
    echo "      sudo update-ca-certificates" >&2
    return 0
  fi
  local -a _sudo=(sudo)
  _is_interactive || _sudo=(sudo -n)
  if ! command -v sudo > /dev/null 2>&1 || ! "${_sudo[@]}" rm -f "${_ca}" > /dev/null 2>&1; then
    echo "  ! could not remove the system-trusted local HTTPS CA automatically — run:" >&2
    echo "      sudo rm -f ${_ca}" >&2
    echo "      sudo update-ca-certificates" >&2
    _UNINSTALL_FAILED=1
    return 0
  fi
  echo "  removed: ${_ca}"
  if ! "${_sudo[@]}" update-ca-certificates > /dev/null 2>&1; then
    echo "  ! update-ca-certificates failed — run: sudo update-ca-certificates" >&2
    _UNINSTALL_FAILED=1
  fi
  return 0
}

# _keep_credentials: --keep-certs (blocker 3b7a507e a). The cert files alone do
# not bring the proxy back: MTLS_CERT_PATH/KEY_PATH/CA_PATH, HIVEMIND_OWNER and
# FOS_API_KEY live in $HIVEMIND_HOME/.env, which this uninstall removes. Those
# lines (MTLS_* + HIVEMIND_OWNER + FOS_API_KEY, nothing else) go to
# KEPT_CREDENTIALS_FILE, written 0600 via tmp+mv and then CHECKED (mode 600,
# owned by us) — on any failure the file is deleted and the uninstall reports
# that re-enrollment will be needed. Values are never printed. Must run BEFORE
# the .env is removed.
_keep_credentials() {
  local _env="${HIVEMIND_HOME}/.env" _lines _n _tmp _mode
  [ -f "${_env}" ] || return 0
  [ -d "$(dirname "${KEPT_CREDENTIALS_FILE}")" ] || return 0
  _lines="$(sed -nE 's/^[[:space:]]+//; /^(MTLS_[A-Z0-9_]+|HIVEMIND_OWNER|FOS_API_KEY)=/p' "${_env}" 2>/dev/null || true)"
  [ -n "${_lines}" ] || return 0
  _n="$(printf '%s\n' "${_lines}" | grep -c .)"
  _tmp="${KEPT_CREDENTIALS_FILE}.tmp.$$"
  if ! ( umask 077
         { echo "# HiveMind — enrollment credentials kept by 'hivemind uninstall --keep-certs'."
           echo "# install.sh merges them back into \$HIVEMIND_HOME/.env and deletes this file."
           printf '%s\n' "${_lines}"; } > "${_tmp}" ) 2>/dev/null \
     || ! chmod 600 "${_tmp}" 2>/dev/null \
     || ! mv -f "${_tmp}" "${KEPT_CREDENTIALS_FILE}" 2>/dev/null; then
    rm -f "${_tmp}"
    echo "  ! could not keep the enrollment credentials — after reinstalling, re-enroll (run hivemind)." >&2
    _UNINSTALL_FAILED=1
    return 0
  fi
  _mode="$(stat -c '%a' "${KEPT_CREDENTIALS_FILE}" 2>/dev/null || stat -f '%Lp' "${KEPT_CREDENTIALS_FILE}" 2>/dev/null || echo '?')"
  if [ "${_mode}" != "600" ] || [ ! -O "${KEPT_CREDENTIALS_FILE}" ]; then
    rm -f "${KEPT_CREDENTIALS_FILE}"
    echo "  ! ${KEPT_CREDENTIALS_FILE} did not end up private (mode ${_mode}, want 600) — the enrollment credentials were NOT kept; after reinstalling, re-enroll (run hivemind)." >&2
    _UNINSTALL_FAILED=1
    return 0
  fi
  echo "  kept:    the enrollment credentials of .env (${_n} keys) in ${KEPT_CREDENTIALS_FILE} (--keep-certs)"
}

# _uninstall_proxy <keep_certs>
_uninstall_proxy() {
  local _keep="$1" _engram="${HOME}/.engram" _e
  if [ "${_keep}" = "1" ]; then _keep_credentials; fi
  _uninstall_rm "${HIVEMIND_HOME}/runtime"
  _uninstall_rm "${HIVEMIND_HOME}/.env"
  _uninstall_rm "${HIVEMIND_HOME}"
  _uninstall_rm "${HIVEMIND_HOME}.staging"
  _uninstall_rm "${HIVEMIND_HOME}.last-good"
  case "${_UNINSTALL_SRC_STATE}" in
    managed) _uninstall_rm "$(_managed_source_dir)" ;;
    foreign) echo "  kept:    $(_managed_source_dir) (not a HiveMind-managed clone)" ;;
  esac
  if [ "${_keep}" = "1" ]; then
    for _e in "${_engram}"/* "${_engram}"/.[!.]* "${_engram}"/..?*; do
      [ -e "${_e}" ] || [ -L "${_e}" ] || continue
      case "$(basename "${_e}")" in
        mtls | device-id | device-id-cert-binding | kept-credentials.env) continue ;;
      esac
      _uninstall_rm "${_e}"
    done
    for _e in "${PORT_MAP_FILE}" "${PORT_MAP_FILE}".*; do
      _uninstall_rm "${_e}"
    done
    echo "  kept:    ${CERT_DIR} certs + device-id, $(_uninstall_ca_dest) (--keep-certs)"
  else
    _uninstall_system_ca  # before ~/.engram: it compares against LOCAL_HTTPS_CA
    _uninstall_rm "${_engram}"
  fi
  return 0
}

# _uninstall_binaries: LAST. Unwritable → print the sudo command, continue.
# Copies elsewhere on PATH (_all_installed_bins) → warned, never removed.
_uninstall_binaries() {
  local _d _f _b _skip _norm_dirs=() _manual=()
  _uninstall_bin_dirs
  for _d in "${_UNINSTALL_BIN_DIRS[@]+"${_UNINSTALL_BIN_DIRS[@]}"}"; do
    _norm_dirs+=("$(_uninstall_norm "${_d}")")
    for _f in "${_d}/hivemind" "${_d}/hivemind.last-good" "${_d}/hivemind.new"; do
      [ -e "${_f}" ] || [ -L "${_f}" ] || continue
      if [ -w "${_d}" ] && rm -f -- "${_f}" 2>/dev/null; then
        echo "  removed: ${_f}"
      else
        _manual+=("${_f}")
      fi
    done
  done
  if [ "${#_manual[@]}" -gt 0 ]; then
    echo "  ! no permission to remove — run: sudo rm -f ${_manual[*]}" >&2
    _UNINSTALL_FAILED=1
  fi
  local _bins
  _bins="$(_all_installed_bins || true)"
  while IFS= read -r _b; do
    [ -n "${_b}" ] || continue
    _skip=0
    for _d in "${_norm_dirs[@]+"${_norm_dirs[@]}"}"; do
      [ "$(_uninstall_norm "$(dirname "${_b}")")" = "${_d}" ] && _skip=1
    done
    [ "${_skip}" = "1" ] && continue
    echo "  ! another 'hivemind' is still on PATH: ${_b} — not removed (outside ${HIVEMIND_UNINSTALL_BIN_DIRS:-/usr/local/bin:${HOME}/.local/bin}); remove it by hand if it is a stale copy" >&2
  done <<< "${_bins}"
  return 0
}

# _uninstall_list <path>: one plan line per existing path (dirs end in /).
_uninstall_list() {
  local _p="$1"
  [ -e "${_p}" ] || [ -L "${_p}" ] || return 0
  if [ -d "${_p}" ] && [ ! -L "${_p}" ]; then echo "    ${_p}/"; else echo "    ${_p}"; fi
}

# _uninstall_plan_harness_lines: the harness section of the plan (shared by
# `uninstall all` and `uninstall harness`).
_uninstall_plan_harness_lines() {
  local _e
  echo "  Harness (Claude Code layer):"
  if [ -d "${HIVEMIND_HOME}/.claude" ]; then
    echo "    ${HIVEMIND_HOME}/.claude/ — harness files AND the isolated Claude Code state"
    echo "      (history, projects, sessions, credentials) — contents:"
    for _e in "${HIVEMIND_HOME}/.claude"/* "${HIVEMIND_HOME}/.claude"/.[!.]*; do
      [ -e "${_e}" ] || [ -L "${_e}" ] || continue
      if [ -d "${_e}" ]; then echo "      ${_e}/"; else echo "      ${_e}"; fi
    done
  fi
  _uninstall_list "${HIVEMIND_HOME}/bin/hivemind-statusline.py"
  return 0
}

# _uninstall_plan <keep_certs>: the full path list, printed BEFORE anything
# is removed (with or without --yes).
_uninstall_plan() {
  local _keep="$1" _e _d _f _cw=""
  echo "HiveMind — uninstall. This removes:"
  echo ""
  _uninstall_plan_harness_lines
  echo ""
  echo "  Proxy (connection layer):"
  echo "    daemon: stopped through its pidfile (${RUNTIME_PID_FILE})"
  if [ -f "${PORT_MAP_FILE}" ] && command -v bun > /dev/null 2>&1; then
    local _port _path _entries=""
    _entries="$(_uninstall_port_map_entries)" || _entries=""
    if [ -n "${_entries}" ]; then
      echo "    mcpServers.engram (only if still pointing at its HiveMind port; other keys kept) in:"
      while IFS=$'\t' read -r _port _path; do
        [ -n "${_path}" ] && echo "      ${_path} (port ${_port})"
      done <<< "${_entries}"
    fi
  fi
  if _cw="$(_cowork_skills_dir 2>/dev/null)" && [ -n "${_cw}" ]; then
    _uninstall_list "${_cw}/hivemind-boot"
    _uninstall_list "${_cw}/hivemind-end-session"
  fi
  _uninstall_list "${HIVEMIND_HOME}/runtime"
  _uninstall_list "${HIVEMIND_HOME}/.env"
  _uninstall_list "${HIVEMIND_HOME}"
  _uninstall_list "${HIVEMIND_HOME}.staging"
  _uninstall_list "${HIVEMIND_HOME}.last-good"
  case "${_UNINSTALL_SRC_STATE}" in
    managed) echo "    $(_managed_source_dir)/ — the managed update clone" ;;
    foreign) echo "    (keeping $(_managed_source_dir): not a HiveMind-managed clone)" ;;
  esac
  if [ "${_keep}" = "1" ]; then
    if [ -d "${HOME}/.engram" ]; then
      echo "    ${HOME}/.engram/ except mtls/ certs + device-id (port-map.json and cache DO go)"
    fi
    if [ -f "${HIVEMIND_HOME}/.env" ]; then
      echo "    (the enrollment credentials of .env — MTLS_*, HIVEMIND_OWNER, FOS_API_KEY — are kept in ${KEPT_CREDENTIALS_FILE} for the reinstall)"
    fi
  else
    _uninstall_list "${HOME}/.engram"
    [ -e "$(_uninstall_ca_dest)" ] && echo "    $(_uninstall_ca_dest) (system CA store, via sudo)"
  fi
  _uninstall_bin_dirs
  for _d in "${_UNINSTALL_BIN_DIRS[@]+"${_UNINSTALL_BIN_DIRS[@]}"}"; do
    for _f in "${_d}/hivemind" "${_d}/hivemind.last-good" "${_d}/hivemind.new"; do
      _uninstall_list "${_f}"
    done
  done
  _autostart_plan_lines
  echo ""
  echo "  Kept: ~/.bun, your personal ~/.claude, ~/.claude.json, ~/.mcp.json, the git clone, shell rc files."
  echo ""
  return 0
}

# _uninstall_harness_only <yes>: `hivemind uninstall harness` (phase S5).
# Removes the harness (the whole $HIVEMIND_HOME/.claude — incl. the isolated
# Claude Code state, founder Q4 "apaga tudo", listed first — and the
# statusline) and the update's ${HIVEMIND_HOME}.staging / .last-good copies
# ENTIRELY (no backup left — finding b354891e) through the same guarded
# _uninstall_rm, then writes marker "proxy". The daemon is NOT stopped; runtime/, .env, ~/.engram, client
# wiring and the binaries are not touched. `hivemind update` then stages no
# harness file (S3) and `hivemind` starts the proxy only (S4).
_uninstall_harness_only() {
  local _yes="$1" _ans="" _marker _tmp
  _uninstall_guard_harness || exit 1

  if [ "${_yes}" != "1" ] && ! _is_interactive; then
    echo "Error: 'hivemind uninstall harness' asks for confirmation and the input is not a terminal." >&2
    echo "       Run it in an interactive terminal, or pass --yes to skip the confirmation." >&2
    exit 1
  fi

  echo "HiveMind — uninstall the Claude Code harness. This removes:"
  echo ""
  _uninstall_plan_harness_lines
  local _aux
  for _aux in "${HIVEMIND_HOME}.staging" "${HIVEMIND_HOME}.last-good"; do
    _uninstall_list "${_aux}"
  done
  echo "    (update staging / rollback copies — removed entirely, no backup is left)"
  echo ""
  echo "  Kept (the proxy keeps working): the running daemon, ${HIVEMIND_HOME}/runtime,"
  echo "  ${HIVEMIND_HOME}/.env, ~/.engram (certs, device id), client wiring, the 'hivemind' binary."
  echo ""

  if [ "${_yes}" != "1" ]; then
    printf 'Remove the harness? [y/N] '
    IFS= read -r _ans || _ans=""
    case "${_ans}" in
      y | Y | yes | YES | s | S | sim | SIM) ;;
      *) echo "Aborted — nothing removed."; return 0 ;;
    esac
  fi

  echo ""
  _uninstall_harness
  for _aux in "${HIVEMIND_HOME}.staging" "${HIVEMIND_HOME}.last-good"; do
    _uninstall_rm "${_aux}"
  done
  _marker="$(_components_file)"
  _tmp="${_marker}.tmp-$$"
  if printf 'proxy\n' > "${_tmp}" && mv -f "${_tmp}" "${_marker}"; then
    echo "  marked:  ${_marker} = proxy"
  else
    rm -f "${_tmp}" 2>/dev/null || true
    echo "  ! could not write ${_marker} — 'hivemind' would still try to open Claude Code;" >&2
    echo "    write it by hand: echo proxy > ${_marker}" >&2
    exit 1
  fi

  echo ""
  if [ "${_UNINSTALL_FAILED:-0}" = "1" ]; then
    echo "Some steps failed (see the '!' lines above)." >&2
    return 1
  fi
  echo "Harness removed. The proxy is untouched: 'hivemind' now starts the proxy only and prints"
  echo "how to connect your MCP client. Add the harness back: bash install.sh (from the clone)."
  return 0
}

cmd_uninstall() {
  local _yes=0 _keep=0 _a _ans="" _component=""
  _UNINSTALL_FAILED=0
  for _a in "$@"; do
    case "${_a}" in
      -y | --yes)   _yes=1 ;;
      --keep-certs) _keep=1 ;;
      all | harness)
        if [ -n "${_component}" ]; then
          echo "Error: name one component — 'hivemind uninstall all' or 'hivemind uninstall harness'." >&2
          exit 1
        fi
        _component="${_a}" ;;
      proxy)
        echo "Error: the proxy cannot be removed on its own — the harness depends on it." >&2
        echo "       Remove everything: hivemind uninstall all   ·   only the harness: hivemind uninstall harness" >&2
        exit 1 ;;
      -h | --help)  _uninstall_help; return 0 ;;
      *)
        echo "Error: unknown argument '${_a}' for 'hivemind uninstall'." >&2
        echo "       Usage: hivemind uninstall [all|harness] [--yes|-y] [--keep-certs]" >&2
        exit 1 ;;
    esac
  done

  if [ "${_component}" = "harness" ]; then
    if [ "${_keep}" = "1" ]; then
      echo "Error: --keep-certs only applies to 'hivemind uninstall all' (the harness holds no certs)." >&2
      exit 1
    fi
    _uninstall_harness_only "${_yes}" || return 1
    return 0
  fi

  _uninstall_guard || exit 1

  if [ "${_yes}" != "1" ] && ! _is_interactive; then
    echo "Error: 'hivemind uninstall' asks for confirmation and the input is not a terminal." >&2
    echo "       Run it in an interactive terminal, or pass --yes to skip the confirmation." >&2
    exit 1
  fi

  _uninstall_plan "${_keep}"

  if [ "${_yes}" != "1" ]; then
    printf 'Remove all of the above? [y/N] '
    IFS= read -r _ans || _ans=""
    case "${_ans}" in
      y | Y | yes | YES | s | S | sim | SIM) ;;
      *) echo "Aborted — nothing removed."; return 0 ;;
    esac
  fi

  echo ""
  _autostart_remove uninstall  # before the stop: the unit's ExecStop stops the daemon too
  cmd_stop || true
  _uninstall_targets
  _uninstall_harness
  _uninstall_proxy "${_keep}"
  _uninstall_binaries

  echo ""
  echo "HiveMind uninstalled. Kept on purpose: ~/.bun, your personal ~/.claude, ~/.claude.json,"
  if [ "${_UNINSTALL_SRC_STATE}" = "managed" ] \
    && [ "$(_uninstall_norm "${HIVEMIND_SOURCE_DIR:-}")" = "$(_uninstall_norm "$(_managed_source_dir)")" ]; then
    # The pinned source WAS the managed clone, removed above — not "kept".
    echo "~/.mcp.json, your own git clones, shell rc files."
  else
    echo "~/.mcp.json, the git clone${HIVEMIND_SOURCE_DIR:+ (${HIVEMIND_SOURCE_DIR})}, shell rc files."
  fi
  echo "Not done: no server-side revoke — this device's record stays on the engram."
  echo "Reinstall: bash install.sh, then run 'hivemind'."
  if [ "${_UNINSTALL_FAILED}" = "1" ]; then
    echo "Some steps failed (see the '!' lines above)." >&2
    return 1
  fi
  return 0
}

# ── Entry point ───────────────────────────────────────────────────────────────

# Parse --verbose anywhere in argv; strip it before subcommand dispatch (it's
# a global flag, not a subcommand argument).
_VERBOSE=0
_ARGS=()
for _arg in "$@"; do
  case "${_arg}" in
    --verbose) _VERBOSE=1 ;;
    *) _ARGS+=("${_arg}") ;;
  esac
done
set -- "${_ARGS[@]+"${_ARGS[@]}"}"

case "${1:-}" in
  start)          shift || true; cmd_start ;;
  stop)           shift || true; cmd_stop ;;
  restart)        shift || true; cmd_restart ;;
  status)         shift || true; cmd_status ;;
  health)         shift || true; cmd_health ;;
  update)         shift || true; _HM_EXPLICIT_UPDATE=1; cmd_update ;;
  resume)         shift || true; cmd_resume "$@" ;;
  install)        shift || true; cmd_install "$@" ;;
  uninstall)      shift || true; cmd_uninstall "$@" ;;
  autostart)      shift || true; cmd_autostart "$@" ;;
  --version|-v)   cmd_version ;;
  --help|-h)      cmd_help ;;
  *)              cmd_open "$@" ;;
esac
