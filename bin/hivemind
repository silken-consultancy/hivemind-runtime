#!/usr/bin/env bash
# hivemind — HiveMind thin CLI.
#
# Analogous to silken-runtime but standalone — zero lab deps.
# Runs in the user's project directory; slug = explicit arg or interactive
# picker (fail-closed if non-interactive — no basename(cwd) fallback).
#
# Cross-platform note: this file is the ONLY Unix-specific layer — the
# daemon it spawns (runtime/src/server.ts) is plain portable TS/Bun. See
# docs/ARCHITECTURE.md for the 4 Unix-specific primitives named here
# (detach, pidfile+signals, $HOME paths, bash-as-CLI) and how a future
# native-Windows port would replace this file without touching the daemon.
#
# Usage:
#   hivemind [<slug>]     # start proxy + exec claude; slug = arg or interactive picker
#   hivemind start        # start proxy only (no claude)
#   hivemind stop         # stop the proxy
#   hivemind restart      # stop + start (best-effort; re-reads ~/.hivemind/.env)
#   hivemind status       # proxy health + cert validity (human-readable)
#   hivemind health       # same checks as status, script-friendly exit code (0/1/2)
#   hivemind update       # pull-agent: staged+verified+atomic update, auto-rollback
#   hivemind resume <slug>  # explicit crash recovery: close a dead-holder session, then open
#   hivemind install [<target>]  # guided setup of another local MCP client (Cursor,
#                          # Antigravity, ...) — interactive only, NO default path ever
#   hivemind --version    # print version and exit
#   hivemind --verbose [...]  # show startup/debug logs (default: quiet, GO/NO-GO only)

set -euo pipefail

HIVEMIND_VERSION="0.1.0"
HIVEMIND_HOME="${HIVEMIND_HOME:-$HOME/.hivemind}"
RUNTIME_PORT="${AR_PORT:-7777}"
PROXY_PORT="${MTLS_PROXY_PORT:-7779}"
# Product state lives under ~/.engram — a dedicated, hidden dir with zero
# shared footprint: other tooling on the same machine must never collide
# with this product on cert material or cache/pid files.
RUNTIME_LOG="${HOME}/.engram/cache/hivemind-runtime.log"
RUNTIME_PID_FILE="${HOME}/.engram/cache/hivemind-runtime.pid"
# Leftover-session pidfile from an interrupted --setup-only run (see _setup_mode
# / cmd_stop hardening, item 4.2) — best-effort cleanup, not fatal if absent.
SETUP_PID_FILE="${HOME}/.engram/cache/hivemind-setup.pid"
CERT_DIR="${HOME}/.engram/mtls"
RUNTIME_BIN="${HIVEMIND_HOME}/runtime/src/server.ts"
# `hivemind install`'s Antigravity candidate — the WSL↔Windows bridge root
# (measured, 62e96c8e item 4.4: Windows-side config lives at
# <root>/<user>/.gemini/config/mcp_config.json). Overridable so tests can
# point detection at a fixture tree instead of a real /mnt/c mount.
ANTIGRAVITY_WINDOWS_USERS_ROOT="${ANTIGRAVITY_WINDOWS_USERS_ROOT:-/mnt/c/Users}"
# Local HTTPS loopback listener cert (round-2, item 1.1(B)/1.4, founder
# 2026-07-30) — generated lazily by mtls-proxy.ts under this subdir, DISTINCT
# from CERT_DIR's enrollment client cert. Trusted into the WSL/Linux system
# store here so a strict-TLS IDE client validates it without a skip-verify
# flag (see _trust_local_ca).
LOCAL_HTTPS_CA="${HOME}/.engram/mtls/local-https/ca.cert.pem"
SYSTEM_CA_DEST="/usr/local/share/ca-certificates/hivemind-local-https-ca.crt"

# One-time endpoint migration (2026-07-21): hivemind.silken.ia.br → hivemind.ia.br.
# The product endpoints moved to hivemind.ia.br (the silken.ia.br product blocks are
# being retired). Rewrite a pre-migration ~/.hivemind/.env IN PLACE so an already-
# enrolled client repoints automatically (reached via the update channel while the old
# manifest is still served). Only the HOST changes — the enrolled cert is issued by the
# same product CA and the :4443 server cert now carries a hivemind.ia.br SAN, so no
# re-enrollment is needed. Idempotent: a no-op once migrated.
if [ -f "${HIVEMIND_HOME}/.env" ] && grep -q 'hivemind\.silken\.ia\.br:4443' "${HIVEMIND_HOME}/.env" 2>/dev/null; then
  _mig_bak="${HIVEMIND_HOME}/.env.pre-hivemind-ia.$(date +%Y%m%d%H%M%S)"
  if cp "${HIVEMIND_HOME}/.env" "${_mig_bak}" 2>/dev/null \
     && sed 's/hivemind\.silken\.ia\.br:4443/hivemind.ia.br:4443/g' "${_mig_bak}" > "${HIVEMIND_HOME}/.env" 2>/dev/null; then
    echo "[hivemind] endpoint migrated: hivemind.silken.ia.br:4443 → hivemind.ia.br:4443 (backup: ${_mig_bak})" >&2
  else
    cp "${_mig_bak}" "${HIVEMIND_HOME}/.env" 2>/dev/null || true
  fi
  unset _mig_bak
fi

# Load user env if present (sets MTLS_* + HIVEMIND_OWNER).
if [ -f "${HIVEMIND_HOME}/.env" ]; then
  # shellcheck disable=SC1090
  set -a; . "${HIVEMIND_HOME}/.env"; set +a
fi

# Refresh port vars after env load (env may override AR_PORT / MTLS_PROXY_PORT).
RUNTIME_PORT="${AR_PORT:-${RUNTIME_PORT}}"
PROXY_PORT="${MTLS_PROXY_PORT:-${PROXY_PORT}}"

# ── Option 2 per-target proxy (fos_decision 1caee6a7, item 18cff9b7) ────────
# `hivemind install <target>` allocates a DEDICATED loopback port + mints a
# device_id per installed target, instead of every foreign client sharing
# PROXY_PORT — full design: fos_sketchpad 4f8142e3 § ADDENDUM 3. Persisted to
# PORT_MAP_FILE (sibling to CERT_DIR, same owner-scoped ~/.engram/mtls root);
# read by runtime/src/lib/mtls-proxy.ts's startAllMtlsProxies() at daemon boot
# and on every POST /internal/proxy/reload.
PORT_MAP_FILE="${CERT_DIR}/port-map.json"
# Range default 7780-7879 (100 max installed targets) — a technical default
# with an obvious safe choice, not escalated as a founder fork (ADDENDUM 3
# OPEN 17). Tunable via env, mirroring the existing MTLS_PROXY_PORT override
# pattern. Computed AFTER the PROXY_PORT refresh above so a .env-overridden
# MTLS_PROXY_PORT shifts the range with it.
MTLS_INSTALL_PORT_RANGE_START="${MTLS_INSTALL_PORT_RANGE_START:-$((PROXY_PORT + 1))}"
MTLS_INSTALL_PORT_RANGE_END="${MTLS_INSTALL_PORT_RANGE_END:-$((PROXY_PORT + 100))}"

# ── ANSI helpers (NO_COLOR-aware) ────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  _ok()  { printf '\033[0;32m%s\033[0m' "$*"; }
  _err() { printf '\033[0;31m%s\033[0m' "$*"; }
  _dim() { printf '\033[2m%s\033[0m' "$*"; }
else
  _ok()  { printf '%s' "$*"; }
  _err() { printf '%s' "$*"; }
  _dim() { printf '%s' "$*"; }
fi

# ── _vecho: verbose-only stderr echo — gated behind --verbose (parsed at the
# entry point, bottom of file). Debug/startup noise lives behind this; GO/NO-GO
# status and errors stay unconditional.
_vecho() {
  [ "${_VERBOSE:-0}" = "1" ] && echo "$@" >&2
  return 0
}

# ── _brand_header: quiet-by-default output still shows this once ───────────
# F6.1 — minimal ASCII identity block: small, simple geometry (a single glyph
# + two lines), NOT a logo/illustration — studio is out of scope here (glyph
# is a placeholder for studio to revise later). Shows the resolved endpoint
# (HIVEMIND_ENDPOINT, defaulting to the product's own domain) so a lab<->
# product swap via .env is visible at every startup, not just in the .env file.
_brand_header() {
  echo ""
  echo "  $(_ok "◆") HiveMind — shared memory runtime"
  echo "  $(_dim "→ ${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443}")"
}

# ── _has_cert: returns 0 only if THIS owner's cert exists (owner-scoped) ─────
# Aligned with _check_health / cmd_status (:301+), which validate exactly
# "${CERT_DIR}/${HIVEMIND_OWNER}.cert.pem". A bare `ls *.cert.pem` glob (the
# previous impl) accepted a cert belonging to ANY owner — so a machine that
# already enrolled owner A would silently SKIP setup for owner B, then present
# owner B a runtime authenticated as A. Owner-scoped here closes that: another
# owner's cert present + this owner's cert absent → _has_cert fails → _setup_mode.
# The glob is kept ONLY as the fallback for when HIVEMIND_OWNER is unset (no
# owner to scope to yet — e.g. a partial/legacy .env), preserving prior
# behavior in that one degenerate case.
_has_cert() {
  [ -d "${CERT_DIR}" ] || return 1
  local _owner="${HIVEMIND_OWNER:-}"
  if [ -n "${_owner}" ]; then
    [ -f "${CERT_DIR}/${_owner}.cert.pem" ]
  else
    ls "${CERT_DIR}"/*.cert.pem > /dev/null 2>&1
  fi
}

# ── _endpoint_ok: is the PRODUCT endpoint reachable from this machine? ────────
# Semantics: liveness of the public CA surface (DNS + TLS + a server that
# answers), NOT of the :4443 MCP port and NOT an authorization check.
#
# Do NOT probe ${HIVEMIND_ENDPOINT} verbatim: that host:PORT is the :4443 MCP
# listener, and it fails a certless probe for two independent reasons — (a) it
# is mutual-mTLS (requestCert), so it closes a connection that presents no
# client cert, and (b) its server cert is signed by the PRODUCT CA, not a
# publicly-trusted one. MEASURED 2026-07-31 against hivemind.ia.br:
# `curl -sf https://hivemind.ia.br:4443/ca/crl.pem` → curl exit 60, http_code
# 000 — so the previous probe was a PERMANENT false negative: _HEALTH_ENDPOINT_OK
# was 0 on every healthy install, and `hivemind status`/`health` reported
# "Endpoint: unreachable" / DEGRADED forever.
#
# The 443/Let's-Encrypt surface is the certless, publicly-trusted one — the
# SAME surface enrollment itself bootstraps over (see ENROLL_HOST in
# runtime/src/routes/setup.ts, and the reasoning there for why :4443 cannot
# serve it) — so this strips the port and probes the CA path there. Measured:
# 200 in ~0.12s.
#
# No -f, and ANY status counts as reachable — the same liveness discipline as
# _proxy_ok (:280): a 401/403/404 still proves DNS resolved, TLS completed and
# a server answered, which is exactly what this check claims. Only http_code
# 000 (connection refused / TLS failure / timeout) means unreachable. Probing
# :4443 WITH the enrolled client cert was the alternative; it was rejected
# because this check must also be meaningful BEFORE enrollment (cmd_status runs
# fine with no cert at all), and a cert-dependent probe would reintroduce the
# same class of false negative it is fixing.
_endpoint_ok() {
  local _host="${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443}"
  _host="${_host%%:*}"
  local _code
  _code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
    "https://${_host}/ca/crl.pem" 2>/dev/null) || return 1
  [ "${_code}" != "000" ]
}

# ── _check_health: single source of truth for runtime/proxy/cert/endpoint
# state — populates _HEALTH_* globals + _HEALTH_SEVERITY (0=ok, 1=degraded,
# 2=down). Never returns non-zero itself (severity lives in the variable, not
# in $?) — safe to call as a bare statement under `set -e`. Shared by
# cmd_status (human-readable) and cmd_health (script-friendly exit code).
_check_health() {
  _HEALTH_RUNTIME_OK=0
  _HEALTH_PROXY_CONFIGURED=0
  _HEALTH_PROXY_OK=0
  _HEALTH_CERT_STATE="absent"   # absent | valid | invalid | unknown
  _HEALTH_ENDPOINT_OK=0
  _HEALTH_SEVERITY=0

  if curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; then
    _HEALTH_RUNTIME_OK=1
  fi

  # Proxy is only counted against health if it's actually configured — dev
  # setups without MTLS_PROXY_PORT are a deliberate mode, not a failure.
  if [ -n "${MTLS_PROXY_PORT:-}" ]; then
    _HEALTH_PROXY_CONFIGURED=1
    # Reuse _proxy_ok's status-tolerant probe. A bare GET /v1/mcp returns 406
    # (Not Acceptable) while the proxy is perfectly GO — so `curl -sf`, which
    # fails on any 4xx, false-negatives the proxy as DEGRADED (measured
    # 2026-08-04). _proxy_ok counts any HTTP status back (incl. 4xx/5xx) as
    # "listener alive"; only http_code 000 (refused/timeout) is a real death.
    if _proxy_ok; then
      _HEALTH_PROXY_OK=1
    fi
  fi

  local _owner="${HIVEMIND_OWNER:-}"
  if _has_cert; then
    if [ -n "${_owner}" ] && [ -f "${CERT_DIR}/${_owner}.cert.pem" ] && [ -f "${CERT_DIR}/ca.cert.pem" ]; then
      if openssl verify -CAfile "${CERT_DIR}/ca.cert.pem" \
           "${CERT_DIR}/${_owner}.cert.pem" > /dev/null 2>&1; then
        _HEALTH_CERT_STATE="valid"
      else
        _HEALTH_CERT_STATE="invalid"
      fi
    else
      _HEALTH_CERT_STATE="unknown"
    fi
  fi

  # Endpoint reachability — new check (item 4.3), public path, no cert needed.
  if _endpoint_ok; then
    _HEALTH_ENDPOINT_OK=1
  fi

  if [ "${_HEALTH_RUNTIME_OK}" -eq 0 ]; then
    _HEALTH_SEVERITY=2
  elif { [ "${_HEALTH_PROXY_CONFIGURED}" -eq 1 ] && [ "${_HEALTH_PROXY_OK}" -eq 0 ]; } \
    || [ "${_HEALTH_CERT_STATE}" = "invalid" ] \
    || [ "${_HEALTH_ENDPOINT_OK}" -eq 0 ]; then
    _HEALTH_SEVERITY=1
  fi
  return 0
}

# ── _pid_is_hivemind_runtime: guards cmd_stop against killing a PID the OS
# recycled for an unrelated process after a crash left a stale pidfile behind.
# Matches the FULL absolute RUNTIME_BIN path (fixed-string, not a loose
# 'server.ts' fragment) — a generic 'server.ts' substring would false-positive
# on an unrelated `vim server.ts` or `tail -f server.ts.log` sharing the
# recycled PID, which is exactly the failure this guard exists to prevent.
_pid_is_hivemind_runtime() {
  local _pid="$1"
  ps -p "${_pid}" -o command= 2>/dev/null | grep -qF -- "${RUNTIME_BIN}"
}

# ── _kill_wait_escalate: SIGTERM, wait (bounded) for the process to ACTUALLY
# exit, escalate to SIGKILL if it doesn't. $1=pid, $2=seconds to wait (default 5).
# Sending the signal is not the same as the port being released: every caller
# here kills a daemon precisely because it wants ${RUNTIME_PORT}/${PROXY_PORT}
# back, so returning the instant `kill` returns just races the replacement into
# EADDRINUSE. Same wait+escalate shape cmd_stop already implements inline; this
# is the shared version for the auto-heal paths.
_kill_wait_escalate() {
  local _pid="$1" _wait="${2:-5}" _t=0
  kill "${_pid}" 2>/dev/null || true
  while kill -0 "${_pid}" 2>/dev/null && [ "${_t}" -lt "${_wait}" ]; do
    sleep 1; _t=$((_t + 1))
  done
  if kill -0 "${_pid}" 2>/dev/null; then
    _vecho "[hivemind] pid=${_pid} still alive after ${_wait}s — escalating to SIGKILL"
    kill -9 "${_pid}" 2>/dev/null || true
  fi
}

# ── _setup_mode: first-login flow ─────────────────────────────────────────────
# Starts server in setup-only mode, opens browser, polls /setup/status until done.
_setup_mode() {
  _brand_header
  echo "First run detected — no certificate found."
  echo "Starting setup server..."

  if ! command -v bun > /dev/null 2>&1; then
    echo "Error: 'bun' is required but not found." >&2
    echo "Install bun: curl -fsSL https://bun.sh/install | bash" >&2
    exit 1
  fi
  if ! command -v openssl > /dev/null 2>&1; then
    echo "Error: 'openssl' is required but not found." >&2
    exit 1
  fi
  if [ ! -f "${RUNTIME_BIN}" ]; then
    echo "Error: runtime not found at ${RUNTIME_BIN}" >&2
    echo "Re-run: bash install.sh" >&2
    exit 1
  fi

  mkdir -p "$(dirname "${RUNTIME_LOG}")"

  # A stale daemon from an earlier, interrupted enrollment holds ${RUNTIME_PORT}
  # and would make the spawn below die on EADDRINUSE — with its output going to
  # the log file the user never opens. Reap ours first (identity-guarded, never
  # touches a foreign process).
  #
  # ...but NEVER when something HEALTHY is serving: a runtime answering healthz
  # whose mTLS proxy is also up belongs to an owner who is already enrolled on
  # this machine (the multi-owner case _has_cert's header describes — another
  # owner's cert present, this owner's absent, so we land in setup). Killing it
  # to make room for a first-run flow would take down a working session. Refuse
  # loudly instead; that is also strictly clearer than the 15s EADDRINUSE
  # timeout this case produced before. The MTLS_PROXY_PORT guard matters: with
  # no .env yet (genuine first run) _proxy_ok short-circuits to OK, and without
  # it a leftover setup daemon would read as "healthy" and never be reaped.
  if [ -n "${MTLS_PROXY_PORT:-}" ] \
    && curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1 \
    && _proxy_ok; then
    echo "Error: a HiveMind runtime is already running and healthy on port ${RUNTIME_PORT}." >&2
    echo "       Enrollment needs that port. Close the other HiveMind session (or run 'hivemind stop') and try again." >&2
    exit 1
  fi
  _reap_stale_runtime

  _vecho "[hivemind] setup: runtime=${RUNTIME_BIN} port=${RUNTIME_PORT} log=${RUNTIME_LOG}"
  _vecho "[hivemind] setup: endpoint=${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443} (enrollment goes to the 443/LE surface of this host)"
  if [ "${_VERBOSE:-0}" = "1" ]; then
    # --verbose was INERT during enrollment: the setup daemon's stdout/stderr
    # went ONLY to ${RUNTIME_LOG}, so a failing enroll printed nothing on the
    # terminal and the user had to know to go read a file to see why. Tee it to
    # stderr as well when verbose.
    # Process substitution, NOT a `| tee` pipeline: in a pipeline `$!` is the
    # LAST command (tee), so _SETUP_PID would stop pointing at bun and every
    # kill below — including cmd_stop's leftover cleanup — would miss the
    # daemon. With `> >(...)`, `$!` is still bun.
    bun run "${RUNTIME_BIN}" --setup-only > >(tee -a "${RUNTIME_LOG}" >&2) 2>&1 &
  else
    bun run "${RUNTIME_BIN}" --setup-only >> "${RUNTIME_LOG}" 2>&1 &
  fi
  _SETUP_PID=$!
  mkdir -p "$(dirname "${SETUP_PID_FILE}")"
  echo "${_SETUP_PID}" > "${SETUP_PID_FILE}"
  _vecho "[hivemind] setup: daemon spawned (pid=${_SETUP_PID}) — waiting for healthz"

  # Poll until setup server ready (timeout 15s).
  _TRIES=0
  until curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; do
    _TRIES=$((_TRIES + 1))
    if [ "${_TRIES}" -ge 15 ]; then
      echo "Error: setup server did not start after 15s. Check: ${RUNTIME_LOG}" >&2
      _kill_wait_escalate "${_SETUP_PID}" 5
      rm -f "${SETUP_PID_FILE}"
      exit 1
    fi
    sleep 1
  done
  _vecho "[hivemind] setup: daemon answering healthz on ${RUNTIME_PORT}"

  local _SETUP_URL="http://localhost:${RUNTIME_PORT}/setup"
  echo "Opening browser: ${_SETUP_URL}"

  if command -v xdg-open > /dev/null 2>&1; then
    xdg-open "${_SETUP_URL}" > /dev/null 2>&1 &
  elif command -v open > /dev/null 2>&1; then
    open "${_SETUP_URL}" &
  else
    echo "(Could not auto-open browser — open manually: ${_SETUP_URL})"
  fi

  echo "Fill in your API Key, then click 'Configure mTLS'."
  echo "Waiting for enrollment to complete (timeout: 5 min)..."

  # Poll /setup/status until done (timeout 300s / 5 min).
  # NOTE: `grep -q` used directly as the if-condition — a prior version used
  # `grep -c ... || echo 0` into a variable, but grep -c exits 1 when the
  # count is 0 (even though it prints "0"), which under pipefail ALSO fires
  # the `|| echo 0` fallback, producing a duplicated "0\n0" that broke the
  # `-gt` integer test every tick. grep -q as a bare condition has no such
  # count-vs-exit-code mismatch to trip over.
  _TRIES=0
  while :; do
    if curl -sf "http://127.0.0.1:${RUNTIME_PORT}/setup/status" 2>/dev/null \
      | grep -q '"done":true'; then
      break
    fi
    _TRIES=$((_TRIES + 1))
    if [ "${_TRIES}" -ge 300 ]; then
      echo "Timeout: enrollment did not complete in 5 minutes." >&2
      _kill_wait_escalate "${_SETUP_PID}" 5
      rm -f "${SETUP_PID_FILE}"
      exit 1
    fi
    sleep 1
  done
  _vecho "[hivemind] setup: enrollment reported done — stopping the setup daemon"

  # The setup daemon must be GONE, not merely signalled, before we tell the user
  # to run `hivemind`: it holds ${RUNTIME_PORT}, and setup-only mode never starts
  # the mTLS proxy. A lingering one makes the very next `hivemind` see "runtime
  # up on ${RUNTIME_PORT}, proxy ${PROXY_PORT} dead" — the founder-reported
  # "mTLS proxy: not responding" right after a SUCCESSFUL enroll. The reap in
  # _start_proxy now recovers from that state; waiting here means it should
  # never be entered in the first place.
  _kill_wait_escalate "${_SETUP_PID}" 5
  rm -f "${SETUP_PID_FILE}"
  echo ""
  echo "Done. Run 'hivemind' in your project directory to start."
  exit 0
}

# ── _proxy_ok: is the local mTLS proxy LISTENER (7779) alive? ─────────────────
# Semantics: LIVENESS of the local listener, NOT upstream (:4443) reachability.
# We do NOT use -f here (unlike _check_health's :119 probe): -f fails on any
# 4xx/5xx, so OFFLINE — when the proxy is healthy but its upstream is
# unreachable and it answers 502 — a -f probe would false-negative and the
# auto-heal would kill+restart a perfectly good runtime on every `hivemind`.
# Instead: any HTTP status back (incl. 502/4xx/5xx) means "process alive,
# listening" → OK; only connection-refused / timeout (curl writes http_code
# 000, or exits non-zero without connecting) means the listener is dead → FAIL.
# Gated on MTLS_PROXY_PORT: a dev setup without the proxy is a deliberate mode,
# not a failure, so it reports OK (reuse then proceeds on healthz alone,
# unchanged). --max-time 3 bounds a stuck/hung proxy; 3s mirrors :139.
_proxy_ok() {
  [ -n "${MTLS_PROXY_PORT:-}" ] || return 0
  local _code
  _code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
    "https://127.0.0.1:${PROXY_PORT}/v1/mcp" 2>/dev/null) || return 1
  [ "${_code}" != "000" ]
}

# ── _reap_orphan_runtimes: reap OUR runtimes that NO pidfile records ──────────
# A pidfile is not a reliable census of our own daemons: _spawn_runtime writes
# RUNTIME_PID_FILE only AFTER healthz answers (deliberate — see its header), and
# _setup_mode removes SETUP_PID_FILE the moment enrollment ends. So a daemon
# that outlived the shell that spawned it, or one left over from an interrupted
# enrollment, can hold ${RUNTIME_PORT} while being invisible to BOTH the pidfile
# reap below AND `hivemind stop` — which is exactly why the founder's only way
# out was a manual stop+start that, by luck, also cleared SETUP_PID_FILE.
#
# Selection is by IDENTITY, never by port: a candidate must carry the FULL
# absolute RUNTIME_BIN path on its command line (the same fixed-string,
# full-path guard as _pid_is_hivemind_runtime, and RUNTIME_BIN is derived from
# HIVEMIND_HOME — so this only ever matches THIS install's daemons). Reaping
# "whatever holds ${RUNTIME_PORT}" was rejected: on a developer box the very
# same default port is routinely held by an unrelated agent-runtime, and killing
# it would be a far worse bug than the one being fixed.
_reap_orphan_runtimes() {
  local _pids _pid
  if command -v pgrep > /dev/null 2>&1; then
    _pids=$(pgrep -f -- "${RUNTIME_BIN}" 2>/dev/null || true)
  else
    # No pgrep (minimal container): same census via ps. The grep in this
    # pipeline carries RUNTIME_BIN on its OWN command line, but it has exited
    # by the time the loop runs and the re-verification below drops it anyway.
    _pids=$(ps -eo pid=,command= 2>/dev/null | grep -F -- "${RUNTIME_BIN}" | awk '{print $1}' || true)
  fi
  for _pid in ${_pids}; do
    # `if` rather than `[ ... ] && continue`: the latter's non-zero status on a
    # non-match is an errexit trap waiting for the next edit to spring it.
    if [ "${_pid}" = "$$" ]; then continue; fi
    kill -0 "${_pid}" 2>/dev/null || continue
    # Re-verify before killing: `pgrep -f` treats its argument as a REGEX (every
    # '.' in the path is a wildcard) and the ps fallback matched a raw line —
    # confirm with the fixed-string check cmd_stop trusts, so a loose match can
    # never escalate into killing something that is not ours.
    _pid_is_hivemind_runtime "${_pid}" || continue
    _vecho "[hivemind] auto-heal: reaping orphan runtime with no pidfile (pid=${_pid})"
    _kill_wait_escalate "${_pid}" 5
  done
}

# ── _reap_stale_runtime: auto-heal what `hivemind stop` does by hand ──────────
# Kills the runtime recorded in the pidfile ONLY when it is genuinely a
# hivemind-runtime (via _pid_is_hivemind_runtime — the SAME guard cmd_stop
# uses), then clears the pidfile. Fail-safe: a recycled/foreign PID is NEVER
# killed (only the stale pidfile is cleared). Callers invoke this ONLY after
# establishing the current runtime is unhealthy (healthz down, or 7777 up but
# proxy 7779 broken), so it never touches a HEALTHY runtime.
#
# BOTH pidfiles are swept, not just RUNTIME_PID_FILE: a --setup-only daemon
# (SETUP_PID_FILE) listens on the SAME ${RUNTIME_PORT} as a normal runtime, and
# setup-only mode deliberately never starts the mTLS proxy (server.ts:
# `if (!isSetupOnly) startMtlsProxy()`). A leftover one therefore presents the
# exact state the auto-heal exists for — /healthz answers on ${RUNTIME_PORT},
# ${PROXY_PORT} is dead — while a RUNTIME_PID_FILE-only reap finds nothing to
# kill and the fresh spawn then dies on EADDRINUSE. That is the measured
# "enrolled fine, then 'mTLS proxy: not responding' until a manual stop+start"
# bug (founder, 2026-07-31): _setup_mode signalled its daemon and exited without
# waiting, and nothing downstream owned the leftover.
_reap_stale_runtime() {
  local _f _pid
  for _f in "${RUNTIME_PID_FILE}" "${SETUP_PID_FILE}"; do
    [ -f "${_f}" ] || continue
    _pid=$(cat "${_f}" 2>/dev/null || echo '')
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
      if _pid_is_hivemind_runtime "${_pid}"; then
        _vecho "[hivemind] auto-heal: stopping stale/stuck runtime (pid=${_pid}, pidfile=${_f})"
        _kill_wait_escalate "${_pid}" 5
      else
        _vecho "[hivemind] pidfile pid=${_pid} is not a hivemind runtime (recycled) — clearing pidfile only, not killing"
      fi
    fi
    rm -f "${_f}"
  done

  # Last resort: daemons no pidfile knows about (see _reap_orphan_runtimes).
  _reap_orphan_runtimes
}

# ── _spawn_runtime: launch a fresh runtime, wait for healthz, THEN write pidfile
# The pidfile is written ONLY after healthz confirms the process is actually up
# — never records the PID of a bun that died at startup (EADDRINUSE), which is
# exactly what used to sabotage a later `hivemind stop`. An early exit (bun
# dying on EADDRINUSE/crash) is detected via kill -0 and returns 1 FAST instead
# of burning the full 15s timeout. Returns 0 on success, 1 otherwise.
_spawn_runtime() {
  local _pid
  # nohup + disown: the daemon must survive the terminal that launched it
  # closing (Fase 1, DR-1.1) — nohup makes the child IGNORE SIGHUP (portable
  # POSIX, unlike setsid which is absent on base macOS); disown drops the job
  # from bash's job table so the shell itself never signals the child when
  # this script exits. Neither alone is enough: nohup without disown can
  # still be waited on by a stray `wait` under `set -euo pipefail`. Redirect
  # stdin from /dev/null — nohup does not do this itself, and a detached
  # process with no terminal reading stdin can otherwise block/misbehave.
  # HIVEMIND_DEVICE_ID is exported into the daemon's env here so later
  # reconcile/event-emission (Fase 2/4) can tag its own device without a
  # second, divergent notion of "device" inside the daemon process.
  HIVEMIND_DEVICE_ID="$(_resolve_device_id)" \
    nohup bun run "${RUNTIME_BIN}" >> "${RUNTIME_LOG}" 2>&1 < /dev/null &
  _pid=$!
  disown

  local _tries=0
  until curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; do
    # Bun exited during startup (EADDRINUSE / crash) — bail immediately rather
    # than polling a dead PID for 15s.
    if ! kill -0 "${_pid}" 2>/dev/null; then
      _vecho "[hivemind] runtime exited during startup (pid=${_pid}) — see ${RUNTIME_LOG}"
      return 1
    fi
    _tries=$((_tries + 1))
    if [ "${_tries}" -ge 15 ]; then
      _vecho "[hivemind] runtime did not answer healthz after 15s — killing pid=${_pid}"
      kill "${_pid}" 2>/dev/null || true
      return 1
    fi
    sleep 1
  done

  # Up and answering — NOW it is safe to record the pid.
  echo "${_pid}" > "${RUNTIME_PID_FILE}"
  return 0
}

# ── _local_ca_trusted: is the CURRENT local-https CA already in the system
# store? Fingerprint-compared (not just presence) so a rotated/regenerated CA
# (e.g. ~/.engram/mtls/local-https/ wiped and regenerated) is detected and
# re-trusted, instead of silently trusting a stale copy forever.
_local_ca_trusted() {
  [ -f "${SYSTEM_CA_DEST}" ] || return 1
  local _have _want
  _have="$(_cert_fingerprint_sha256 "${SYSTEM_CA_DEST}" 2>/dev/null)"
  _want="$(_cert_fingerprint_sha256 "${LOCAL_HTTPS_CA}" 2>/dev/null)"
  [ -n "${_have}" ] && [ "${_have}" = "${_want}" ]
}

# ── _trust_local_ca: item 1.4 — trust the local HTTPS listener CA into the
# WSL/Linux system store (this machine only; Windows/Antigravity trust is
# Phase 4 item 4.4, out of scope here). No-op when the local CA has not been
# generated yet (mtls-proxy.ts generates it lazily on first proxy start —
# nothing to trust before that) or when already trusted (idempotent).
# System-level act (sudo + update-ca-certificates) — this is the ONE place
# in the codebase that escalates; never called speculatively, only from
# _start_proxy right after a runtime is confirmed up.
_trust_local_ca() {
  [ -f "${LOCAL_HTTPS_CA}" ] || return 0
  _local_ca_trusted && return 0

  if ! command -v update-ca-certificates > /dev/null 2>&1; then
    _vecho "[hivemind] update-ca-certificates not found (non-Debian/Ubuntu host?) — local HTTPS CA not trusted system-wide; strict-TLS clients will fail to verify 127.0.0.1:${PROXY_PORT}"
    return 0
  fi

  echo "[hivemind] trusting local HTTPS CA into the system store (sudo required): ${SYSTEM_CA_DEST}" >&2
  if sudo cp "${LOCAL_HTTPS_CA}" "${SYSTEM_CA_DEST}" 2>/dev/null \
    && sudo update-ca-certificates > /dev/null 2>&1; then
    _vecho "[hivemind] local HTTPS CA trusted"
  else
    echo "[hivemind] WARNING: failed to trust local HTTPS CA — a strict-TLS IDE client will fail to verify https://127.0.0.1:${PROXY_PORT}/v1/mcp until 'sudo update-ca-certificates' is run manually with ${LOCAL_HTTPS_CA} copied to ${SYSTEM_CA_DEST}" >&2
  fi
}

# ── _start_proxy: ensure a HEALTHY runtime+proxy is running (idempotent) ──────
# Reuse only a genuinely healthy runtime: healthz(7777) AND proxy(7779) both OK.
# If 7777 answers but the proxy is broken (the orphaned/stuck runtime left by an
# abrupt Claude close — the "hivemind won't reopen, needs a manual stop" bug),
# auto-heal: reap OUR stale runtime + start fresh. EADDRINUSE (failure mode B)
# is handled explicitly — reap the orphan holding the port + one retry — rather
# than eating the 15s timeout, and the pidfile is never overwritten with a dead
# PID.
_start_proxy() {
  # Fast path: an already-healthy runtime+proxy is reused untouched.
  if curl -sf "http://127.0.0.1:${RUNTIME_PORT}/healthz" > /dev/null 2>&1; then
    # Item 1.4: ensure the local HTTPS cert (if present) is trusted BEFORE
    # the _proxy_ok probe below — that probe is now an https:// request, so
    # an untrusted CA would make a perfectly healthy proxy read as "down"
    # (SSL verify failure, not connection-refused) and trigger a needless
    # reap+restart loop. Idempotent/cheap when already trusted.
    _trust_local_ca
    if _proxy_ok; then
      return 0
    fi
    # 7777 up but proxy 7779 down/stuck → this runtime is unhealthy. Reap it
    # (only if it is really ours) and fall through to a clean fresh start.
    _vecho "[hivemind] runtime up on ${RUNTIME_PORT} but proxy ${PROXY_PORT} not responding — auto-healing"
    _reap_stale_runtime
  fi

  if ! command -v bun > /dev/null 2>&1; then
    echo "Error: 'bun' is required. Install: curl -fsSL https://bun.sh/install | bash" >&2
    exit 1
  fi
  if [ ! -f "${RUNTIME_BIN}" ]; then
    echo "Error: runtime not found at ${RUNTIME_BIN}. Re-run: bash install.sh" >&2
    exit 1
  fi

  mkdir -p "$(dirname "${RUNTIME_LOG}")"

  # Before spawning, clear any stale runtime WE own that may still hold the port
  # (failure mode B: EADDRINUSE from an orphan). Safe no-op when the pidfile is
  # absent or points to a non-hivemind PID.
  _reap_stale_runtime

  _vecho "[hivemind] starting runtime..."
  if ! _spawn_runtime; then
    # One retry: an orphan may have raced us for the port. Reap + retry once.
    _vecho "[hivemind] first start failed — reaping any port-holder and retrying once"
    _reap_stale_runtime
    if ! _spawn_runtime; then
      echo "Error: hivemind runtime did not start (port ${RUNTIME_PORT} busy or startup crash). Check: ${RUNTIME_LOG}" >&2
      exit 1
    fi
  fi
  _vecho "[hivemind] runtime up (pid=$(cat "${RUNTIME_PID_FILE}" 2>/dev/null || echo '?'))"

  # healthz(7777) confirmed above by _spawn_runtime — by server.ts's own
  # startup order, startMtlsProxy() (and its lazy cert generation) runs
  # synchronously BEFORE the main app's Bun.serve, so LOCAL_HTTPS_CA already
  # exists on disk here if the proxy is configured at all (item 1.4).
  _trust_local_ca
}

# ── Subcommands ───────────────────────────────────────────────────────────────

cmd_version() {
  echo "HiveMind v${HIVEMIND_VERSION}"
}

cmd_help() {
  echo "Usage: hivemind [<slug>] | start | stop | restart | status | health | update | resume <slug> | install [<target>] | --version"
  echo ""
  echo "  hivemind [<slug>]     Start proxy + open Claude Code (slug = arg, else interactive picker)"
  echo "  hivemind start        Start proxy only"
  echo "  hivemind stop         Stop the proxy"
  echo "  hivemind restart      Stop + start (best-effort)"
  echo "  hivemind status       Show proxy health and certificate validity (human-readable)"
  echo "  hivemind health       Same checks as status; exit 0=ok 1=degraded 2=down"
  echo "  hivemind update       Pull-agent: staged + verified + atomic update, auto-rollback"
  echo "  hivemind resume <slug>  Explicit crash recovery: close a dead-holder session for <slug>, then open"
  echo "  hivemind install [<target>]  Guided setup of another local MCP client (Cursor, Antigravity, ...)"
  echo "                         Interactive only — detects candidates, asks scope, confirms the exact"
  echo "                         path with you before writing anything. No default path, ever."
  echo "  hivemind --version    Print version"
  echo ""
  echo "  --verbose             Show startup/debug logs (default: quiet, GO/NO-GO + errors only)"
}

cmd_status() {
  _check_health
  echo "HiveMind v${HIVEMIND_VERSION} — status"
  echo ""

  if [ "${_HEALTH_RUNTIME_OK}" = "1" ]; then
    echo "  Runtime:    $(_ok "OK") (port ${RUNTIME_PORT})"
  else
    echo "  Runtime:    $(_err "STOPPED") (port ${RUNTIME_PORT})"
  fi

  if [ "${_HEALTH_PROXY_CONFIGURED}" = "1" ]; then
    if [ "${_HEALTH_PROXY_OK}" = "1" ]; then
      echo "  mTLS proxy: $(_ok "OK") (port ${PROXY_PORT})"
    else
      echo "  mTLS proxy: $(_err "not responding") (port ${PROXY_PORT})"
    fi
  else
    echo "  mTLS proxy: $(_dim "not configured") (port ${PROXY_PORT})"
  fi

  local _owner="${HIVEMIND_OWNER:-}"
  case "${_HEALTH_CERT_STATE}" in
    valid)   echo "  Cert:       $(_ok "VALID") (owner=${_owner})" ;;
    invalid) echo "  Cert:       $(_err "INVALID") — re-enroll: rm -rf ${CERT_DIR} && hivemind" ;;
    unknown) echo "  Cert:       $(_dim "present (run 'hivemind' to validate)")" ;;
    *)       echo "  Cert:       $(_dim "NOT FOUND") — run 'hivemind' to enroll" ;;
  esac

  if [ "${_HEALTH_ENDPOINT_OK}" = "1" ]; then
    echo "  Endpoint:   $(_ok "reachable") (${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443})"
  else
    echo "  Endpoint:   $(_dim "unreachable") (${HIVEMIND_ENDPOINT:-hivemind.ia.br:4443})"
  fi
}

cmd_health() {
  _check_health
  case "${_HEALTH_SEVERITY}" in
    0) echo "$(_ok "OK") — runtime, proxy, cert and endpoint healthy" ;;
    1) echo "$(_err "DEGRADED") — run 'hivemind status' for details" ;;
    2) echo "$(_err "DOWN") — runtime not responding on port ${RUNTIME_PORT}" ;;
  esac
  return "${_HEALTH_SEVERITY}"
}

cmd_start() {
  if ! _has_cert; then _setup_mode; fi
  _start_proxy
  echo "[hivemind] proxy running on port ${PROXY_PORT}"
}

cmd_stop() {
  if [ -f "${RUNTIME_PID_FILE}" ]; then
    local _pid
    _pid=$(cat "${RUNTIME_PID_FILE}" 2>/dev/null || echo '')
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
      if _pid_is_hivemind_runtime "${_pid}"; then
        kill "${_pid}"
        # DR-3.2: wait (bounded) for the daemon to actually exit, escalating
        # to SIGKILL if it doesn't — mirrors _reap_stale_runtime's own
        # wait+escalate (:286-293). Without this, `cmd_stop` used to
        # return the instant the signal was SENT, not once the process was
        # actually gone — cmd_update's mid-swap cmd_stop (:700) could then
        # race on to the mv/rename of $HIVEMIND_HOME while the old process
        # was still up, holding open files/ports.
        local _t=0
        while kill -0 "${_pid}" 2>/dev/null && [ "${_t}" -lt 10 ]; do
          sleep 1; _t=$((_t + 1))
        done
        if kill -0 "${_pid}" 2>/dev/null; then
          _vecho "[hivemind] runtime still alive after 10s — escalating to SIGKILL (pid=${_pid})"
          kill -9 "${_pid}" 2>/dev/null || true
        fi
        rm -f "${RUNTIME_PID_FILE}"
        echo "[hivemind] runtime stopped"
      else
        # Stale pidfile: PID is alive but recycled by the OS for an unrelated
        # process (crash left the pidfile behind) — do NOT kill it.
        echo "[hivemind] pidfile PID ${_pid} is not a hivemind runtime (stale/recycled) — not killing, clearing pidfile" >&2
        rm -f "${RUNTIME_PID_FILE}"
      fi
    else
      echo "[hivemind] no running runtime at pid ${_pid}"
      rm -f "${RUNTIME_PID_FILE}"
    fi
  else
    echo "[hivemind] no runtime pid file found (already stopped?)"
  fi

  # Best-effort cleanup of a leftover --setup-only session (e.g. hivemind was
  # interrupted mid-enrollment and the background setup server never exited).
  if [ -f "${SETUP_PID_FILE}" ]; then
    local _setup_pid
    _setup_pid=$(cat "${SETUP_PID_FILE}" 2>/dev/null || echo '')
    if [ -n "${_setup_pid}" ] && kill -0 "${_setup_pid}" 2>/dev/null; then
      kill "${_setup_pid}" 2>/dev/null || true
    fi
    rm -f "${SETUP_PID_FILE}"
  fi
}

cmd_restart() {
  cmd_stop
  _start_proxy
  echo "[hivemind] restarted"
}

# ── Update mechanism (item 4.4) ───────────────────────────────────────────────
# Pull-agent for the thin client: bin/hivemind + runtime/src/* ONLY — prompts/
# seeds are never touched here (they live server-side).
# Hardened (silent auto-pull): pinned source, integrity check,
# staged+atomic swap, last-known-good rollback.

# _verify_commit_integrity: 0 = trusted, 1 = refuse to apply.
# Two paths, either sufficient: (a) valid GPG signature via `git verify-commit`
# from a signer git already trusts; (b) commit hash matches a LATEST_SHA
# manifest published on a channel separate from git itself (the product HTTPS
# domain, not the repo host) — fallback for when no signer is configured.
# The manifest endpoint (https://<host>/hivemind/LATEST_SHA) is LIVE — it is
# auto-published on every push by the publish-latest-sha workflow, so the (b)
# path resolves normally. If the fetch fails (endpoint unreachable / empty),
# this still fails closed for unsigned commits, which is the correct fail-safe
# default (spec: "se a verificação falhar → NÃO aplica"), not a bug.
_verify_commit_integrity() {
  local _dir="$1"
  if git -C "${_dir}" verify-commit HEAD > /dev/null 2>&1; then
    return 0
  fi
  local _host="${HIVEMIND_ENDPOINT%%:*}"
  local _manifest_url="https://${_host}/hivemind/LATEST_SHA"
  local _expected_sha
  _expected_sha="$(curl -sf --max-time 5 "${_manifest_url}" 2>/dev/null | tr -d '[:space:]')"
  [ -n "${_expected_sha}" ] || return 1
  local _actual_sha
  _actual_sha="$(git -C "${_dir}" rev-parse HEAD)"
  [ "${_actual_sha}" = "${_expected_sha}" ]
}

# _stage_build: mirrors install.sh's $HIVEMIND_HOME-scoped copy step (CLAUDE.md,
# .claude/settings.json, runtime/ + bun install) into a STAGING dir — never
# touches the live $HIVEMIND_HOME. Deliberately does NOT reinstall the CLI
# binary to PATH (that's handled separately, see _update_installed_binary) and
# does NOT run install.sh's dependency/PATH checks or smoke test (those are
# first-install concerns, not update concerns).
#
# Two-tier copy (code-review fix, post-5.1/5.2/5.3 — replaces a cherry-pick
# allowlist that was a BLOCKER): (1) GIT-MANAGED paths — CLAUDE.md, settings.json,
# commands/, runtime/ — the NEW version from HIVEMIND_SOURCE_DIR always wins;
# (2) RUNTIME-WRITTEN state — everything Claude Code / the enrollment flow
# writes into $HIVEMIND_HOME at runtime (NOT sourced from git: .env,
# .claude/.claude.json [mcpServers.engram, item 5.1], .claude/.credentials.json
# [item 5.0], plus whatever Claude Code writes next — history.jsonl, sessions/,
# projects/, shell-snapshots/, caches, none of it enumerable up front) — the
# LIVE state always wins. A fixed allowlist (the previous version of this
# function only preserved .env + .credentials.json) silently drops every other
# runtime-written file on the first 'hivemind update' — this is exactly what
# broke the item 5.1 MCP fix (.claude.json is written by the ENROLLMENT
# handler at runtime, not by git, so it was never in the allowlist and got
# wiped by the staging mv). Inverting the pattern to "preserve everything,
# except what git explicitly owns" closes that class of regression instead of
# cherry-picking the next file that turns out to matter.
_stage_build() {
  local _target="$1"
  mkdir -p "${_target}/.claude" "${_target}/.claude/hooks" "${_target}/bin" "${_target}/runtime" || return 1

  # ── Tier 1: git-managed — NEW version wins ────────────────────────────────
  # CLAUDE.md lands under .claude/ — mirrors install.sh's item 5.2 fix
  # (load-bearing: forgetting this side regresses the pull-agent silently).
  cp "${HIVEMIND_SOURCE_DIR}/CLAUDE.md" "${_target}/.claude/CLAUDE.md" || return 1
  # settings.json is TEMPLATED (F5.3), same as install.sh — __HIVEMIND_HOME__
  # resolves against the LIVE HIVEMIND_HOME (this update targets the same
  # install, not a fresh one), not the staging dir itself.
  sed "s|__HIVEMIND_HOME__|${HIVEMIND_HOME}|g" \
    "${HIVEMIND_SOURCE_DIR}/.claude/settings.json" > "${_target}/.claude/settings.json" || return 1
  # Product slash-commands (item 5.3) — same mirror requirement as above.
  # These are THIN STUBS (Branch B, decision_serve-boot-and-end-session-as-mcp-prompts-fail-closed):
  # the canonical procedure body is served by the engram (fos_procedure({id})) and fetched at
  # invocation, FAIL-CLOSED (engram unreachable → no local fallback, session does not
  # boot/close). This copy step only ships the stub files, not the procedure content — see
  # CLAUDE.md § Session start / § Session close.
  mkdir -p "${_target}/.claude/commands" || return 1
  cp -r "${HIVEMIND_SOURCE_DIR}/.claude/commands/." "${_target}/.claude/commands/" || return 1
  # Status-CLI (F5.1) + quota-capture hook (F5.2) — referenced by the
  # templated settings.json above; must ship alongside it on every update.
  cp "${HIVEMIND_SOURCE_DIR}/bin/hivemind-statusline.py" "${_target}/bin/hivemind-statusline.py" || return 1
  chmod +x "${_target}/bin/hivemind-statusline.py" || return 1
  # Copy the WHOLE hooks dir (the class), never a per-file allowlist. A forgotten
  # entry here is exactly what stripped stop.sweep-wip-md.mjs on update while the
  # freshly-templated settings.json still registered it → ERR_MODULE_NOT_FOUND at
  # the Stop event. settings.json (Tier 1, above) is the single source of which
  # hooks are registered; ship all of them so it can never dangle. Same
  # "preserve the class, not an allowlist" lesson as the Tier-2 runtime-state copy.
  cp -r "${HIVEMIND_SOURCE_DIR}/.claude/hooks/." "${_target}/.claude/hooks/" || return 1
  rsync -a --exclude='node_modules/' --exclude='bun.lock' \
    "${HIVEMIND_SOURCE_DIR}/runtime/" "${_target}/runtime/" 2>/dev/null \
    || cp -r "${HIVEMIND_SOURCE_DIR}/runtime/." "${_target}/runtime/" || return 1
  (cd "${_target}/runtime" && bun install --silent 2>/dev/null || bun install) || return 1

  # ── Tier 2: runtime-written — LIVE state wins ─────────────────────────────
  # Preserve the LIVE .env (cert paths, endpoint, update pinning) — the staged
  # build must boot with the same identity/config as the current one, not a
  # fresh/empty one.
  if [ -f "${HIVEMIND_HOME}/.env" ]; then
    cp "${HIVEMIND_HOME}/.env" "${_target}/.env" || return 1
  fi
  # Merge the ENTIRE live .claude/ dir over the staged one, EXCLUDING exactly
  # the 4 git-managed paths already placed above (anchored to the transfer
  # root with a leading '/' so a same-named file/dir nested deeper — e.g. under
  # sessions/ or projects/ — is never accidentally excluded). No --delete: this
  # only ADDS/overwrites from live into staging, it never removes a
  # freshly-placed git file. Covers .claude.json (item 5.1) + .credentials.json
  # (item 5.0) + anything else Claude Code writes there, present or future.
  # /hooks/ added at F5.2 (quota-capture hook is git-managed like
  # CLAUDE.md/settings.json/commands/, not runtime-written).
  if [ -d "${HIVEMIND_HOME}/.claude" ]; then
    rsync -a \
      --exclude='/CLAUDE.md' \
      --exclude='/settings.json' \
      --exclude='/commands/' \
      --exclude='/hooks/' \
      "${HIVEMIND_HOME}/.claude/" "${_target}/.claude/" || return 1
  fi
  return 0
}

# _update_installed_binary / _rollback_installed_binary: the system-PATH copy
# of bin/hivemind is outside $HIVEMIND_HOME, so it needs its own (small,
# already-atomic) swap — cp-to-temp + rename, mirroring the staging pattern at
# a smaller scale. Best-effort: if the installed path isn't writable, skip
# (not fatal — the $HIVEMIND_HOME swap is the load-bearing part).
_update_installed_binary() {
  local _installed_bin
  _installed_bin="$(command -v hivemind 2>/dev/null || true)"
  [ -n "${_installed_bin}" ] && [ -w "${_installed_bin}" ] || return 0
  cp "${_installed_bin}" "${_installed_bin}.last-good" 2>/dev/null || true
  cp "${HIVEMIND_SOURCE_DIR}/bin/hivemind" "${_installed_bin}.new" || return 1
  chmod +x "${_installed_bin}.new"
  mv "${_installed_bin}.new" "${_installed_bin}"
}
_rollback_installed_binary() {
  local _installed_bin
  _installed_bin="$(command -v hivemind 2>/dev/null || true)"
  if [ -n "${_installed_bin}" ] && [ -f "${_installed_bin}.last-good" ]; then
    mv "${_installed_bin}.last-good" "${_installed_bin}"
  fi
}

cmd_update() {
  if [ -z "${HIVEMIND_SOURCE_DIR:-}" ] || [ ! -d "${HIVEMIND_SOURCE_DIR}/.git" ]; then
    echo "Error: HIVEMIND_SOURCE_DIR not set or not a git clone — re-run install.sh to pin the update source." >&2
    exit 1
  fi

  local _branch="${HIVEMIND_UPDATE_BRANCH:-main}"

  # Source pinning guard (requirement 1): refuse if origin drifted from what
  # was recorded at install time — evicts a silent remote/DNS swap.
  local _current_remote
  _current_remote="$(git -C "${HIVEMIND_SOURCE_DIR}" remote get-url origin 2>/dev/null || echo '')"
  if [ -n "${HIVEMIND_UPDATE_REMOTE:-}" ] && [ "${_current_remote}" != "${HIVEMIND_UPDATE_REMOTE}" ]; then
    echo "Error: origin remote changed since install (pinned: ${HIVEMIND_UPDATE_REMOTE}, current: ${_current_remote}) — refusing to update." >&2
    exit 1
  fi

  echo "Checking ${_branch} for updates..."
  if ! git -C "${HIVEMIND_SOURCE_DIR}" fetch --quiet origin "${_branch}"; then
    echo "Error: fetch failed (network?) — staying on current version." >&2
    exit 1
  fi

  local _before _after
  _before="$(git -C "${HIVEMIND_SOURCE_DIR}" rev-parse HEAD)"
  _after="$(git -C "${HIVEMIND_SOURCE_DIR}" rev-parse "origin/${_branch}")"

  if [ "${_before}" = "${_after}" ]; then
    echo "Already up to date (${_before:0:12})."
    return 0
  fi

  if ! git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "origin/${_branch}" > /dev/null 2>&1; then
    echo "Error: could not reset clone to origin/${_branch} — resolve manually." >&2
    exit 1
  fi

  # Requirement 2: integrity check. Fail-safe — on failure, revert the clone
  # to the pre-fetch commit and do NOT touch $HIVEMIND_HOME.
  if ! _verify_commit_integrity "${HIVEMIND_SOURCE_DIR}"; then
    echo "Error: integrity check FAILED for ${_after:0:12} — not applying, reverting clone to ${_before:0:12}." >&2
    git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "${_before}" > /dev/null 2>&1 || true
    exit 1
  fi

  echo "Verified ${_after:0:12} — staging..."

  # Requirement 3: apply atomically via a staging dir + rename swap (never
  # copy-in-place onto the live $HIVEMIND_HOME).
  local _staging="${HIVEMIND_HOME}.staging"
  local _lastgood="${HIVEMIND_HOME}.last-good"
  rm -rf "${_staging}"

  if ! _stage_build "${_staging}"; then
    echo "Error: staging build failed — current installation untouched." >&2
    rm -rf "${_staging}"
    git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "${_before}" > /dev/null 2>&1 || true
    exit 1
  fi

  echo "Staged — swapping in (atomic)..."
  cmd_stop > /dev/null 2>&1 || true
  rm -rf "${_lastgood}"
  # NOTE (deferred, not this pass — team-lead review): each `mv` below is
  # atomic on its own, but the two together are not a single atomic step —
  # there's a small window between them where $HIVEMIND_HOME doesn't exist at
  # all. Acceptable for now (auto-update is inert without a signer/manifest,
  # see _verify_commit_integrity); will be hardened alongside the signing
  # infra before update goes live. Manual recovery in the meantime: if a crash
  # lands here, restore from "${HIVEMIND_HOME}.last-good" (or re-run
  # install.sh from "${HIVEMIND_HOME}.staging" if last-good is also absent).
  if [ -d "${HIVEMIND_HOME}" ]; then
    mv "${HIVEMIND_HOME}" "${_lastgood}"
  fi
  mv "${_staging}" "${HIVEMIND_HOME}"
  # Best-effort: a failed binary swap here must NOT abort under set -e — the
  # $HIVEMIND_HOME swap already happened, and the health-check/rollback below
  # (requirement 4) still needs to run regardless of this side-swap's outcome.
  _update_installed_binary || true

  # Requirement 4: last-known-good + automatic rollback on a failed
  # post-update health check. _start_proxy exits(1) directly on its own
  # start-up failure (pre-existing behavior, relied on by cmd_start/cmd_open)
  # — run it in a SUBSHELL here so that exit only ends the subshell, not this
  # whole update, letting the rollback logic below actually run.
  ( _start_proxy ) || true
  _check_health

  if [ "${_HEALTH_SEVERITY}" -ge 2 ]; then
    echo "Error: post-update health check FAILED — rolling back to ${_before:0:12}." >&2
    cmd_stop > /dev/null 2>&1 || true
    rm -rf "${HIVEMIND_HOME}"
    mv "${_lastgood}" "${HIVEMIND_HOME}"
    git -C "${HIVEMIND_SOURCE_DIR}" reset --hard "${_before}" > /dev/null 2>&1 || true
    _rollback_installed_binary
    ( _start_proxy ) || true
    echo "Rolled back — running ${_before:0:12}." >&2
    exit 1
  fi

  echo "$(_ok "Updated"): ${_before:0:12} -> ${_after:0:12}."
}

# _maybe_auto_update: silent on-launch check (OPEN-6, founder-approved).
# Best-effort + fail-open on ANY network/config hiccup — never blocks startup.
# Short timeout (~2s) on the remote check only; the actual update (if one
# applies) reuses cmd_update's hardened staged/atomic/rollback path.
_maybe_auto_update() {
  [ -n "${HIVEMIND_SOURCE_DIR:-}" ] || return 0
  [ -d "${HIVEMIND_SOURCE_DIR}/.git" ] || return 0
  # BLOCKER FIX: `timeout` is not present on stock macOS (only via brew
  # coreutils). Without this guard, the `$(timeout ...)` command substitution
  # below fails with 127, and — being a variable assignment — set -e ABORTS
  # THE WHOLE SCRIPT right here, killing the default `hivemind`/`hivemind
  # <slug>` path before _start_proxy/exec claude ever run. Degrade instead:
  # no `timeout` → skip the silent auto-update, continue booting normally.
  command -v timeout > /dev/null 2>&1 || return 0

  local _branch="${HIVEMIND_UPDATE_BRANCH:-main}"
  local _remote_head
  # `|| true` is LOAD-BEARING: under `set -euo pipefail`, if `timeout` fires
  # (git ls-remote exceeds the limit) the command substitution exits non-zero
  # and — being a bare assignment — set -e would ABORT the whole script right
  # here, BEFORE the fail-open guard below ever runs (crash instead of degrade).
  # Timeout raised 2s->5s so a normal (~2s) remote check actually completes
  # instead of intermittently tripping the limit and skipping the update.
  _remote_head="$(timeout 5 git -C "${HIVEMIND_SOURCE_DIR}" ls-remote origin "refs/heads/${_branch}" 2>/dev/null | cut -f1)" || true
  [ -n "${_remote_head}" ] || return 0   # offline/timeout — fail-open, continue as-is

  local _local_head
  _local_head="$(git -C "${HIVEMIND_SOURCE_DIR}" rev-parse HEAD 2>/dev/null || echo '')"
  [ "${_remote_head}" != "${_local_head}" ] || return 0   # already current

  # cmd_update calls exit(1) directly on several failure paths — run it in a
  # SUBSHELL so a failed silent update can never take the whole launch down
  # with it (same reasoning as the _start_proxy wrapping inside cmd_update).
  ( cmd_update ) > /dev/null 2>&1 || true
  return 0
}

# ── Session spine (WS-0.3, P0.1) ──────────────────────────────────────────────
# Opens a real fos_session BEFORE exec'ing claude, through the
# product's MCP tool surface (fos_session/fos_registry over the local mTLS
# proxy).

# _resolve_device_id: stable device_id for this machine.
# Created once (first run), reused thereafter.
#
# Fase 6:
#
# DR-6.1 — `~/.engram/device-id` lives OUTSIDE ${HIVEMIND_HOME} (see the
# ~/.engram-vs-~/.hivemind isolation note at :25-28). Measured: `cmd_update`
# only mv/rm's inside ${HIVEMIND_HOME}[.staging|.last-good], and install.sh
# only writes inside ${HIVEMIND_HOME}/{.claude,runtime,bin} — neither ever
# touches ~/.engram. device_id (and its cert binding below) already survive
# both `hivemind update` and a full reinstall as a side effect of that
# isolation; this comment makes the invariant explicit instead of leaving it
# an accident nobody wrote down.
#
# DR-6.2 — the write is atomic (tmp+rename via _atomic_write, not a bare
# redirect a crash/SIGKILL mid-write could truncate) and self-healing: an
# absent OR empty/corrupted file both regenerate rather than sticking as a
# permanently-broken device_id.
#
# DR-6.3 — every caller here (_spawn_runtime, _open_session_spine,
# _bootstrap_first_slug) already runs AFTER cmd_open's/cmd_start's
# `_has_cert || _setup_mode` gate at the top of each command — measured, not
# assumed: `_setup_mode` always `exit 0`s (no fallthrough), so control only
# reaches _start_proxy/_spawn_runtime once a cert exists. Combined with
# _spawn_runtime resolving device_id INLINE on the same line that launches
# the daemon (`HIVEMIND_DEVICE_ID="$(_resolve_device_id)" nohup ...`), the
# daemon is never spawned before device-id exists on a fresh machine — no
# separate reordering was needed once these two facts are put together.
#
# DR-6.4 — device_id is CROSS-CHECKED against the enrolled cert's SHA-256
# fingerprint (~/.engram/device-id-cert-binding), never DERIVED from it — a
# cert renewal on the SAME machine must not churn device_id (see the plan
# for why derive-from was rejected). Mismatch (re-enrollment, or device-id
# copied to a machine without its matching cert) regenerates device_id +
# rebinds to the current cert, loudly logged — never silent.
_resolve_device_id() {
  local _id_file="${HOME}/.engram/device-id"
  local _binding_file="${HOME}/.engram/device-id-cert-binding"

  # DR-6.2: validate-on-read. `-s` is false for both "absent" and "present
  # but empty/truncated" — one branch self-heals both cases.
  [ -s "${_id_file}" ] || _regenerate_device_id "${_id_file}"

  # DR-6.4: only meaningful once a cert actually exists — pre-enrollment
  # callers (degenerate today, see DR-6.3 above) just skip this block;
  # device_id is already durable from the step above, only unbound until
  # enrollment completes (the binding is written the first time this runs
  # with a cert present).
  local _owner="${HIVEMIND_OWNER:-}"
  local _cert_file="${CERT_DIR}/${_owner}.cert.pem"
  if [ -n "${_owner}" ] && [ -f "${_cert_file}" ] && command -v openssl > /dev/null 2>&1; then
    local _fp
    _fp="$(_cert_fingerprint_sha256 "${_cert_file}")"
    if [ -n "${_fp}" ]; then
      if [ -s "${_binding_file}" ] && [ "$(cat "${_binding_file}")" != "${_fp}" ]; then
        echo "[hivemind] device_id/cert binding MISMATCH — cert changed (re-enrollment) or device-id was copied from another machine. Regenerating device_id and rebinding to the current cert." >&2
        _regenerate_device_id "${_id_file}"
      fi
      # First bind (no binding file yet) or just-regenerated above — write/
      # refresh the binding against the CURRENT cert either way.
      _atomic_write "${_binding_file}" "${_fp}"
    fi
  fi

  cat "${_id_file}"
}

# _mint_uuid: RFC4122 uuid via uuidgen, /proc fallback, then a last-resort
# non-RFC4122-but-locally-unique fallback. Extracted from
# _regenerate_device_id's inline chain (Fase 6) so item 18cff9b7's port-map
# device_id minting (_resolve_target_port_and_device_id below) shares the
# exact same fallback discipline instead of duplicating it — the two are
# independent identity namespaces (~/.engram/device-id vs a per-target
# device_id inside port-map.json), but "how do we mint a uuid on this
# machine" is one concern, not two.
_mint_uuid() {
  if command -v uuidgen > /dev/null 2>&1; then
    uuidgen
  elif [ -r /proc/sys/kernel/random/uuid ]; then
    cat /proc/sys/kernel/random/uuid
  else
    # Last-resort fallback (no uuidgen, no /proc — e.g. some minimal
    # containers): not RFC4122, but stable across runs on THIS machine,
    # which is all a device_id needs to be.
    printf '%s-%s-%s' "$(hostname)" "$(date +%s)" "$$"
  fi
}

# _regenerate_device_id: mint a fresh uuid and persist it atomically
# (DR-6.2). Shared by first-creation and self-heal/rebind paths.
_regenerate_device_id() {
  local _id_file="$1"
  mkdir -p "$(dirname "${_id_file}")"
  _atomic_write "${_id_file}" "$(_mint_uuid)"
}

# _atomic_write: write $2 (+ trailing newline) to $1 via tmp+rename (DR-6.2)
# — a crash/SIGKILL mid-write leaves the ORIGINAL file untouched instead of
# a truncated one. `.tmp.$$` keys the scratch file to this process so two
# concurrent first-run writers (fresh machine, two `hivemind` windows at
# once) never clobber each other's in-flight tmp file — the `mv` is still a
# last-writer-wins race between the two, which is an accepted, named window
# (both produce a valid value; only "which one survives" is unspecified),
# not a corruption risk.
_atomic_write() {
  local _path="$1" _content="$2" _tmp
  _tmp="${_path}.tmp.$$"
  printf '%s\n' "${_content}" > "${_tmp}"
  mv "${_tmp}" "${_path}"
}

# _cert_fingerprint_sha256: SHA-256 fingerprint of a cert (DR-6.4), colon-
# separated hex after the `=`. `cut -d= -f2` rather than matching a literal
# "SHA256 Fingerprint=" prefix: measured openssl on this box prints the
# lowercase "sha256 Fingerprint=" label (casing is openssl-version-
# dependent) — splitting on `=` sidesteps that instead of guessing a prefix
# that might not match every build.
_cert_fingerprint_sha256() {
  local _cert="$1"
  openssl x509 -in "${_cert}" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2
}

# _mcp_call: POST a JSON-RPC tools/call to the local mTLS proxy; prints the
# raw SSE "data:" payload line (prefix stripped), or nothing on any failure
# (network, auth, malformed response). Never trips errexit — `|| true` is
# unconditional on the pipeline regardless of which stage would otherwise
# fail. The proxy forwards EVERY local path to the single fixed upstream it's
# built for (mtls-proxy.ts: cfg.upstream, incoming path ignored) — /v1/mcp
# here is for readability/parity with the upstream URL shape, not a routing
# requirement.
_mcp_call() {
  local _tool="$1" _args_json="$2" _id="$3"
  curl -s --max-time 5 \
    -H "x-fos-key: ${FOS_API_KEY:-}" \
    -H "Content-Type: application/json" \
    -H "Accept: application/json, text/event-stream" \
    -d "{\"jsonrpc\":\"2.0\",\"id\":${_id},\"method\":\"tools/call\",\"params\":{\"name\":\"${_tool}\",\"arguments\":${_args_json}}}" \
    "https://127.0.0.1:${PROXY_PORT}/v1/mcp" 2>/dev/null \
    | grep "^data:" | head -1 | sed 's/^data: //' || true
}

# _mcp_result_field: extract one field from an MCP tool result. Two
# JSON.parse hops — the outer JSON-RPC envelope, then result.content[0].text
# (the tool's own JSON payload, per the MCP tool-result convention:
# content:[{type:'text', text:JSON.stringify(result)}]). Uses bun — already a
# hard dependency of this script (checked in _start_proxy) — no new
# dependency introduced. Prints nothing on any parse failure.
_mcp_result_field() {
  local _envelope="$1" _field="$2"
  [ -n "${_envelope}" ] || return 0
  bun -e '
    try {
      const envelope = JSON.parse(process.argv[1]);
      const inner = JSON.parse(envelope.result.content[0].text);
      const v = inner[process.argv[2]];
      if (v !== undefined && v !== null) console.log(v);
    } catch {}
  ' "${_envelope}" "${_field}" 2>/dev/null || true
}

# _open_session_spine: opens the fos_session for this launch and sets globals
# ENGRAM_SESSION_ID / ENGRAM_DEVICE_ID (read by cmd_open's final exec).
# $1 = project slug.
#
# BEST-EFFORT (deliberate divergence from silken-runtime, which hard-aborts
# on an empty session_id): this is the shipped client — a flaky network or a
# transient engram outage must not block the user from opening Claude at all.
# A missing ENGRAM_SESSION_ID just degrades /boot (no next_note surfaced) and
# /end-session (no real close — the watchdog reclaims the orphan) rather than
# refusing to start.
#
# NO auto-registration (WS-0.3.3 — REMOVED, F2.1). A prior version silently
# upserted the slug into the registry on the first slug_not_found here (dupla
# cobertura). That silently created a registry row for any typo'd/unknown slug
# on the user's behalf — the exact behavior the explicit slug-selection work
# (F2.2 picker) and explicit first-project bootstrap (F3.2, confirmed create)
# replace. Slug existence is now settled BEFORE this function runs (cmd_open
# resolves via arg / picker / confirmed bootstrap). If a slug still turns up
# unknown here, we DEGRADE (best-effort, no session) — we do NOT create it.
# This comment is a headstone, not an invitation: do not reintroduce the
# auto-upsert.
_open_session_spine() {
  local _slug="$1"
  ENGRAM_DEVICE_ID="$(_resolve_device_id)"
  ENGRAM_SESSION_ID=""

  if [ -z "${FOS_API_KEY:-}" ]; then
    _vecho "[hivemind] FOS_API_KEY ausente — sem sessão nesta janela (enrollment incompleto?)"
    return 0
  fi

  local _open_args _resp _err_field _session_id
  _open_args="{\"action\":\"open\",\"slug\":\"${_slug}\",\"mode\":\"manual-cli\",\"device_id\":\"${ENGRAM_DEVICE_ID}\",\"pid\":$$}"
  _resp="$(_mcp_call "fos_session" "${_open_args}" 1)"
  _err_field="$(_mcp_result_field "${_resp}" "_err")"

  # slug_not_found here is now a DEGRADE, not a trigger to auto-create (F2.1).
  # The slug was resolved/created explicitly upstream (arg / picker / bootstrap);
  # an unknown slug at this point means we simply open Claude with no session
  # spine rather than silently minting a registry row.
  if [ "${_err_field}" = "slug_not_found" ]; then
    _vecho "[hivemind] slug '${_slug}' desconhecido no registry — seguindo sem espinha de sessão (sem auto-registro)"
    return 0
  fi

  _session_id="$(_mcp_result_field "${_resp}" "session_id")"
  if [ -z "${_session_id}" ]; then
    _vecho "[hivemind] fos_session open não retornou session_id — seguindo sem espinha de sessão nesta janela"
    return 0
  fi

  ENGRAM_SESSION_ID="${_session_id}"

  # Adopt-back (decision 3cab5d01, Option B device-identity): fos_session(open)'s
  # response now echoes device_id — supplied-and-reused (the normal case here,
  # since we always sent one from _resolve_device_id above) or freshly minted
  # (only for callers who had none — never us, DR-6.1-6.4 already resolves one
  # locally before this point). If it ever differs from what we sent, the
  # server's answer is treated as canonical and persisted the same atomic way
  # _regenerate_device_id does. In steady state this is a no-op echo — see
  # DR-6.3/_spawn_runtime's unavoidable local-bootstrap need, unchanged here.
  #
  # code-review fix: this is a TRUST-DIRECTION change — the server is telling
  # the client to overwrite its own local identity file — so it now logs at
  # the SAME unconditional visibility as the cert/device-id binding-mismatch
  # path above (_resolve_device_id, "MISMATCH — cert changed..."), not just
  # -v. And the value is now shape-VALIDATED as a UUID before either being
  # persisted OR assigned into ENGRAM_DEVICE_ID: this variable is later
  # interpolated UNESCAPED into hand-built JSON literals (e.g. this very
  # function's own _open_args above, `"device_id":"${ENGRAM_DEVICE_ID}"`) —
  # an unvalidated server string containing a `"` or `\` would corrupt that
  # JSON or inject fields into subsequent calls. A response that fails the
  # shape check is DROPPED (kept on the locally-resolved id) rather than
  # adopted, and reported unconditionally so it's never silently ignored.
  local _server_device_id
  _server_device_id="$(_mcp_result_field "${_resp}" "device_id")"
  if [ -n "${_server_device_id}" ] && [ "${_server_device_id}" != "${ENGRAM_DEVICE_ID}" ]; then
    case "${_server_device_id}" in
      [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]-[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
        echo "[hivemind] device_id adotado do servidor: ${_server_device_id} (era ${ENGRAM_DEVICE_ID})" >&2
        _atomic_write "${HOME}/.engram/device-id" "${_server_device_id}"
        ENGRAM_DEVICE_ID="${_server_device_id}"
        ;;
      *)
        echo "[hivemind] aviso: servidor propôs device_id '${_server_device_id}' fora do formato UUID esperado — ignorado, mantendo o local (${ENGRAM_DEVICE_ID})" >&2
        ;;
    esac
  fi

  _vecho "[hivemind] sessão aberta: ${ENGRAM_SESSION_ID} (slug=${_slug})"
}

# ── Slug selection (F2.2 / F3) ────────────────────────────────────────────────
# The registry is owner-scoped SERVER-SIDE (every read is scoped to the owner
# derived from your certificate), so `fos_registry(action:list)` already returns
# ONLY this owner's slugs — the client never filters by owner and cannot see
# another's. Response envelope: {items:[{slug,name,status,...}], count}.

# _list_slugs: populate _SLUGS_RAW ("slug<TAB>name" lines, active only) for the
# current owner. Returns 0 on a VALID registry response — the list may be EMPTY
# (a genuine count:0 for an owner with no projects yet, the F3 bootstrap case).
# Returns 1 on transport/parse failure (no API key, proxy/network down,
# malformed payload). The caller MUST distinguish these two (F3.1): an EMPTY
# list means "bootstrap first project", an UNREACHABLE registry means "abort,
# don't guess" — collapsing them would silently offer to create a duplicate of
# an existing project during a network blip.
_list_slugs() {
  _SLUGS_RAW=""
  [ -n "${FOS_API_KEY:-}" ] || return 1
  local _resp
  _resp="$(_mcp_call "fos_registry" '{"action":"list"}' 1)"
  [ -n "${_resp}" ] || return 1
  local _out
  # bun exits 3 on parse failure / missing items array → the `||` maps that
  # (and any bun failure) to return 1. A valid empty array exits 0 with no
  # output → _SLUGS_RAW="" + return 0 (the count:0 bootstrap signal).
  _out="$(bun -e '
    try {
      const env = JSON.parse(process.argv[1]);
      const inner = JSON.parse(env.result.content[0].text);
      if (!inner || !Array.isArray(inner.items)) process.exit(3);
      for (const it of inner.items) {
        if (it.status && it.status !== "active") continue;
        if (!it.slug) continue;
        process.stdout.write(`${it.slug}\t${it.name || it.slug}\n`);
      }
    } catch { process.exit(3); }
  ' "${_resp}" 2>/dev/null)" || return 1
  _SLUGS_RAW="${_out}"
  return 0
}

# ── Double-access lock (Fase 7, DR-7.A) ───────────────────────────────────────
# Intentional feature, not a bug: a slug already held by a live session on
# THIS device must never be opened a second time concurrently. The founder's
# 3-case model (plan doc, Fase 7): (1) holder ALIVE → block, (2) holder
# PAUSED-but-pid-alive → the daemon's own reconcile revives it automatically
# (Fase 2, no lock involvement), (3) holder pid DEAD → block too, but point
# at `hivemind resume <slug>` (DR-7.C) instead of reopening silently.

# _fetch_lock_table: one fos_session(list_active) call, filtered to THIS
# device only (never a slug/pid belonging to another machine — same filter
# discipline as DR-2.3's reconcile). Sets _LOCK_TABLE as
# "slug<TAB>session_id<TAB>pid" lines — the single source both cmd_open's
# pre-open check and _pick_project's picker markers read from, so the two
# never disagree about what is held. Best-effort: empty table on any
# transport/parse failure — callers degrade to "nothing held" rather than
# blocking the user over a network blip.
_fetch_lock_table() {
  _LOCK_TABLE=""
  [ -n "${FOS_API_KEY:-}" ] || return 0
  local _dev="$1" _resp
  _resp="$(_mcp_call "fos_session" '{"action":"list_active"}' 1)"
  [ -n "${_resp}" ] || return 0
  _LOCK_TABLE="$(bun -e '
    try {
      const envelope = JSON.parse(process.argv[1]);
      const inner = JSON.parse(envelope.result.content[0].text);
      const dev = process.argv[2];
      const items = Array.isArray(inner.items) ? inner.items : [];
      for (const it of items) {
        if (it.device_id !== dev) continue;
        process.stdout.write(`${it.slug}\t${it.session_id}\t${it.pid ?? ""}\n`);
      }
    } catch {}
  ' "${_resp}" "${_dev}" 2>/dev/null)"
}

# _lock_state_for_slug: look up $2=slug inside a _fetch_lock_table result
# ($1). Local pid liveness is checked HERE, not baked into the table, since
# it can legitimately change between the fetch and the check. Sets
# _LOCK_STATE (""|alive|dead), _LOCK_SESSION_ID, _LOCK_PID.
#
# Ambiguous pid (empty — a session opened by something other than this CLI,
# e.g. no pid on record) is classified "alive", NEVER "dead" — this is the
# same guard DR-7.C's spec states explicitly ("never presume dead on an
# ambiguous check"), applied here too so DR-7.A and DR-7.C never disagree
# about what counts as dead.
_lock_state_for_slug() {
  _LOCK_STATE=""; _LOCK_SESSION_ID=""; _LOCK_PID=""
  local _table="$1" _slug="$2" _s _sid _pid
  while IFS=$'\t' read -r _s _sid _pid; do
    [ "${_s}" = "${_slug}" ] || continue
    _LOCK_SESSION_ID="${_sid}"
    _LOCK_PID="${_pid}"
    if [ -n "${_pid}" ] && kill -0 "${_pid}" 2>/dev/null; then
      _LOCK_STATE="alive"
    elif [ -z "${_pid}" ]; then
      _LOCK_STATE="alive"
    else
      _LOCK_STATE="dead"
    fi
    return 0
  done <<< "${_table}"
}

# _pick_project — render this owner's slugs and set _PICKED_SLUG. Mirrors
# silken-runtime:_pick_project (fzf when available; numbered-read fallback;
# same color scheme + Ctrl-C/Ctrl-D → 130). Input: _SLUGS_RAW (from
# _list_slugs). Also mirrors silken-runtime's greying-out of slugs with a
# live session on this device (Fase 7, DR-7.A) — previously omitted here
# because this product had no equivalent lock at all; DR-7.A adds it, and
# distinguishes ALIVE (in use) from DEAD (crashed, points at `hivemind
# resume`) where silken-runtime's picker does not.
_pick_project() {
  _PICKED_SLUG=""
  local -a slugs names
  local _s _n
  while IFS=$'\t' read -r _s _n; do
    [ -n "${_s}" ] || continue
    slugs+=("${_s}"); names+=("${_n:-$_s}")
  done <<< "${_SLUGS_RAW}"

  local n="${#slugs[@]}"
  if [ "${n}" -eq 0 ]; then
    return 1
  fi

  # DR-7.A: one lock-table fetch for the whole picker (not per-slug) — marks
  # ALIVE vs DEAD holders in the render below and keeps both out of the
  # selectable menu. This is UX only — cmd_open re-checks the ACTUAL picked
  # slug's lock state fresh, right before opening (TOCTOU-safe); a stale
  # marker here can at worst show a slug as free that the fresh check then
  # blocks, never the other way (silently opening a held slug).
  local _dev_id
  _dev_id="$(_resolve_device_id)"
  _fetch_lock_table "${_dev_id}"
  local -a states
  local i
  for ((i=0; i<n; i++)); do
    _lock_state_for_slug "${_LOCK_TABLE}" "${slugs[$i]}"
    states+=("${_LOCK_STATE}")
  done

  local C_HEAD C_NUM C_RSTL C_BLOCK
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_HEAD=$'\033[1;36m'; C_NUM=$'\033[1;33m'; C_BLOCK=$'\033[2;31m'; C_RSTL=$'\033[0m'
  else
    C_HEAD=""; C_NUM=""; C_BLOCK=""; C_RSTL=""
  fi

  printf '%s┌─ HIVEMIND ─────────────────────────────────────┐%s\n' "$C_HEAD" "$C_RSTL" >&2
  printf '%s│  Selecione o projeto                           │%s\n' "$C_HEAD" "$C_RSTL" >&2
  printf '%s├────────────────────────────────────────────────┤%s\n' "$C_HEAD" "$C_RSTL" >&2
  for ((i=0; i<n; i++)); do
    case "${states[$i]}" in
      alive)
        printf '   %s[EM USO]%s   %s  %s⬡ sessão viva%s\n' \
          "$C_BLOCK" "$C_RSTL" "${names[$i]}" "$C_BLOCK" "$C_RSTL" >&2
        ;;
      dead)
        printf '   %s[TRAVADO]%s  %s  %s⬡ crashou — rode: hivemind resume %s%s\n' \
          "$C_BLOCK" "$C_RSTL" "${names[$i]}" "$C_BLOCK" "${slugs[$i]}" "$C_RSTL" >&2
        ;;
      *)
        printf '   %s%2d)%s  %s\n' "$C_NUM" "$((i+1))" "$C_RSTL" "${names[$i]}" >&2
        ;;
    esac
  done
  printf '%s└────────────────────────────────────────────────┘%s\n' "$C_HEAD" "$C_RSTL" >&2

  if command -v fzf > /dev/null 2>&1; then
    local menu="" sel idx
    for ((i=0; i<n; i++)); do
      # Blocked slugs (alive OR dead) never enter the selectable menu — they
      # already surfaced as [EM USO]/[TRAVADO] in the static render above,
      # same discipline as the numbered fallback below.
      [ -z "${states[$i]}" ] || continue
      menu+="$((i+1))	${names[$i]}"$'\n'
    done
    if [ -z "${menu}" ]; then
      printf '%s  ✗ Nenhum projeto selecionável (todos em uso ou travados neste device).%s\n' "$C_BLOCK" "$C_RSTL" >&2
      return 130
    fi
    sel=$(printf '%s' "$menu" | fzf --ansi --prompt='projeto> ' \
      --header='Enter seleciona · Esc/Ctrl-C cancela' \
      --with-nth=2.. --delimiter='\t') || return 130
    idx=$(printf '%s' "$sel" | cut -f1)
    [ -z "$idx" ] && return 130
    _PICKED_SLUG="${slugs[$((idx-1))]}"
  else
    local choice
    while :; do
      printf '%s  → número [1-%d] (Ctrl-C cancela): %s' "$C_NUM" "$n" "$C_RSTL" >&2
      if ! IFS= read -r choice; then
        echo "" >&2; return 130
      fi
      case "$choice" in
        ''|*[!0-9]*)
          printf '%s  ✗ Entrada inválida.%s\n' "$C_BLOCK" "$C_RSTL" >&2; continue ;;
      esac
      if [ "$choice" -lt 1 ] || [ "$choice" -gt "$n" ]; then
        printf '%s  ✗ Fora do intervalo.%s\n' "$C_BLOCK" "$C_RSTL" >&2; continue
      fi
      if [ -n "${states[$((choice-1))]}" ]; then
        printf '%s  ✗ Projeto já está em uso ou travado neste device. Escolha outro.%s\n' "$C_BLOCK" "$C_RSTL" >&2
        continue
      fi
      _PICKED_SLUG="${slugs[$((choice-1))]}"
      break
    done
  fi
  return 0
}

# _bootstrap_first_slug — owner has ZERO projects (F3.2). Creates the FIRST
# project EXPLICITLY: the name is always asked/confirmed from the human, NEVER
# derived from basename(cwd) or any other heuristic (decision 6e14806d, founder
# 2026-07-13 — the fos-web Project Hub is read-only, there is nothing to
# mirror; this is the first create surface, not a mirror). Sets _BOOTSTRAP_SLUG
# on success; leaves it empty + returns non-zero on decline/empty input.
# $1 = slug from an explicit `hivemind <slug>` arg ("" when none was given).
#
# ARCHITECTURAL NOTE (registered, not resolved here — out of scope):
# creating a slug is a MUTATION. This is currently the ONLY client-side
# slug-create surface. If the Project Hub ever grows a create
# button, it MUST converge on this SAME fos_registry(action:upsert) call — not
# a second, divergent create path.
_bootstrap_first_slug() {
  local _arg_slug="${1:-}"
  _BOOTSTRAP_SLUG=""
  local _name _slug _reply

  echo "" >&2
  echo "Nenhum projeto encontrado para esta conta." >&2

  if [ -n "${_arg_slug}" ]; then
    # Name already came from the human (the explicit arg) — only confirm.
    printf 'Criar "%s" como seu primeiro projeto? [y/N] ' "${_arg_slug}" >&2
    IFS= read -r _reply || return 1
    case "${_reply}" in
      y|Y|yes|YES|s|S|sim|SIM)
        # code-review FIX 1: the arg was used VERBATIM as the slug — a
        # human-typed arg with spaces/symbols (e.g. `hivemind "Foo Bar"`)
        # produced a malformed, non-path/URL-safe slug ("Foo Bar"). Run the
        # SAME normalization as the no-arg path (:909) over the slug only —
        # `_name` stays the arg verbatim (what the human actually typed/
        # confirmed), only the SLUG is ASCII-folded/validated.
        _name="${_arg_slug}"
        _slug="$(printf '%s' "${_arg_slug}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed -e 's/^-*//' -e 's/-*$//')"
        if [ -z "${_slug}" ]; then
          echo "Argumento não produz um slug válido (use letras/números) — nada criado." >&2
          return 1
        fi
        ;;
      *) echo "Cancelado — nada criado." >&2; return 1 ;;
    esac
  else
    # No arg — ask the name from scratch, WITHOUT pre-filling/suggesting.
    printf 'Como você quer chamar seu primeiro projeto? ' >&2
    IFS= read -r _name || return 1
    _name="$(printf '%s' "${_name}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [ -z "${_name}" ]; then
      echo "Nome vazio — nada criado." >&2
      return 1
    fi
    # Derive a filesystem/URL-safe slug from the typed name (lowercase, runs of
    # non-alnum → single '-', trimmed). Mechanical normalization of the human's
    # own input — not a suggested default. Shown before create for transparency.
    _slug="$(printf '%s' "${_name}" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed -e 's/^-*//' -e 's/-*$//')"
    if [ -z "${_slug}" ]; then
      echo "Nome não produz um slug válido (use letras/números) — nada criado." >&2
      return 1
    fi
    printf 'Criando projeto "%s" (slug: %s)...\n' "${_name}" "${_slug}" >&2
  fi

  # Build the upsert args with bun so name/slug are JSON-escaped safely (a name
  # with a quote/backslash would otherwise corrupt hand-built JSON).
  local _dev _upsert_args
  _dev="$(_resolve_device_id)"
  _upsert_args="$(bun -e '
    const [slug, name, dev] = process.argv.slice(1);
    process.stdout.write(JSON.stringify({
      action: "upsert", slug, name,
      mode: "self-managed", kind: "product", status: "active",
      device_id: dev, registry_upsert_confirmation: true,
    }));
  ' "${_slug}" "${_name}" "${_dev}" 2>/dev/null)"
  if [ -z "${_upsert_args}" ]; then
    echo "Erro: falha ao montar a requisição de criação — nada criado." >&2
    return 1
  fi
  _mcp_call "fos_registry" "${_upsert_args}" 1 > /dev/null
  _BOOTSTRAP_SLUG="${_slug}"
  return 0
}

# _seed_engram_mcp_config: re-assert mcpServers.engram in
# $HIVEMIND_HOME/.claude/.claude.json at OPEN time (papercut d,
# pattern_hivemind-runtime-mcp-config-is-user-scope-not-project-mcp-json,
# measured 2026-08-04).
#
# WHY: cmd_open execs `claude --setting-sources user`, so Claude Code
# discovers MCP servers ONLY from this user-scope file. The enrollment-time
# seed (routes/setup.ts ~387-440) writes it ONCE, but Claude Code itself can
# clobber the file on exit — leaving a future `/mcp` with no engram entry
# until someone hand-reseeds it. Re-running the same merge-safe write on
# every open closes that gap without ever needing a second source of truth.
#
# MERGE-SAFE, mirrors setup.ts's write EXACTLY (do not reinvent): preserve
# every OTHER top-level key and every OTHER mcpServers.* entry; overwrite
# ONLY mcpServers.engram; self-heal a missing/corrupted/non-object top-level
# document AND a missing/null/array `mcpServers` to {} rather than throwing.
# NO headers, NO FOS_API_KEY or other secret material in the written entry —
# the mTLS proxy injects x-fos-key server-side (atomic-flip, round-2
# 2026-07-30; setup.ts:414-423) — so this file, readable by anything with fs
# access to $HIVEMIND_HOME, carries zero secrets regardless of who wrote or
# reads it. Atomic write (temp file + rename) + chmod 0600, same posture as
# setup.ts's own write of this file.
#
# No new dependency: bun is already a hard requirement of this script
# (checked in _start_proxy) and is what setup.ts itself runs under, so this
# reuses the same JS runtime rather than introducing a `node`/`jq` dependency.
#
# BEST-EFFORT (same fail-soft posture as _open_session_spine above, "engram
# outage must not block opening Claude"): any failure here (disk full,
# permissions, a transient bun hiccup) is logged via _vecho and swallowed —
# it only degrades the NEXT session's /mcp discovery, never blocks THIS
# session from opening Claude. Idempotent: running it twice back-to-back
# produces byte-identical output on the second run.
# _write_generic_mcp_config: the same merge-safe mcpServers.engram write,
# EXTRACTED so it can target an ARBITRARY path — not just Claude Code's own
# $HIVEMIND_HOME/.claude/.claude.json. Shared by _seed_engram_mcp_config
# below (Claude Code's user-scope file) and `hivemind install`'s carrier
# (P2, item ef1c9385 — reuse, don't reinvent) for any OTHER local client's
# own mcp.json-shaped config. $1 = absolute path to write/merge, $2 = port.
#
# PORT IS NOW AN EXPLICIT REQUIRED ARG (Option 2, item 18cff9b7) — this used
# to hardcode the implicit shared "${PROXY_PORT}" as its 2nd positional bun
# arg; every caller now decides which port an entry points at.
# _seed_engram_mcp_config (Claude Code's own self-seed) still passes
# "${PROXY_PORT}" explicitly — that entry stays on the shared/default port,
# unchanged behavior. `hivemind install`'s guided flow (_install_run) now
# passes a DEDICATED port allocated by _resolve_target_port_and_device_id
# below, instead.
#
# Same contract as before this extraction (behavior-preserving refactor):
# preserve every other top-level key + mcpServers.* entry; self-heal a
# missing/corrupted/non-object document AND a missing/null/array
# `mcpServers` to {} rather than throwing; atomic tmp+rename; chmod 0600;
# NO headers/FOS_API_KEY or other secret material in the written entry — the
# mTLS proxy injects the credential server-side (decision `bee7f370`:
# HTTPS-loopback-by-default, no stdio, no header/${VAR} dependency for any
# client). Returns bun's exit status — 0 on a clean write, non-zero on any
# failure (disk full, permissions, malformed args) — callers decide whether
# a failure is fail-soft (re-seed) or fail-loud (a fresh `install`).
_write_generic_mcp_config() {
  local _target_path="$1"
  local _port="$2"
  bun -e '
    import { existsSync, readFileSync, writeFileSync, renameSync, chmodSync, mkdirSync } from "node:fs";
    import { dirname } from "node:path";

    const configPath = process.argv[1];
    const proxyPort = process.argv[2];

    let existing = {};
    if (existsSync(configPath)) {
      try {
        const parsed = JSON.parse(readFileSync(configPath, "utf8"));
        if (typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)) {
          existing = parsed;
        }
        // else: corrupted/non-object document → {} (never throws, never
        // aborts the caller — same "corrompido → {}" contract as setup.ts).
      } catch { /* unparseable → {} */ }
    }

    let existingServers = existing.mcpServers;
    if (typeof existingServers !== "object" || existingServers === null || Array.isArray(existingServers)) {
      existingServers = {};
    }

    const merged = {
      ...existing,
      mcpServers: {
        ...existingServers,
        engram: { type: "http", url: `https://127.0.0.1:${proxyPort}/v1/mcp` },
      },
    };

    mkdirSync(dirname(configPath), { recursive: true });
    const tmpPath = `${configPath}.tmp-${process.pid}`;
    writeFileSync(tmpPath, JSON.stringify(merged, null, 2), { mode: 0o600 });
    renameSync(tmpPath, configPath);
    chmodSync(configPath, 0o600);
  ' "${_target_path}" "${_port}"
  # code-review fix: stderr used to be swallowed HERE (`2>/dev/null` on the
  # bun invocation), which made every caller's failure branch blind — in
  # particular _install_run's interactive "✗ falha ao gravar <path>" (below)
  # showed NO reason at all (permission denied, disk full, ...), the exact
  # moment a human is standing there waiting to know why. Left un-swallowed
  # now; each caller decides what to do with stderr — _seed_engram_mcp_config
  # (best-effort, non-blocking re-seed) captures it into its own -v-gated
  # line, _install_run (interactive, blocking) surfaces it directly.
}

_seed_engram_mcp_config() {
  local _claude_config="${HIVEMIND_HOME}/.claude/.claude.json"
  local _seed_err
  if ! _seed_err="$(_write_generic_mcp_config "${_claude_config}" "${PROXY_PORT}" 2>&1)"; then
    _vecho "[hivemind] aviso: falha ao re-selar mcpServers.engram em .claude.json (não bloqueante)${_seed_err:+: ${_seed_err}}"
  fi
  return 0
}

# ── Option 2 per-target proxy — port-map.json helpers (item 18cff9b7) ───────
# Full design: fos_sketchpad 4f8142e3 § ADDENDUM 3. `hivemind install
# <target>` allocates a DEDICATED loopback port + mints a device_id per
# installed target, persisted to PORT_MAP_FILE — read at daemon boot and on
# every POST /internal/proxy/reload by runtime/src/lib/mtls-proxy.ts's
# startAllMtlsProxies()/reloadNewProxyListeners(). Shape: {"version":1,
# "entries":[{"path","target_id","scope","port","device_id","created_at",
# "updated_at"}]}, keyed on `path` (the resolved absolute config file path —
# unique per installed target/scope combination).

# _port_map_used_ports: prints every entries[].port on its own line. Never
# throws — same self-heal posture as every other JSON read in this file
# (absent/corrupted file, non-array entries, or a non-numeric port on any one
# entry all degrade to "not used", never abort the caller).
_port_map_used_ports() {
  bun -e '
    import { existsSync, readFileSync } from "node:fs";
    const mapPath = process.argv[1];
    if (!existsSync(mapPath)) process.exit(0);
    try {
      const parsed = JSON.parse(readFileSync(mapPath, "utf8"));
      const entries = Array.isArray(parsed?.entries) ? parsed.entries : [];
      for (const e of entries) {
        if (e && typeof e.port === "number") console.log(e.port);
      }
    } catch { /* corrupted -> no used ports on record */ }
  ' "${PORT_MAP_FILE}" 2>/dev/null
}

# _port_map_lookup: prints "<port>\t<device_id>" for the entry whose `path`
# matches $1, or nothing (empty stdout) if PORT_MAP_FILE is absent/corrupted/
# has no matching entry. Never throws.
_port_map_lookup() {
  local _path="$1"
  bun -e '
    import { existsSync, readFileSync } from "node:fs";
    const mapPath = process.argv[1];
    const targetPath = process.argv[2];
    if (!existsSync(mapPath)) process.exit(0);
    try {
      const parsed = JSON.parse(readFileSync(mapPath, "utf8"));
      const entries = Array.isArray(parsed?.entries) ? parsed.entries : [];
      const hit = entries.find((e) => e && e.path === targetPath);
      if (hit && typeof hit.port === "number" && typeof hit.device_id === "string") {
        console.log(`${hit.port}\t${hit.device_id}`);
      }
    } catch { /* corrupted -> no match, caller allocates fresh */ }
  ' "${PORT_MAP_FILE}" "${_path}" 2>/dev/null
}

# _port_map_write_entry: merge-safe upsert of ONE entry, keyed on `path` (any
# prior entry for the same path is replaced, preserving its created_at).
# Atomic tmp+rename + chmod 0600 — same posture as _write_generic_mcp_config.
# $1=path $2=target_id $3=scope $4=port $5=device_id.
_port_map_write_entry() {
  local _path="$1" _target_id="$2" _scope="$3" _port="$4" _device_id="$5"
  bun -e '
    import { existsSync, readFileSync, writeFileSync, renameSync, chmodSync, mkdirSync } from "node:fs";
    import { dirname } from "node:path";

    const mapPath  = process.argv[1];
    const path_    = process.argv[2];
    const targetId = process.argv[3];
    const scope    = process.argv[4];
    const port     = Number(process.argv[5]);
    const deviceId = process.argv[6];

    let doc = { version: 1, entries: [] };
    if (existsSync(mapPath)) {
      try {
        const parsed = JSON.parse(readFileSync(mapPath, "utf8"));
        if (parsed && typeof parsed === "object" && Array.isArray(parsed.entries)) {
          doc = parsed;
        }
        // else: corrupted/non-shaped document -> start fresh {version:1,
        // entries:[]} rather than throwing (same self-heal contract as every
        // other JSON read/write in this file).
      } catch { /* unparseable -> start fresh */ }
    }

    const priorEntries = Array.isArray(doc.entries) ? doc.entries : [];
    const prior = priorEntries.find((e) => e && e.path === path_);
    const others = priorEntries.filter((e) => !(e && e.path === path_));

    const now = new Date().toISOString();
    const entry = {
      path: path_,
      target_id: targetId || undefined,
      scope: scope || undefined,
      port,
      device_id: deviceId,
      created_at: (prior && prior.created_at) || now,
      updated_at: now,
    };

    const merged = { version: 1, entries: [...others, entry] };

    mkdirSync(dirname(mapPath), { recursive: true, mode: 0o700 });
    const tmpPath = `${mapPath}.tmp-${process.pid}`;
    writeFileSync(tmpPath, JSON.stringify(merged, null, 2), { mode: 0o600 });
    renameSync(tmpPath, mapPath);
    chmodSync(mapPath, 0o600);
  ' "${PORT_MAP_FILE}" "${_path}" "${_target_id}" "${_scope}" "${_port}" "${_device_id}"
}

# _allocate_target_port: lowest free port in
# [MTLS_INSTALL_PORT_RANGE_START, MTLS_INSTALL_PORT_RANGE_END] not already a
# port-map entries[].port. Prints the chosen port on stdout; on range
# exhaustion, prints nothing and returns 1 with a message on stderr (max
# targets = range size, 100 by default) rather than silently colliding.
_allocate_target_port() {
  local _used
  _used="$(_port_map_used_ports)"
  local _p
  for ((_p = MTLS_INSTALL_PORT_RANGE_START; _p <= MTLS_INSTALL_PORT_RANGE_END; _p++)); do
    if ! printf '%s\n' "${_used}" | grep -qx "${_p}"; then
      echo "${_p}"
      return 0
    fi
  done
  echo "Erro: intervalo de portas para 'hivemind install' esgotado (${MTLS_INSTALL_PORT_RANGE_START}-${MTLS_INSTALL_PORT_RANGE_END}) — máximo de alvos instalados atingido." >&2
  return 1
}

# _resolve_target_port_and_device_id: idempotent port+device_id resolution
# for `hivemind install`. Keyed on the resolved absolute config file PATH
# (the same value _install_run computes as _final_path) — re-running install
# against an ALREADY-mapped path REUSES that entry's existing port+device_id
# rather than reallocating (self-heal, no-silent-reallocate posture, mirrors
# _write_generic_mcp_config's own idempotency). $1=path $2=target_id $3=scope.
# Prints "<port>\t<device_id>" on success; returns 1 (nothing printed, error
# already on stderr via _allocate_target_port) if the range is exhausted on a
# fresh allocation.
#
# code-review FIX (TOCTOU): the lookup-then-allocate-then-write sequence used
# to run WITHOUT any cross-process lock, so N concurrent `hivemind install`s
# (or N concurrent callers of this function) could all read the SAME "used
# ports" snapshot before any of them persisted — measured: 8 concurrent
# installs all minted port 7780, and 3 of the 8 port-map entries were lost
# outright (each writer's read-merge-write raced the others' unflushed
# write). The whole read+allocate+write critical section now runs inside a
# single `flock -x` on ${PORT_MAP_FILE}.lock, so allocation and persistence
# are atomic per install — a second concurrent caller blocks until the first
# has both picked ITS port and written it to disk, and therefore always sees
# it as "used". Same lock file guards every caller (this is the ONLY writer
# of port-map.json), so this also serializes against itself when called
# twice back-to-back for different paths in the same process (idempotent
# re-install, two-distinct-targets tests below).
_resolve_target_port_and_device_id() {
  local _path="$1" _target_id="$2" _scope="$3"
  mkdir -p "$(dirname "${PORT_MAP_FILE}")" 2>/dev/null || true
  local _lock_file="${PORT_MAP_FILE}.lock"
  local _rc=0
  (
    flock -x 200
    local _existing
    _existing="$(_port_map_lookup "${_path}")"
    if [ -n "${_existing}" ]; then
      printf '%s\n' "${_existing}"
      exit 0
    fi

    local _port
    _port="$(_allocate_target_port)" || exit 1
    local _device_id
    _device_id="$(_mint_uuid)"
    _port_map_write_entry "${_path}" "${_target_id}" "${_scope}" "${_port}" "${_device_id}"
    printf '%s\t%s\n' "${_port}" "${_device_id}"
  ) 200>"${_lock_file}" || _rc=$?
  return "${_rc}"
}

# _preview_target_port: READ-ONLY preview of the port `_resolve_target_port_
# and_device_id` would return right now — reuses an existing port-map entry
# for `path` if one is already there (the idempotent re-install case, so the
# confirmation prompt shows the SAME port the commit below will reuse), or
# computes the lowest currently-free port in range for DISPLAY ONLY: no
# lock, no write, no minted device_id, no port-map.json mutation.
#
# Exists so `_install_run` can show the human "here's the port you're about
# to wire up" at the y/N confirmation WITHOUT allocating/persisting anything
# yet (code-review FIX: declining used to still leave a minted device_id +
# reserved port behind — see _resolve_target_port_and_device_id's caller in
# _install_run). Because this is a lock-free peek, under real concurrent
# installs the previewed port could in principle differ from the one
# actually committed after confirmation (another install grabs it in
# between) — cosmetic only (never a collision: the real allocation is still
# atomic), and _install_run re-displays the committed port if that happens.
# $1=path. Prints "<port>" (no device_id — not minted yet for a fresh path).
_preview_target_port() {
  local _path="$1"
  local _existing
  _existing="$(_port_map_lookup "${_path}")"
  if [ -n "${_existing}" ]; then
    printf '%s' "${_existing}" | cut -f1
    return 0
  fi
  _allocate_target_port
}

# cmd_open: start proxy + exec claude.
# $1 = slug (optional); remaining $@ passed to claude.
cmd_open() {
  local _slug="${1:-}"
  if [ $# -gt 0 ]; then shift; fi

  if ! _has_cert; then
    _setup_mode
  else
    _brand_header
  fi

  _maybe_auto_update
  _start_proxy

  # ── Resolve the project slug (F2.2 / F2.3 / F3) ──────────────────────────
  # The proxy is up now, so the owner-scoped registry is reachable for the
  # picker/bootstrap. Order: explicit arg > interactive selection/bootstrap.
  # There is deliberately NO basename(cwd) fallback (F2.3, founder-accepted
  # fail-closed): silently opening a wrong slug is worse than a clear abort.
  local _project_slug=""
  if [ -n "${_slug}" ]; then
    # Explicit arg — NEVER show the picker. If this owner has no projects yet,
    # offer to create THIS slug as the first one (F3.2, confirmed). Otherwise
    # open it as-is (an unknown slug just degrades the session spine; it is
    # never auto-created — F2.1).
    _project_slug="${_slug}"
    if [ -t 0 ] && [ -t 1 ] && _list_slugs && [ -z "${_SLUGS_RAW}" ]; then
      # code-review FIX 2: a declined/cancelled/invalid bootstrap here used to
      # be swallowed (`|| true`) and fall through to opening "${_project_slug}"
      # (the raw arg) anyway — the user said "don't create" and the
      # slug-ghost opened regardless (no registry row, degraded session).
      # Explicit decline now aborts explicitly, matching the no-arg bootstrap
      # path's behavior (:977-979) and decision 6e14806d's no-silent-creation
      # discipline. On CONFIRM, _BOOTSTRAP_SLUG is the slugified value (FIX 1)
      # — it may differ from the raw arg, so it replaces _project_slug.
      if _bootstrap_first_slug "${_project_slug}"; then
        _project_slug="${_BOOTSTRAP_SLUG}"
      else
        echo "Criação cancelada — nenhum projeto aberto." >&2
        exit 1
      fi
    fi
  elif [ -t 0 ] && [ -t 1 ]; then
    # No arg + interactive terminal: select an existing project, or bootstrap
    # the very first one.
    if _list_slugs; then
      if [ -z "${_SLUGS_RAW}" ]; then
        # count:0 — a genuine empty registry for this owner → bootstrap (F3.2).
        if _bootstrap_first_slug ""; then
          _project_slug="${_BOOTSTRAP_SLUG}"
        else
          echo "Nenhum projeto criado — encerrando." >&2
          exit 1
        fi
      else
        # count>0 — normal interactive selection (F3.1).
        local _rc=0
        _pick_project || _rc=$?
        if [ "${_rc}" -eq 130 ]; then
          echo "Seleção cancelada." >&2
          exit 130
        elif [ "${_rc}" -ne 0 ] || [ -z "${_PICKED_SLUG}" ]; then
          echo "Erro: falha ao selecionar o projeto." >&2
          exit 1
        fi
        _project_slug="${_PICKED_SLUG}"
      fi
    else
      # Registry UNREACHABLE — distinct from empty (F3.1). Do NOT guess or
      # bootstrap: creating during a network blip could duplicate an existing
      # project.
      echo "Erro: não foi possível consultar o registry (rede/proxy indisponível?) —" >&2
      echo "      não é seguro selecionar ou criar um projeto às cegas. Verifique 'hivemind status'." >&2
      exit 1
    fi
  else
    # No arg + non-interactive: fail closed (F2.3, founder-accepted). No
    # basename(cwd) fallback — automation must pass an explicit slug.
    echo "Erro: nenhum slug informado e a entrada não é um terminal interativo." >&2
    echo "      Rode 'hivemind <slug>' explicitamente em contexto não-interativo." >&2
    exit 1
  fi

  if [ -z "${_project_slug}" ]; then
    echo "Erro: nenhum projeto resolvido — encerrando." >&2
    exit 1
  fi

  # ── Fase 7 (DR-7.A) — double-access lock, THE authoritative check ────────
  # Runs BEFORE _open_session_spine/fos_session(action:'open') below, per
  # DR-3.1's sequencing note in the plan — a lock checked AFTER open() can't
  # prevent the double-open it exists to prevent. This is a FRESH fetch
  # regardless of whether the slug came from an explicit arg, the picker, or
  # bootstrap — the picker's own markers (_pick_project, above) are UX only;
  # this is the one check that actually blocks. Pitfall (named in the plan):
  # this NEVER closes/touches a held session it finds — it only detects and
  # refuses, or points at `hivemind resume`. Closing a holder here to
  # "resolve" the block would be exactly the bug this lock exists to prevent.
  local _dev_id
  _dev_id="$(_resolve_device_id)"
  _fetch_lock_table "${_dev_id}"
  _lock_state_for_slug "${_LOCK_TABLE}" "${_project_slug}"
  case "${_LOCK_STATE}" in
    alive)
      echo "" >&2
      echo "Erro: o projeto '${_project_slug}' já está em uso nesta máquina (sessão viva, pid=${_LOCK_PID})." >&2
      echo "      Feche a outra janela do HiveMind para este projeto, ou escolha outro." >&2
      exit 1
      ;;
    dead)
      echo "" >&2
      echo "Erro: o projeto '${_project_slug}' tem uma sessão anterior que parece ter travado (pid=${_LOCK_PID} não está mais rodando)." >&2
      echo "      Rode 'hivemind resume ${_project_slug}' para recuperar e reabrir." >&2
      exit 1
      ;;
  esac

  # Espinha de sessão (WS-0.3) — abre DEPOIS do proxy responder no health,
  # ANTES do exec (silken-runtime mirror). Sets ENGRAM_SESSION_ID/
  # ENGRAM_DEVICE_ID (globals, best-effort — see _open_session_spine).
  _open_session_spine "${_project_slug}"

  # Fase 3 (DR-3.1) — adopt-before-exec: register this session's pid with
  # the daemon so its pid-watcher + heartbeat (Fase 2, routes/sessions.ts)
  # start tracking it. Must run AFTER _open_session_spine (needs a real
  # ENGRAM_SESSION_ID) and BEFORE `exec` below replaces this script's process
  # image — $$ only stays valid as the tracked pid across that exec because
  # exec preserves the pid (same trick silken-runtime:376-377 relies on).
  # Best-effort, same fail-soft spirit as _open_session_spine itself: a
  # daemon hiccup here must never block the user from opening Claude.
  if [ -n "${ENGRAM_SESSION_ID}" ]; then
    curl -s -X POST --max-time 3 \
      -H "Content-Type: application/json" \
      -d "{\"session_id\":\"${ENGRAM_SESSION_ID}\",\"pid\":$$,\"slug\":\"${_project_slug}\"}" \
      "http://127.0.0.1:${RUNTIME_PORT}/sessions/adopt" > /dev/null 2>&1 || true
  fi

  # F0 auth fail-safe (item 5.0) — the isolated CONFIG_DIR may have no
  # credential at all (install.sh only seeds it best-effort from the user's
  # personal ~/.claude, and a brand-new CONFIG_DIR on a machine with no prior
  # personal login has nothing to seed from). Missing credential triggers a
  # login flow INSIDE the same isolated CONFIG_DIR, so the resulting auth
  # state stays apartada from the user's personal Claude Code account.
  # Confirmed live (G3, Claude Code CLI v2.1.207): `claude auth login`
  # authenticates-AND-EXITS (prints an OAuth URL, waits for the pasted
  # callback code, writes the credential, then returns) — it does NOT enter an
  # interactive session, so it is safe to run here and fall through to the
  # normal `exec claude` below afterwards. Fail-safe, not fail-closed: if the
  # login is skipped/cancelled/times out, we still proceed to `exec` (the
  # interactive session will show its own auth prompt if needed) — never abort
  # the whole command over auth. NOTE (P2, out of scope for this pass): this
  # only covers ABSENCE, not an EXPIRED-but-present credential — known
  # limitation.
  if [ ! -f "${HIVEMIND_HOME}/.claude/.credentials.json" ]; then
    echo ""
    echo "Nenhuma credencial encontrada no runtime isolado do HiveMind — fazendo login..."
    env CLAUDE_CONFIG_DIR="${HIVEMIND_HOME}/.claude" claude auth login || true
  fi

  # Re-assert mcpServers.engram in the user-scope .claude.json RIGHT BEFORE
  # exec (papercut d) — closes the window where a prior Claude Code exit
  # clobbered the enrollment-time seed, without depending on anything else
  # in cmd_open having run first. Best-effort, never blocks the exec below.
  _seed_engram_mcp_config

  # --setting-sources user (item 5.2, F2 isolation): the isolated CONFIG_DIR
  # already redirects commands/skills/MCP/global-CLAUDE.md (CLAUDE_CONFIG_DIR
  # above), but without this flag the user's PROJECT ./CLAUDE.md (walk-up from
  # cwd) still leaks into context — measured (P3/P4, CLI v2.1.207). This flag
  # is the scalpel that suppresses project-scoped settings/CLAUDE.md/.mcp.json
  # while keeping the product's user-scoped config intact — intentional, not
  # a side effect (re-measure if the embedded CLI version changes).
  exec env \
    CLAUDE_CONFIG_DIR="${HIVEMIND_HOME}/.claude" \
    ENGRAM_SLUG="${_project_slug}" \
    ENGRAM_SESSION_ID="${ENGRAM_SESSION_ID}" \
    ENGRAM_DEVICE_ID="${ENGRAM_DEVICE_ID}" \
    HIVEMIND_HOME="${HIVEMIND_HOME}" \
    claude --setting-sources user "$@"
}

# cmd_resume: DR-7.C — explicit crash recovery. NEVER auto-triggered; the
# founder's model is recovery != unlock — the user names the command
# themselves. $1 = slug (required, no picker here — recovery targets a
# specific known-crashed slug, not a browse-and-pick flow).
#
# Re-confirms the holder is DEAD via the SAME liveness check as DR-7.A's lock
# (_lock_state_for_slug) — the two must never disagree about what "dead"
# means. If it now reads alive, this command refuses with the SAME block
# message as cmd_open's lock — recovery is never a bypass of the lock, it is
# a separate, explicit act that only proceeds against a confirmed-dead
# holder.
#
# On confirmed-dead: close(force:true) the stale session (best-effort on the
# network call itself, but the liveness GUARD above it is never best-effort —
# an ambiguous pid check already reads "alive" per _lock_state_for_slug, so
# this command already refuses rather than guesses), then falls through to
# the normal cmd_open path for a FRESH open — same slug, same spine, same
# adopt-before-exec, but a NEW session_id (this is crash-recovery-then-open,
# not a resume of the old session's own state).
cmd_resume() {
  local _slug="${1:-}"
  if [ -z "${_slug}" ]; then
    echo "Erro: uso: hivemind resume <slug>" >&2
    exit 1
  fi

  if ! _has_cert; then
    echo "Erro: nenhum certificado encontrado — rode 'hivemind' (sem argumentos) primeiro para completar o enrollment." >&2
    exit 1
  fi
  if [ -z "${FOS_API_KEY:-}" ]; then
    echo "Erro: FOS_API_KEY ausente — enrollment incompleto?" >&2
    exit 1
  fi

  _maybe_auto_update
  _start_proxy

  local _dev_id
  _dev_id="$(_resolve_device_id)"
  _fetch_lock_table "${_dev_id}"
  _lock_state_for_slug "${_LOCK_TABLE}" "${_slug}"

  case "${_LOCK_STATE}" in
    "")
      echo "[hivemind] nenhuma sessão travada encontrada para '${_slug}' nesta máquina — abrindo normalmente." >&2
      ;;
    alive)
      echo "" >&2
      echo "Erro: o projeto '${_slug}' já está em uso nesta máquina (sessão viva, pid=${_LOCK_PID})." >&2
      echo "      Recuperação != destravar — feche a outra janela antes de tentar de novo." >&2
      exit 1
      ;;
    dead)
      echo "[hivemind] recuperando sessão travada de '${_slug}' (session_id=${_LOCK_SESSION_ID}, pid morto=${_LOCK_PID})..." >&2
      local _close_args _resp _err_field
      _close_args="{\"action\":\"close\",\"session_id\":\"${_LOCK_SESSION_ID}\",\"reason\":\"crash-recovery\",\"force\":true}"
      _resp="$(_mcp_call "fos_session" "${_close_args}" 1)"
      _err_field="$(_mcp_result_field "${_resp}" "_err")"
      if [ -n "${_err_field}" ]; then
        echo "Erro: falha ao fechar a sessão travada (${_err_field}) — nada aberto." >&2
        exit 1
      fi
      echo "[hivemind] sessão travada liberada — abrindo '${_slug}'..." >&2
      ;;
  esac

  # Hand off to the normal open path (explicit slug — cmd_open never shows
  # the picker when a slug is given). cmd_open re-runs its own DR-7.A check
  # on the way in; it will now read "" (the holder was just closed above), so
  # this is a harmless, correct re-verification rather than a duplicate lock
  # — deliberately one open path, not two divergent ones.
  cmd_open "${_slug}"
}

# ── install (P2 — guided MCP-client installer, platform-agnostic core) ──────
# `hivemind install [<target>]` walks a human through wiring the SAME generic
# entry `_seed_engram_mcp_config` already writes for Claude Code itself
# (`mcpServers.engram = {type:"http", url:"https://127.0.0.1:<port>/v1/mcp"}`,
# decision `bee7f370`: HTTPS-loopback-by-default, no stdio, no header/${VAR}
# dependency for any client — the mTLS proxy injects the credential
# server-side) into ANOTHER local client's own mcp.json-shaped config
# (Cursor, Antigravity, ...).
#
# FOUNDER CONSTRAINT — NO DEFAULT PATH, EVER: every write is preceded by an
# explicit, typed confirmation of the EXACT path about to be touched.
# Candidates are DETECTED and PRESENTED, never assumed; scope (global vs
# per-project) is ASKED, never assumed. This is why the whole command is
# TTY-gated (cmd_install below) — a guided confirmation cannot happen
# non-interactively. Supplying `<target>` only skips the "which client"
# menu; it never skips the scope/path confirmation.
#
# SCOPE (per the task order — core, platform-agnostic): this command and
# _install_run below own the command skeleton, detection, prompts, and the
# generic carrier (_write_generic_mcp_config, above). Per-client FORMAT
# quirks (e.g. a client whose own config uses a different top-level
# key/shape than the mcpServers convention) are explicitly OUT of scope —
# _INSTALL_IDS/_INSTALL_LABELS below is the seam a P3 per-client writer
# would extend or override, not something to speculatively build now.

# _install_target_catalog: populates the static candidate list. Parallel
# arrays (matches this file's existing convention — see _pick_project's
# slugs/names) rather than an associative array, since bash 3.2-compatible
# arrays are what the rest of the script already assumes.
_install_target_catalog() {
  _INSTALL_IDS=(cursor antigravity)
  _INSTALL_LABELS=("Cursor" "Antigravity (Windows, via WSL)")
}

# _install_detected: $1 = target id → prints 1 (detected) or 0 (not) on
# stdout. A "not detected" candidate still appears in the picker (labeled
# accordingly) — detection narrows nothing, it only informs the human.
_install_detected() {
  case "$1" in
    cursor)
      [ -d "${HOME}/.cursor" ] && echo 1 || echo 0
      ;;
    antigravity)
      compgen -G "${ANTIGRAVITY_WINDOWS_USERS_ROOT}/*/.gemini/config" > /dev/null 2>&1 && echo 1 || echo 0
      ;;
    *)
      echo 0
      ;;
  esac
}

# _install_pick_target: renders the detected-candidates menu (+ an always-
# present "manual path" option) and sets _INSTALL_PICKED_ID/_LABEL from an
# explicit numeric choice — never a default, never auto-accepted on a bare
# Enter. Mirrors _pick_project's box/number styling. Returns 130 on
# cancel (Ctrl-C/Ctrl-D), matching this file's existing convention.
_install_pick_target() {
  _INSTALL_PICKED_ID=""; _INSTALL_PICKED_LABEL=""
  _install_target_catalog
  local n="${#_INSTALL_IDS[@]}"
  local -a _det=()
  local i
  for ((i = 0; i < n; i++)); do
    _det+=("$(_install_detected "${_INSTALL_IDS[$i]}")")
  done

  echo "" >&2
  echo "  Clientes MCP locais detectados nesta máquina:" >&2
  for ((i = 0; i < n; i++)); do
    if [ "${_det[$i]}" = "1" ]; then
      printf '   %2d) %-32s %s\n' "$((i + 1))" "${_INSTALL_LABELS[$i]}" "$(_ok "[detectado]")" >&2
    else
      printf '   %2d) %-32s %s\n' "$((i + 1))" "${_INSTALL_LABELS[$i]}" "$(_dim "[não detectado]")" >&2
    fi
  done
  printf '   %2d) Outro (informar o caminho manualmente)\n' "$((n + 1))" >&2
  echo "" >&2

  local _choice
  while :; do
    printf '  → número [1-%d] (Ctrl-C cancela): ' "$((n + 1))" >&2
    if ! IFS= read -r _choice; then
      echo "" >&2
      return 130
    fi
    case "${_choice}" in
      # code-review fix: a >8-digit all-numeric string used to pass this
      # filter and reach the `-ge`/`-le` arithmetic test below, where bash
      # prints a raw "value too large for defined data type" / "integer
      # expression expected" straight to the terminal BEFORE falling through
      # to the friendly "Fora do intervalo" — cosmetic, but jarring, and
      # menus here are never anywhere close to 9 digits long, so this range
      # costs nothing real.
      '' | *[!0-9]* | ?????????*)
        printf '  ✗ Entrada inválida.\n' >&2
        continue
        ;;
    esac
    if [ "${_choice}" -ge 1 ] && [ "${_choice}" -le "$((n + 1))" ]; then
      break
    fi
    printf '  ✗ Fora do intervalo.\n' >&2
  done

  if [ "${_choice}" -eq "$((n + 1))" ]; then
    _INSTALL_PICKED_ID="manual"
    _INSTALL_PICKED_LABEL="Outro (caminho manual)"
  else
    _INSTALL_PICKED_ID="${_INSTALL_IDS[$((_choice - 1))]}"
    _INSTALL_PICKED_LABEL="${_INSTALL_LABELS[$((_choice - 1))]}"
  fi
  return 0
}

# _install_ask_scope: $1 = human label for the chosen target. Sets
# _INSTALL_SCOPE to "global" or "project" from an explicit numeric choice
# (never a default). Returns 130 on cancel.
_install_ask_scope() {
  local _label="$1"
  echo "" >&2
  echo "  Escopo da configuração para ${_label}:" >&2
  echo "   1) Global (todos os projetos deste usuário)" >&2
  printf '   2) Apenas este projeto (diretório atual: %s)\n' "$(pwd)" >&2
  local _choice
  while :; do
    printf '  → número [1-2] (Ctrl-C cancela): ' >&2
    if ! IFS= read -r _choice; then
      echo "" >&2
      return 130
    fi
    case "${_choice}" in
      1) _INSTALL_SCOPE="global"; return 0 ;;
      2) _INSTALL_SCOPE="project"; return 0 ;;
      *) printf '  ✗ Entrada inválida.\n' >&2 ;;
    esac
  done
}

# _install_run: the guided flow itself, WITHOUT the TTY gate (that lives in
# cmd_install, its only caller in production) — kept separate so a test can
# drive it directly with piped stdin ("mock the interactive prompts") without
# fighting a `[ -t 0 ]` check that a pipe can never satisfy. $1 = optional
# target id arg.
_install_run() {
  local _target_arg="${1:-}"

  local -a _INSTALL_IDS=() _INSTALL_LABELS=()
  _install_target_catalog

  local _chosen_id="" _chosen_label=""
  if [ -n "${_target_arg}" ]; then
    if [ "${_target_arg}" = "manual" ]; then
      _chosen_id="manual"; _chosen_label="Outro (caminho manual)"
    else
      local i
      for ((i = 0; i < ${#_INSTALL_IDS[@]}; i++)); do
        if [ "${_INSTALL_IDS[$i]}" = "${_target_arg}" ]; then
          _chosen_id="${_INSTALL_IDS[$i]}"
          _chosen_label="${_INSTALL_LABELS[$i]}"
          break
        fi
      done
      if [ -z "${_chosen_id}" ]; then
        echo "Erro: alvo desconhecido '${_target_arg}'." >&2
        echo "      Alvos suportados: ${_INSTALL_IDS[*]}, manual (caminho informado por você)." >&2
        return 1
      fi
    fi
  else
    local _rc=0
    _install_pick_target || _rc=$?
    if [ "${_rc}" -ne 0 ]; then
      echo "Instalação cancelada." >&2
      return "${_rc}"
    fi
    _chosen_id="${_INSTALL_PICKED_ID}"
    _chosen_label="${_INSTALL_PICKED_LABEL}"
  fi

  # Resolve the candidate path(s) for the chosen target — never fewer/more
  # than what the target structurally supports, never a silent pick among
  # several without asking.
  local -a _paths=()
  case "${_chosen_id}" in
    manual)
      printf 'Caminho completo do arquivo de configuração (ex: /home/voce/.algum-cliente/mcp.json): ' >&2
      local _typed
      if ! IFS= read -r _typed; then
        echo "" >&2
        return 130
      fi
      _typed="$(printf '%s' "${_typed}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      if [ -z "${_typed}" ]; then
        echo "Caminho vazio — nada instalado." >&2
        return 1
      fi
      _paths=("${_typed}")
      ;;
    cursor)
      local _rc=0
      _install_ask_scope "${_chosen_label}" || _rc=$?
      if [ "${_rc}" -ne 0 ]; then
        echo "Instalação cancelada." >&2
        return "${_rc}"
      fi
      if [ "${_INSTALL_SCOPE}" = "project" ]; then
        _paths=("$(pwd)/.cursor/mcp.json")
      else
        _paths=("${HOME}/.cursor/mcp.json")
      fi
      ;;
    antigravity)
      # Global-only — a Windows-side per-user config, there is no
      # per-project equivalent crossing the WSL↔Windows boundary. Stated
      # plainly rather than silently skipped, per the "guided, never
      # assumed" bar even where there is structurally only one scope.
      echo "" >&2
      echo "  $(_dim "Antigravity só suporta configuração global (não há escopo por projeto).")" >&2
      local _wp
      for _wp in "${ANTIGRAVITY_WINDOWS_USERS_ROOT}"/*/.gemini/config; do
        [ -d "${_wp}" ] || continue
        _paths+=("${_wp}/mcp_config.json")
      done
      if [ "${#_paths[@]}" -eq 0 ]; then
        echo "Erro: nenhum diretório de configuração do Antigravity encontrado (${ANTIGRAVITY_WINDOWS_USERS_ROOT}/*/.gemini/config)." >&2
        return 1
      fi
      ;;
    *)
      echo "Erro interno: alvo '${_chosen_id}' sem resolução de caminho." >&2
      return 1
      ;;
  esac

  local _final_path
  if [ "${#_paths[@]}" -eq 1 ]; then
    _final_path="${_paths[0]}"
  else
    # More than one structural candidate (e.g. >1 Windows user profile) —
    # guided pick among them, still no default.
    echo "" >&2
    echo "  Mais de um caminho candidato encontrado:" >&2
    local i
    for ((i = 0; i < ${#_paths[@]}; i++)); do
      printf '   %2d) %s\n' "$((i + 1))" "${_paths[$i]}" >&2
    done
    local _idx
    while :; do
      printf '  → número [1-%d] (Ctrl-C cancela): ' "${#_paths[@]}" >&2
      if ! IFS= read -r _idx; then
        echo "" >&2
        return 130
      fi
      case "${_idx}" in
        # code-review fix: same overly-long-digit-string guard as the target
        # picker above — keeps the arithmetic test below from ever seeing a
        # value it can't parse.
        '' | *[!0-9]* | ?????????*)
          printf '  ✗ Entrada inválida.\n' >&2
          continue
          ;;
      esac
      if [ "${_idx}" -ge 1 ] && [ "${_idx}" -le "${#_paths[@]}" ]; then
        _final_path="${_paths[$((_idx - 1))]}"
        break
      fi
      printf '  ✗ Fora do intervalo.\n' >&2
    done
  fi

  # Option 2 (fos_decision 1caee6a7, item 18cff9b7): a DEDICATED loopback
  # port + device_id for this exact config path — never PROXY_PORT (that
  # stays the shared/default port for the CLI's OWN self-seed entry only,
  # unchanged). Idempotent: re-running install against an already-mapped
  # path reuses its existing port+id rather than reallocating
  # (_resolve_target_port_and_device_id above).
  #
  # code-review FIX: allocation + port-map.json persistence used to happen
  # HERE, before the y/N confirmation below — so declining ("Cancelado —
  # nada escrito") was a lie: a device_id was already minted and a port
  # already reserved/written to disk regardless of the answer. The prompt
  # below now shows a READ-ONLY preview (_preview_target_port — no lock, no
  # write, no minted device_id); the REAL allocate-or-reuse + persist
  # (_resolve_target_port_and_device_id, lock-protected) only runs AFTER
  # the human confirms, so a decline truly writes nothing.
  local _scope_for_map="${_INSTALL_SCOPE:-}"
  case "${_chosen_id}" in
    antigravity) _scope_for_map="global" ;; # structurally single-scope
    manual)      _scope_for_map="manual" ;;
  esac
  local _preview_port
  if ! _preview_port="$(_preview_target_port "${_final_path}")"; then
    echo "  $(_err "✗") falha ao calcular uma porta dedicada para '${_chosen_id}' — nada escrito." >&2
    return 1
  fi

  echo "" >&2
  echo "  Alvo:    ${_chosen_label:-${_chosen_id}}" >&2
  echo "  Arquivo: ${_final_path}" >&2
  echo "  Porta dedicada: ${_preview_port}" >&2
  echo "  Entrada: mcpServers.engram = {type:\"http\", url:\"https://127.0.0.1:${_preview_port}/v1/mcp\"}" >&2
  printf '  Confirma a escrita neste caminho? [y/N] ' >&2
  local _confirm
  if ! IFS= read -r _confirm; then
    echo "" >&2
    return 130
  fi
  case "${_confirm}" in
    y | Y | yes | YES | s | S | sim | SIM) ;;
    *)
      echo "Cancelado — nada escrito." >&2
      return 130
      ;;
  esac

  # Confirmed — NOW allocate-or-reuse + persist, atomically (lock-protected,
  # see _resolve_target_port_and_device_id). Under real concurrent installs
  # the committed port could in principle differ from the preview shown
  # above (another install won the race in between); surface that plainly
  # rather than silently writing a config that doesn't match what the human
  # just confirmed.
  local _port_resolved
  if ! _port_resolved="$(_resolve_target_port_and_device_id "${_final_path}" "${_chosen_id}" "${_scope_for_map}")"; then
    echo "  $(_err "✗") falha ao alocar uma porta dedicada para '${_chosen_id}' — nada escrito." >&2
    return 1
  fi
  local _target_port _target_device_id
  _target_port="$(printf '%s' "${_port_resolved}" | cut -f1)"
  _target_device_id="$(printf '%s' "${_port_resolved}" | cut -f2)"
  if [ "${_target_port}" != "${_preview_port}" ]; then
    echo "  $(_dim "(porta ajustada para ${_target_port} — outra instalação reservou ${_preview_port} nesse meio-tempo)")" >&2
  fi

  local _write_err
  if _write_err="$(_write_generic_mcp_config "${_final_path}" "${_target_port}" 2>&1)"; then
    echo "  $(_ok "✓") gravado: ${_final_path} (device_id ${_target_device_id})" >&2
    # Best-effort: tell an already-running daemon about the freshly-mapped
    # port so it's live immediately, no daemon restart needed (item
    # 46d0eeed's POST /internal/proxy/reload). NOT a hard dependency — if
    # the daemon isn't running (or this call fails for any reason), the
    # next _start_proxy spawn reads the full port-map.json at boot anyway.
    curl -sf --max-time 3 -X POST "http://127.0.0.1:${RUNTIME_PORT}/internal/proxy/reload" > /dev/null 2>&1 || true
  else
    echo "  $(_err "✗") falha ao gravar ${_final_path}" >&2
    # code-review fix: surface the real reason (permission denied, disk
    # full, malformed path, ...) instead of swallowing it — a human is
    # standing at this prompt waiting to know why, not scripting around it.
    [ -n "${_write_err}" ] && echo "      ${_write_err}" >&2
    return 1
  fi

  # ef1c9385 — no local skill/stub file is written for ANY P2 target: per
  # decision bee7f370 the URL+header (server-injected credential) wiring
  # above is sufficient on its own for every target this pass ships. A
  # thin-stub carrier (aea3837b/boot.md's shape — a fetch+inject pointer,
  # never the full procedure body) would only be needed for a FUTURE target
  # whose client cannot discover served MCP prompts/resources on its own —
  # none of today's targets need that, so none is speculatively built here.
  echo "  $(_dim "Nenhum arquivo local de skill/stub foi escrito para '${_chosen_id}' — apenas o wiring de URL acima (decisão bee7f370).")" >&2
  return 0
}

# cmd_install: TTY gate + dispatch to _install_run. The gate lives HERE
# (not inside _install_run) specifically so tests can call _install_run
# directly with piped stdin to exercise the guided flow — the pipe itself
# is never a TTY, so a gate inside _install_run would make that untestable.
# Same fail-closed posture as the slug-picker (cmd_open, F2.3): a target arg
# does NOT bypass this gate — the scope/path confirmation below still needs
# a real terminal, so a non-interactive `hivemind install <target>` would
# only hang or silently fail a `read`, never a safe outcome.
cmd_install() {
  if ! { [ -t 0 ] && [ -t 1 ]; }; then
    echo "Erro: 'hivemind install' é guiado e interativo (sem caminho padrão) — a entrada não é um terminal." >&2
    echo "      Rode 'hivemind install' (ou 'hivemind install <target>') em um terminal interativo." >&2
    exit 1
  fi

  # code-review fix: unlike cmd_open, this command used to write the OTHER
  # client's mcpServers.engram entry (pointing at https://127.0.0.1:${PROXY_PORT})
  # WITHOUT ever ensuring anything is listening on that port — "✓ gravado" with
  # nothing behind it. This machine must already be enrolled (a proxy cannot
  # authenticate without a cert; _setup_mode is an enrollment flow of its own
  # and out of scope for a command whose whole point is "wire up ANOTHER
  # client to the cert THIS one already has") — warn+instruct rather than
  # silently degrade. If enrolled, mirror cmd_open and ensure a healthy
  # proxy is actually up before the guided write below.
  if ! _has_cert; then
    echo "Erro: nenhum certificado encontrado para este usuário — 'hivemind install' conecta OUTRO" >&2
    echo "      cliente ao mesmo proxy que este dispositivo já usa, então este dispositivo precisa" >&2
    echo "      estar inscrito primeiro. Rode 'hivemind' (sem argumentos) para inscrever, depois" >&2
    echo "      tente 'hivemind install' de novo." >&2
    exit 1
  fi
  _start_proxy

  _install_run "$@"
}

# ── Entry point ───────────────────────────────────────────────────────────────

# Parse --verbose anywhere in argv; strip it before subcommand dispatch (it's
# a global flag, not a subcommand argument).
_VERBOSE=0
_ARGS=()
for _arg in "$@"; do
  case "${_arg}" in
    --verbose) _VERBOSE=1 ;;
    *) _ARGS+=("${_arg}") ;;
  esac
done
set -- "${_ARGS[@]+"${_ARGS[@]}"}"

case "${1:-}" in
  start)          shift || true; cmd_start ;;
  stop)           shift || true; cmd_stop ;;
  restart)        shift || true; cmd_restart ;;
  status)         shift || true; cmd_status ;;
  health)         shift || true; cmd_health ;;
  update)         shift || true; cmd_update ;;
  resume)         shift || true; cmd_resume "$@" ;;
  install)        shift || true; cmd_install "$@" ;;
  --version|-v)   cmd_version ;;
  --help|-h)      cmd_help ;;
  *)              cmd_open "$@" ;;
esac
